{
  "titre": "Arrêté du 18 mars 2024 portant extension d'un avenant à la convention collective nationale du personnel des agences générales d'assurances (n° 2335)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000049344276_01-01-2999",
