{
  "titre": "Arrêté du 27 décembre 2018 portant extension d'un avenant à la convention collective nationale des hôtels, cafés, restaurants (n° 1979)",
  "text": {
    "executionTime": 13,
    "dereferenced": false,
    "id": "JORFTEXT000037885262_01-01-2999",
