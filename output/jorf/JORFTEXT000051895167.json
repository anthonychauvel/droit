{
  "titre": "Arrêté du 8 juillet 2025 portant extension d'un avenant à la convention collective nationale des personnels des structures associatives cynégétiques (n° 2697)",
  "text": {
    "executionTime": 49,
    "dereferenced": false,
    "id": "JORFTEXT000051895167_01-01-2999",
