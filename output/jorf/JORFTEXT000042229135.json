{
  "titre": "Arrêté du 28 juillet 2020 portant extension d'un avenant à la convention collective nationale des entreprises d'architecture (n° 2332)",
  "text": {
    "executionTime": 34,
    "dereferenced": false,
    "id": "JORFTEXT000042229135_01-01-2999",
