{
  "titre": "Arrêté du 26 mars 2026 portant extension d'un avenant à un accord conclu dans le cadre de la convention collective nationale du tourisme social et familial (n° 1316)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000053762726_01-01-2999",
