{
  "titre": "Arrêté du 11 janvier 2018 portant extension d'un avenant à la convention collective nationale de l'animation (n° 1518)",
  "text": {
    "executionTime": 10,
    "dereferenced": false,
    "id": "JORFTEXT000036505292_01-01-2999",
