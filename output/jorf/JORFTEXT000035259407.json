    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000035259413",
        "cid": "JORFARTI000035259413",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000035259413",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective métropolitaine des entreprises de la maintenance, distribution et location de matériels agricoles, de travaux publics, de bâtiment, de manutention, de motoculture de plaisance et activités connexes, dite « SDLM », les dispositions de :</p><p><br/>- l'avenant n° 2 du 21 février 2017 à l'accord du 14 septembre 2014 relatif au dialogue social, conclu dans le cadre de la convention collective nationale susvisée ;<br/>- l'avenant n° 3 du 21 février 2017 à l'accord du 2 juillet 2015 relatif à la formation professionnelle, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
