    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000045546135",
        "cid": "JORFARTI000045546135",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000045546135",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des exploitations frigorifiques du 10 juillet 1956, les stipulations de l'avenant n° 93 du 15 décembre 2021 relatif aux salaires, à la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
