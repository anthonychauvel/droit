{
  "titre": "Arrêté du 15 mai 2025 portant extension d'un avenant à la convention collective nationale du personnel des entreprises de transport en navigation intérieure (n° 3229)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000051673325_01-01-2999",
