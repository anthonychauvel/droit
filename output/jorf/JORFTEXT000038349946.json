    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000038349950",
        "cid": "JORFARTI000038349950",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000038349950",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des jardineries et graineteries du 3 décembre 1993, les dispositions de l'avenant n° 6 du 15 décembre 2017 à l'accord du 11 juin 2009 relatif au régime de prévoyance, conclu dans le cadre de la convention collective susvisée.<br/>L'alinéa 2 de l'article 4 est étendu sous réserve du respect des <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000006901674&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L2231-5 (V)\">dispositions de l'article L. 2231-5 du code du travail</a>.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
