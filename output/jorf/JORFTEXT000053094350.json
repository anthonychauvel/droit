{
  "titre": "Arrêté du 9 décembre 2025 portant extension d'un avenant à la convention collective nationale des entreprises de la publicité et assimilées (n° 86)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000053094350_01-01-2999",
