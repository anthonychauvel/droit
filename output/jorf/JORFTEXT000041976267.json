{
  "titre": "Arrêté du 29 mai 2020 portant extension d'un avenant à la convention collective nationale de la promotion immobilière (n° 1512)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000041976267_01-01-2999",
