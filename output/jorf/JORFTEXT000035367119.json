    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000035367122",
        "cid": "JORFARTI000035367122",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000035367122",
        "pathTitle": [],
        "content": "<p><br/>Délégation est donnée à M. Marc de Lépinau, attaché économique principal, et à Mme Bénédicte Meton, attachée hors classe d'administration, à l'effet de signer, au nom du ministre de l'économie et des finances, et dans la limite de leurs attributions, tous actes, arrêtés, décisions ou conventions, tous engagements, documents comptables et pièces justificatives de dépenses et tous ordres de paiement.<br/>Délégation est donnée à M. Bruno Viellard, secrétaire administratif de classe exceptionnelle, à l'effet de signer au nom du ministre de l'économie et des finances, et dans la limite de ses attributions, tous actes, tous engagements, documents comptables et pièces justificatives de dépenses et tous ordres de paiement.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
