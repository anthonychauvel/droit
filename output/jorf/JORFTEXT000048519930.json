    "dateFinVersion": "2999-01-01",
    "signers": "<p align=\"left\"><br/>Fait le 6 décembre 2023.</p><p align=\"left\"><br/>Emmanuel Macron<br/>Par le Président de la République :</p><p align=\"left\"><br/>La Première ministre,<br/>Élisabeth Borne</p><p align=\"left\"><br/>Le ministre du travail, du plein emploi et de l'insertion,<br/>Olivier Dussopt</p><p align=\"left\"><br/>Le ministre de l'éducation nationale et de la jeunesse,<br/>Gabriel Attal</p>",
