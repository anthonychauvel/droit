{
  "titre": "Arrêté du 11 décembre 2025 portant extension d'un avenant à la convention collective nationale des entreprises artistiques et culturelles (n° 1285)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000053167889_01-01-2999",
