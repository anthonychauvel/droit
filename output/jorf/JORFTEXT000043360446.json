{
  "titre": "Arrêté du 2 avril 2021 portant extension d'un avenant à la convention collective nationale des ateliers et chantiers d'insertion (n° 3016)",
  "text": {
    "executionTime": 22,
    "dereferenced": false,
    "id": "JORFTEXT000043360446_01-01-2999",
