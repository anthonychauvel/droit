{
  "titre": "Arrêté du 21 janvier 2019 portant extension d'un avenant à la convention collective de la couture parisienne (n° 303)",
  "text": {
    "executionTime": 9,
    "dereferenced": false,
    "id": "JORFTEXT000038057280_01-01-2999",
