    "nor": "ACPP1621483S",
    "eli": null,
    "alias": null,
    "jorfText": "JORF n°0277 du 29 novembre 2016",
    "jurisState": "Sans état juridique",
    "visa": "<p align=\"left\"><br/>Le sous-collège sectoriel de l'assurance,<br/>Délibérant le 20 octobre 2016,<br/>Vu le <a href=\"/affichCode.do?cidTexte=LEGITEXT000006072026&dateTexte=29990101&categorieLien=cid\" title=\"Code monétaire et financier (V)\">code monétaire et financier</a>, notamment ses articles L. 612-1 et L. 612-15 ;<br/>Vu le <a href=\"/affichCode.do?cidTexte=LEGITEXT000006074067&dateTexte=29990101&categorieLien=cid\" title=\"Code de la mutualité (V)\">code de la mutualité</a>, notamment ses articles L. 211-8, L. 212-11, R. 211-2 et R. 211-9 ;<br/>Vu les pièces du dossier,<br/>Décide :</p>",
    "modifDate": null,
    "jurisDate": null,
    "dateDebutVersion": "2999-01-01",
    "dateFinVersion": "2999-01-01",
    "signers": "<p align=\"left\"><br/>Fait à Paris, le 20 octobre 2016.</p><p align=\"left\"><br/>Pour le sous-collège sectoriel de l'assurance :<br/>Le président,<br/>B. Delas</p>",
    "prepWork": "",
