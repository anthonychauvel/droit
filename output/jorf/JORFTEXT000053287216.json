{
  "titre": "Arrêté du 22 décembre 2025 portant extension d'un avenant à la convention collective nationale de la boucherie-poissonnerie (n° 3254)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000053287216_01-01-2999",
