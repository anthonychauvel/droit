    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000051710134",
        "cid": "JORFARTI000051710134",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000051710134",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale de l'industrie pharmaceutique du 6 avril 1956, les stipulations de l'avenant du 9 janvier 2025 à l'accord collectif du 22 juin 2007 sur le régime frais de soins de santé des anciens salariés, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
