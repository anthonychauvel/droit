    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000044385197",
        "cid": "JORFARTI000044385197",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000044385197",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application professionnel de la convention collective nationale des entreprises de prévention et de sécurité du 15 février 1985, les stipulations de l'avenant n° 4 du 21 avril 2021 à l'accord du 28 janvier 2011 relatif à la reprise du personnel dans le cadre de transferts de marchés de « sûreté aérienne et aéroportuaire », conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
