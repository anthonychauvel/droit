        "intOrdre": 1572861,
        "etat": "VIGUEUR",
        "num": "3",
        "path": "/JORFARTI000049465248",
        "pathTitle": [],
        "content": "<p><br/>Seules les réponses complètes, transmises avant l'expiration du délai mentionné à l'article 2, font l'objet d'un examen et ouvrent droit au versement mentionné à l'article 1er.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
