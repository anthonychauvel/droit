{
  "titre": "Arrêté du 17 mars 2026 portant extension de l'avenant n° 47 du 7 janvier 2025 relatif à la grille des salaires en conchyliculture",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000053749610_01-01-2999",
