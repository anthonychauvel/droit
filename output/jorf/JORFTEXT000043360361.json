    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000043360364",
        "cid": "JORFARTI000043360364",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000043360364",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale de l'industrie pharmaceutique du 6 avril 1956 et des textes qui l'ont complétée ou modifiée, les stipulations de l'accord du 4 juillet 2019 sur la gestion des emplois et des compétences, l'évolution professionnelle des salariés tout au long de la vie professionnelle et l'information et l'orientation, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
