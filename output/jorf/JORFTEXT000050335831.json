{
  "titre": "Arrêté du 30 septembre 2024 portant extension d'un avenant à la convention collective nationale des missions locales et PAIO (n° 2190)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000050335831_01-01-2999",
