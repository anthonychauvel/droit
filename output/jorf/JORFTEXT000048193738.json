    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000048193741",
        "cid": "JORFARTI000048193741",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000048193741",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale l'immobilier du 9 septembre 1988, les stipulations de l'avenant n° 96 du 23 novembre 2022, à la convention collective nationale susvisée.<br/>Le 5e alinéa de l'article 25.2 de la convention collective, dans sa rédaction issue de l'article 1 de l'avenant, est étendu sous réserve du respect de l'<a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000018482943&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. D1225-8 (M)\">article D. 1225-8 du code du travail</a>.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
