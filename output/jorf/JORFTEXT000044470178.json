{
  "titre": "Arrêté du 26 novembre 2021 portant extension d'un avenant à la convention collective nationale de l'immobilier (n° 1527)",
  "text": {
    "executionTime": 15,
    "dereferenced": false,
    "id": "JORFTEXT000044470178_01-01-2999",
