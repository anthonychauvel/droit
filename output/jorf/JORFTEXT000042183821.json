{
  "titre": "Arrêté du 21 juillet 2020 portant extension d'un avenant à la convention collective nationale du personnel des huissiers de justice (n° 1921)",
  "text": {
    "executionTime": 6,
    "dereferenced": false,
    "id": "JORFTEXT000042183821_01-01-2999",
