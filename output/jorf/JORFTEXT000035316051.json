{
  "titre": "Arrêté du 18 juillet 2017 portant extension d'un avenant à la convention collective nationale des entreprises de services à la personne (n° 3127)",
  "text": {
    "executionTime": 11,
    "dereferenced": false,
    "id": "JORFTEXT000035316051_01-01-2999",
