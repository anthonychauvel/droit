    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000045887481",
        "cid": "JORFARTI000045887481",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000045887481",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des acteurs du lien social et familial du 4 juin 1983, les stipulations de l'avenant n° 05-21 du 15 novembre 2021 relatif au dialogue social, conclu dans le cadre de la convention collective nationale susvisée.<br/>Les articles 2.1.1.1, 2.1.2.1 et 2.1.3.1 tels que modifiés par l'article 3 de l'avenant du préambule de la convention collective sont étendus sous réserve du respect des articles L. 2232-8, L. 2234-3 et de l'application du principe d'égalité à valeur constitutionnelle résultant de l'article 6 de la Déclaration des droits de l'homme et du citoyen du 26 août 1789 et du 6e alinéa du préambule de la Constitution de 1946, tel qu'interprété par la Cour de Cassation (Cass. soc. 29 mai 2001, Cegelec).</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
