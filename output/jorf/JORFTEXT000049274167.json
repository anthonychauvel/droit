{
  "titre": "Arrêté du 7 mars 2024 portant extension d'un avenant à la convention collective nationale des personnels des structures associatives cynégétiques (n° 2697)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000049274167_01-01-2999",
