            "content": "<p><br/>ANNEXE</p><p><div align=\"center\"><center><table border=\"1\"><tr><th><br/>IDCC</th><th><br/>Convention collective concernée</th><th><br/>Avenant de salaire concerné \n      <br/>\n    par l'extension</th><th><br/>N° du BOCC \n      <br/>\n    où l'avenant est publié</th><th><br/>Date de publication \n      <br/>\n    de l'avis au JORF</th></tr><tr><td align=\"center\"><br/>7004</td><td align=\"justify\"><br/>Convention du 7 juin 1984 concernant les coopératives laitières agricoles</td><td align=\"justify\"><br/>Accord du 19 avril 2019 concernant les rémunérations conventionnelles dans la transformation laitière</td><td align=\"left\"><br/>2019/41</td><td align=\"left\"><br/>27 octobre 2019</td></tr><tr><td align=\"center\"><br/>7004</td><td align=\"justify\"><br/>Convention du 7 juin 1984 concernant les coopératives laitières agricoles</td><td align=\"center\"><br/>Avenant n° 76 du 19 avril 2019</td><td align=\"left\"><br/>2019/41</td><td align=\"left\"><br/>27 octobre 2019</td></tr><tr><td align=\"center\"><br/>7004</td><td align=\"justify\"><br/>Convention du 7 juin 1984 concernant les coopératives laitières agricoles</td><td align=\"center\"><br/>Avenant n° 77 du 19 avril 2019</td><td align=\"left\"><br/>2019/41</td><td align=\"left\"><br/>27 octobre 2019</td></tr><tr><td align=\"center\"><br/>7004</td><td align=\"justify\"><br/>Convention du 7 juin 1984 concernant les coopératives laitières agricoles</td><td align=\"center\"><br/>Avenant n° 78 du 19 avril 2019</td><td align=\"left\"><br/>2019/41</td><td align=\"left\"><br/>27 octobre 2019</td></tr><tr><td align=\"center\"><br/>8262</td><td align=\"justify\"><br/>Convention du 21 novembre 1997 concernant les exploitations et entreprises agricoles de Côte-d'Or, Nièvre et Yonne</td><td align=\"center\"><br/>Avenant n° 61 du 21 janvier 2019</td><td align=\"left\"><br/>2019/41</td><td align=\"left\"><br/>27 octobre 2019</td></tr><tr><td align=\"center\"><br/>8414</td><td align=\"justify\"><br/>Convention du 22 février 1972 concernant les exploitations maraichères et de serre de Meurthe-et-Moselle et de Moselle</td><td align=\"center\"><br/>Avenant n° 78 du 1er juillet 2019</td><td align=\"left\"><br/>2019/41</td><td align=\"left\"><br/>27 octobre 2019</td></tr><tr><td align=\"center\"><br/>8434</td><td align=\"justify\"><br/>Convention du 1er novembre 1998 concernant les exploitations agricoles, entreprises de travaux agricoles et forestiers et les coopératives d'utilisation de matériel agricole de la Région Franche-Comté</td><td align=\"center\"><br/>Avenant n° 33 du 5 juillet 2019</td><td align=\"left\"><br/>2019/41</td><td align=\"left\"><br/>27 octobre 2019</td></tr><tr><td align=\"center\"><br/>8435</td><td align=\"justify\"><br/>Convention du 29 août 2001 concernant les coopératives fruitières des départements de l'Ain, du Doubs et du Jura</td><td align=\"center\"><br/>Avenant n° 36 du 26 mars 2019</td><td align=\"left\"><br/>2019/41</td><td align=\"left\"><br/>27 octobre 2019</td></tr><tr><td align=\"center\"><br/>8526</td><td align=\"justify\"><br/>Convention du 8 avril 2003 concernant les exploitations arboricoles de certains départements de l'Ouest de la France</td><td align=\"center\"><br/>Avenant n° 21 du 2 juillet 2019</td><td align=\"left\"><br/>2019/41</td><td align=\"left\"><br/>27 octobre 2019</td></tr><tr><td align=\"center\"><br/>8542</td><td align=\"justify\"><br/>Convention du 23 décembre 1999 concernant le secteur de la production agricole du département de la Vienne et des entreprises de travaux agricoles et ruraux des départements de la Vienne et des Deux-Sèvres</td><td align=\"center\"><br/>Avenant n° 54 du 8 janvier 2019</td><td align=\"left\"><br/>2019/41</td><td align=\"left\"><br/>27 octobre 2019</td></tr><tr><td align=\"center\"><br/>9221</td><td align=\"justify\"><br/>Convention du 26 octobre 1982 concernant les exploitations de polyculture, élevage et cultures légumières de plein champ des Côtes d'Armor</td><td a