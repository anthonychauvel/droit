    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000048560751",
        "cid": "JORFARTI000048560751",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000048560751",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective des industries et métiers de la métallurgiques de l'Aube du 5 juin 2002, les stipulations de :</p><p><br/>- l'accord du 25 juillet 2023 relatif au barème de l'indemnité de transport, conclu dans le cadre de la convention collective susvisée ;<br/>- l'avenant du 18 septembre 2023 à l'accord du 25 juillet 2023 relatif au barème de l'indemnité de transport, conclu dans le cadre de la convention collective.</p>",
        "nota": null,
