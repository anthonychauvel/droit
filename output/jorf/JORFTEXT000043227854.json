{
  "titre": "Arrêté du 1er mars 2021 portant extension d'un avenant à la convention collective nationale de la production audiovisuelle (n° 2642)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000043227854_01-01-2999",
