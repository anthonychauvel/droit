    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000034291194",
        "cid": "JORFARTI000034291194",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000034291194",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des employés, techniciens et agents de maîtrise du bâtiment du 12 juillet 2006, et dans son propre champ d'application territorial, les dispositions de l'accord départemental (Seine-et-Marne) du 29 novembre 2016 relatif aux salaires minimaux, conclu dans le cadre de la convention collective susvisée sous réserve de l'application des dispositions réglementaires portant fixation du salaire minimum interprofessionnel de croissance.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
