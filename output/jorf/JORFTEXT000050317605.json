{
  "titre": "Arrêté du 25 septembre 2024 portant extension d'un avenant à la convention collective nationale des entreprises de courtage d'assurances et/ou de réassurances (n° 2247)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000050317605_01-01-2999",
