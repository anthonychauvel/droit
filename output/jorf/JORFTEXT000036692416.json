    "jorfText": "JORF n°0058 du 10 mars 2018",
    "jurisState": "Sans état juridique",
    "visa": "<p align=\"left\"><br/>La ministre du travail,<br/>Vu le <a href=\"/affichCode.do?cidTexte=LEGITEXT000006072050&dateTexte=29990101&categorieLien=cid\" title=\"Code du travail (V)\">code du travail</a>, notamment ses articles L. 2121-1, L. 2122-5, L. 2122-7 et L. 2122-11 ;<br/>Vu la présentation des résultats enregistrés à l'issue du cycle électoral au Haut Conseil du dialogue social le 31 mars 2017 et le 2 février 2018 ;<br/>Vu l'avis du Haut Conseil du dialogue social en date du 2 février 2018,<br/>Arrête :</p>",
    "modifDate": null,
    "jurisDate": null,
    "dateDebutVersion": "2999-01-01",
    "dateFinVersion": "2999-01-01",
    "signers": "<p align=\"left\"><br/>Fait le 1er mars 2018.</p><p align=\"left\"><br/>Pour la ministre et par délégation :<br/>Le directeur général du travail,<br/>Y. Struillou</p>",
    "prepWork": "",
