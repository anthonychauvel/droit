        "pathTitle": [],
        "content": "<p><br/>Sont reconnues représentatives dans la convention collective nationale de la branche ferroviaire (n° 3217) les organisations syndicales suivantes :</p><p><br/>- La Confédération générale du travail (CGT) ;<br/>- L'Union nationale des syndicats autonomes (UNSA) ;<br/>- L'Union syndicale Solidaires (SOLIDAIRES) ;<br/>- La Confédération française démocratique du travail (CFDT) ;<br/>- La Confédération générale du travail-Force ouvrière (CGT-FO).</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
