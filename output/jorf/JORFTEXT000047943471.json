{
  "titre": "Arrêté du 2 août 2023 portant extension d'un avenant à l'accord collectif national sectoriel des entreprises d'accouvage et de sélection",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000047943471_01-01-2999",
