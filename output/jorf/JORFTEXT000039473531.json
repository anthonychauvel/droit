        "path": "/JORFARTI000039473540",
        "pathTitle": [],
        "content": "<p><br/>La SAM Lagardère Active Broadcast est autorisée à utiliser les fréquences mentionnées en annexe, conformément à la convention et aux annexes de la présente décision, en vue de l'exploitation d'un service de radio de catégorie E par voie hertzienne terrestre en modulation de fréquence dénommé Europe 1.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
        "type": "AUTONOME",
        "lstLienModification": [],
        "lstLienCitation": [],
        "conditionDiffere": null,
        "historique": null,
