            "path": "/JORFSCTA000045160791/JORFARTI000045160792",
            "pathTitle": [
              "Annexe"
            ],
            "content": "<p><br/>ANNEXE</p><p><div align=\"center\"><center><table border=\"1\"><tr><th rowspan=\"2\"><br/>Situation familiale</th><th colspan=\"3\"><br/>Participation aux frais d'hébergement et d'entretien</th></tr><tr><th><br/>Hébergement avec restauration</th><th><br/>Hébergement sans restauration</th><th><br/>Hébergement en présence indue</th></tr><tr><td valign=\"middle\" align=\"center\"><br/>Personne isolée</td><td valign=\"middle\" align=\"center\"><br/>25 % des ressources</td><td valign=\"middle\" align=\"center\"><br/>20 % des ressources</td><td valign=\"middle\" align=\"center\"><br/>30 % des ressources</td></tr><tr><td valign=\"middle\" align=\"center\"><br/>Couple</td><td valign=\"middle\" align=\"center\"><br/>30 % des ressources</td><td valign=\"middle\" align=\"center\"><br/>25 % des ressources</td><td valign=\"middle\" align=\"center\"><br/>35 % des ressources</td></tr><tr><td valign=\"middle\" align=\"center\"><br/>Personne isolée avec enfant(s)</td><td valign=\"middle\" align=\"center\"><br/>20 % des ressources</td><td valign=\"middle\" align=\"center\"><br/>15 % des ressources</td><td valign=\"middle\" align=\"center\"><br/>25 % des ressources</td></tr><tr><td valign=\"middle\" align=\"center\"><br/>Couple avec enfant(s)</td><td valign=\"middle\" align=\"center\"><br/>25 % des ressources</td><td valign=\"middle\" align=\"center\"><br/>20 % des ressources</td><td valign=\"middle\" align=\"center\"><br/>30 % des ressources</td></tr></table></center></div></p>",
            "nota": null,
