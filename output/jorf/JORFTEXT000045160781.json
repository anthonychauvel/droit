    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000045160783",
        "cid": "JORFARTI000045160783",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000045160783",
        "pathTitle": [],
        "content": "<p><br/>La participation financière prévue à l'article R. 552-4 du code de l'entrée et du séjour des étrangers et du droit d'asile est acquittée mensuellement. Elle est calculée en fonction du montant total des ressources perçues le mois précédent par la personne hébergée.<br/>Les ressources perçues par les membres de la famille de la personne hébergée, son conjoint, son partenaire lié par un pacte civil de solidarité ou son concubin sont prises en compte dans le calcul de la participation financière mensuelle, si ces personnes sont hébergées dans le même lieu d'hébergement pour demandeurs d'asile.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
        "type": "AUTONOME",
        "lstLienModification": [],
        "lstLienCitation": [],
        "conditionDiffere": null,
        "historique": null,
        "surtitre": null,
        "renvoi": null,
        "versionLabel": null,
        "infosComplementaires": null,
        "infosComplementairesHtml": null,
        "infosRestructurationBranche": null,
        "infosRestructurationBrancheHtml": null,
        "dateDebut": 32472144000000,
        "dateFin": 32472144000000,
        "notaSectionsAafficher": null,
        "multipleVersions": true
      },
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000045160785",
