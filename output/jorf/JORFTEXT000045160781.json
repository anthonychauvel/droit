        "etat": "VIGUEUR",
        "num": "2",
        "path": "/JORFARTI000045160785",
        "pathTitle": [],
        "content": "<p><br/>Le taux de participation financière mensuelle est fixé en annexe du présent arrêté.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
        "type": "AUTONOME",
        "lstLienModification": [],
