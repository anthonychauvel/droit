{
  "titre": "Arrêté du 11 juin 2026 portant extension d'un avenant à la convention collective nationale des détaillants en chaussures (n° 733)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000054322348_01-01-2999",
