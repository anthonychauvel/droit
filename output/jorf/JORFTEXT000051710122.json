    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000051710125",
        "cid": "JORFARTI000051710125",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000051710125",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des organismes de formation du 10 juin 1988, les stipulations de l'avenant du 12 décembre 2024 à l'accord du 19 novembre 2015 relatif à la couverture complémentaire obligatoire frais de santé, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
