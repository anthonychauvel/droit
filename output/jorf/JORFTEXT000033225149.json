{
  "titre": "Arrêté du 4 octobre 2016 portant extension d'un avenant à la convention collective nationale de la librairie (n° 3013)",
  "text": {
    "executionTime": 9,
    "dereferenced": false,
    "id": "JORFTEXT000033225149_01-01-2999",
