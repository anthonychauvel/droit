    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000052290347",
        "cid": "JORFARTI000052290347",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000052290347",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale du négoce de l'ameublement du 31 mai 1995, les stipulations de :</p><p><br/>- l'accord du 5 novembre 2024 relatif à l'intéressement, conclu dans le cadre de la convention collective nationale susvisée.</p><p><br/>Le 4<sup>e</sup> alinéa du b de l'article 5 de l'accord d'intéressement est étendu sous réserve du respect de la disposition prévue à l'<a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000006902956&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L3312-3\">article L. 3312-3 du code du travail</a> qui précise que seuls les dirigeants des entreprises employant au moins un salarié et moins de deux cent cinquante salariés peuvent bénéficier du dispositif de l'intéressement ;</p><p><br/>- l'avenant du 13 mai 2025 de mise en conformité à l'accord d'intéressement du 5 novembre 2024, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
