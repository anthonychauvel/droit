      },
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000042475024",
        "cid": "JORFARTI000042475024",
        "intOrdre": 2097148,
        "etat": "VIGUEUR",
        "num": "4",
        "path": "/JORFARTI000042475024",
        "pathTitle": [],
        "content": "<p><br/>Le prêt mentionné à l'article 2 du présent arrêté respecte le plafond par entreprise défini à l'article 5 de l'arrêté du 23 mars 2020 susvisé et appliqué sur une base consolidée au périmètre incluant tous les établissements du même groupe immatriculés en France et respectant chacun les critères de l'article 3 de ce même arrêté.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
        "type": "AUTONOME",
