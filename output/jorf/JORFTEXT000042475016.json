        "intOrdre": 1048574,
        "etat": "VIGUEUR",
        "num": "2",
        "path": "/JORFARTI000042475022",
        "pathTitle": [],
        "content": "<p><br/>Est concerné le prêt octroyé le 22 octobre 2020 à la société Chantiers de l'Atlantique SA par les établissements mentionnés à l'article 1er, qui présente les caractéristiques définies à l'article 2 de l'arrêté du 23 mars 2020 susvisé. Cette convention de crédit prévoit un différé d'amortissement d'un an pour le prêt, lequel pourra être prorogé en tout ou partie pour une période additionnelle de deux ans maximum.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
        "type": "AUTONOME",
        "lstLienModification": [],
        "lstLienCitation": [],
