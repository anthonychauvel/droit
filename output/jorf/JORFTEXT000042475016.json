        "intOrdre": 1572861,
        "etat": "VIGUEUR",
        "num": "3",
        "path": "/JORFARTI000042475023",
        "pathTitle": [],
        "content": "<p><br/>Est concernée la société Chantiers de l'Atlantique SA qui présente l'ensemble des caractéristiques définies à l'article 3 de l'arrêté du 23 mars 2020 susvisé.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
