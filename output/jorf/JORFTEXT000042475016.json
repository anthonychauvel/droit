    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000042475020",
        "cid": "JORFARTI000042475020",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000042475020",
        "pathTitle": [],
        "content": "<p><br/>En application des <a href=\"/affichTexteArticle.do?cidTexte=JORFTEXT000041746298&idArticle=JORFARTI000041746310&categorieLien=cid\" title=\"LOI n°2020-289 du 23 mars 2020 - art. 6 (M)\">dispositions de l'article 6 de la loi n° 2020-289 du 23 mars 2020</a> de finances rectificative pour 2020 susvisée, la garantie de l'Etat est accordée aux établissements HSBC France, Société Générale, Bpifrance Financement SA, Caisse d'épargne Bretagne Pays de Loire, BNP Paribas et Banco Santander pour le prêt mentionné à l'article 2 du présent arrêté, consenti à la société Chantiers de l'Atlantique SA, entreprise présentant les caractéristiques définies à l'article 3, et dont le montant de 100 millions d'euros permet de respecter le plafond par entreprise précisé à l'article 4.<br/>Cette garantie porte sur le principal, les intérêts et les accessoires, dans les conditions fixées à l'article 5.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
