    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000051862851",
        "cid": "JORFARTI000051862851",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000051862851",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective des industries et du commerce de la récupération du 6 décembre 1971, les stipulations de l'avenant n° 1 du 11 décembre 2024 à l'accord du 10 octobre 2019 portant modification de l'avenant du 9 décembre 2014 et d'avenants ultérieurs relatifs à la prévoyance complémentaire, conclu dans le cadre de la convention collective nationale susvisée.<br/>L'article 3 est étendu sous réserve du respect des dispositions de l'<a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006073189&idArticle=LEGIARTI000027549125&dateTexte=&categorieLien=cid\" title=\"Code de la sécurité sociale. - art. L911-7\">article L. 911-7 du code de la sécurité sociale</a> qui prévoient une participation de l'employeur d'au moins 50 % à la couverture collective en matière de frais santé.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
