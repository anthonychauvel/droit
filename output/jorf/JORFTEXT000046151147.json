enant n° 95 du 19 mai 2022</td><td valign=\"middle\" align=\"center\"><br/>2022/25</td><td valign=\"middle\" align=\"center\"><br/>16 juillet 2022</td></tr><tr><td valign=\"middle\" align=\"center\"><br/>7024</td><td valign=\"middle\" align=\"left\"><br/>Convention collective nationale Production agricole / CUMA du 15 septembre 2020</td><td valign=\"middle\" align=\"center\"><br/>Avenant n° 5 du 15 juin 2022</td><td valign=\"middle\" align=\"center\"><br/>2022/25</td><td valign=\"middle\" align=\"center\"><br/>16 juillet 2022</td></tr><tr><td valign=\"middle\" align=\"center\"><br/>7025</td><td valign=\"middle\" align=\"left\"><br/>Convention collective nationale de travail concernant les entreprises de travaux et services agricoles, les entreprises de travaux et services ruraux et les entreprises de travaux et services forestiers du 8 octobre 2020</td><td valign=\"middle\" align=\"center\"><br/>Avenant n° 4 du 12 mai 2022</td><td valign=\"middle\" align=\"center\"><br/>2022/25</td><td valign=\"middle\" align=\"center\"><br/>16 juillet 2022</td></tr><tr><td valign=\"middle\" align=\"center\"><br/>8531</td><td valign=\"middle\" align=\"left\"><br/>Convention collective de travail du 15 octobre 1985 concernant les exploitations forestières et scieries agricoles de la région Bretagne</td><td valign=\"middle\" align=\"center\"><br/>Avenant n° 48 du 8 avril 2022</td><td valign=\"middle\" align=\"center\"><br/>2022/25</td><td valign=\"middle\" align=\"center\"><br/>16 juillet 2022</td></tr><tr><td valign=\"middle\" align=\"center\"><br/>8531</td><td valign=\"middle\" align=\"left\"><br/>Convention collective de travail du 15 octobre 1985 concernant les exploitations forestières et scieries agricoles de la région Bretagne</td><td valign=\"middle\" align=\"center\"><br/>Avenant n° 49 du 8 avril 2022</td><td valign=\"middle\" align=\"center\"><br/>2022/25</td><td valign=\"middle\" align=\"center\"><br/>16 juillet 2022</td></tr></table></center></div></p>",
