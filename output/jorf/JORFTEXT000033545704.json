{
  "titre": "Arrêté du 24 novembre 2016 portant extension d'un avenant à un accord conclu dans le cadre de la convention collective nationale de l'hôtellerie de plein air (n° 1631)",
  "text": {
    "executionTime": 0,
    "dereferenced": false,
    "id": "JORFTEXT000033545704_01-01-2999",
