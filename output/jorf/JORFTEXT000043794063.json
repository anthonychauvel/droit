    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000043794068",
        "cid": "JORFARTI000043794068",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000043794068",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de l'accord du 29 novembre 2019 en faveur du développement des compétences et des qualifications des salariés de la branche du travail temporaire tout au long de leur vie professionnelle, les stipulations de l'avenant n° 1 du 9 octobre 2020 relatif aux nouveaux statuts du Fonds professionnel pour l'emploi dans le travail temporaire, à l'accord du 29 novembre 2019 susvisé conclu dans le secteur du travail temporaire.</p>",
        "nota": null,
