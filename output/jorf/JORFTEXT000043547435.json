    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000043547439",
        "cid": "JORFARTI000043547439",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000043547439",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application professionnel de la convention collective nationale de travail des industries de la maroquinerie, articles de voyage, chasse sellerie, gainerie, bracelets en cuir du 9 septembre 2005, tel que modifié par l'arrêté du 23 janvier 2019 portant fusion et élargissement de champs conventionnels, et dans leur propre champ d'application (secteur des cuirs et peaux), les stipulations de l'avenant n° 3 du 14 octobre 2020 à l'accord du 19 septembre 2017 relatif au don de jours de repos, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
