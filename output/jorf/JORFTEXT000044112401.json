    "textAbroge": false,
    "etat": null,
    "dossiersLegislatifs": [],
    "nature": "ARRETE",
    "resume": null,
    "rectificatif": null,
    "motsCles": [],
    "appellations": [],
    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000044112405",
        "cid": "JORFARTI000044112405",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000044112405",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective de travail des industries de la transformation des métaux de Meurthe-et-Moselle du 4 février 1976, et à l'exclusion de la réparation d'appareils électriques pour le ménage non associée à un magasin de vente, les stipulations de l'accord du 18 juin 2021 relatif aux salaires, à la convention collective susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
