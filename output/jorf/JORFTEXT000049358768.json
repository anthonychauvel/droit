{
  "titre": "Arrêté du 22 mars 2024 portant extension d'un avenant à la convention collective nationale des entreprises de désinfection, désinsectisation et dératisation (n° 1605)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000049358768_01-01-2999",
