{
  "titre": "Arrêté du 6 février 2026 portant extension d'un avenant à la convention collective nationale de l'immobilier (n° 1527)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000053459569_01-01-2999",
