{
  "titre": "Arrêté du 17 septembre 2021 portant extension d'un accord conclu dans le cadre de la convention collective nationale de l'architecture (n° 2332)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000044127392_01-01-2999",
