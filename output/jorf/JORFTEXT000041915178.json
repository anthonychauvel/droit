{
  "titre": "Arrêté du 20 mai 2020 portant extension d'un avenant à la convention collective nationale du personnel des cabinets d'avocats (n° 1000)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000041915178_01-01-2999",
