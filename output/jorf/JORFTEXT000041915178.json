    "cid": "JORFTEXT000041915178",
    "title": "Arrêté du 20 mai 2020 portant extension d'un avenant à la convention collective nationale du personnel des cabinets d'avocats (n° 1000)",
    "nor": "MTRT2012192A",
    "eli": null,
