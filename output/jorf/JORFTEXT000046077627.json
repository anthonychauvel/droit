{
  "titre": "Arrêté du 18 juillet 2022 portant extension d'un avenant à la convention collective des industries métallurgiques, électriques et connexes du Var (n° 965)",
  "text": {
    "executionTime": 12,
    "dereferenced": false,
    "id": "JORFTEXT000046077627_01-01-2999",
