{
  "titre": "Arrêté du 21 juillet 2017 portant extension d'un avenant à la convention collective nationale du personnel des industries du cartonnage (n° 489)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000035298030_01-01-2999",
