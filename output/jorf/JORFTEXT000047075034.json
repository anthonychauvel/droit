    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000047075037",
        "cid": "JORFARTI000047075037",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000047075037",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective des industries de la métallurgie de Belfort/Montbéliard du 25 juillet 2008, les stipulations de l'avenant du 27 octobre 2022 relatif aux rémunérations minimales annuelles effectives, à la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
