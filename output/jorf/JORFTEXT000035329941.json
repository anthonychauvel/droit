{
  "titre": "Arrêté du 21 juillet 2017 portant extension d'un accord conclu dans le cadre de la convention collective nationale des commerces de gros (n° 573)",
  "text": {
    "executionTime": 17,
    "dereferenced": false,
    "id": "JORFTEXT000035329941_01-01-2999",
