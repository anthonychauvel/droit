{
  "titre": "Arrêté du 28 juin 2024 portant extension d'un avenant à la convention collective nationale des 5 branches des industries alimentaires diverses (n° 3109)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000049950852_01-01-2999",
