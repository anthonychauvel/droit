{
  "titre": "Arrêté du 6 décembre 2016 portant extension d'un accord conclu dans le cadre de la convention collective nationale des chaînes thématiques (n° 2411)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000033560392_01-01-2999",
