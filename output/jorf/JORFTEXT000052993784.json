        "path": "/JORFARTI000052993799",
        "pathTitle": [],
        "content": "<p><br/>Les dispositions du présent décret s'appliquent aux cotisations versées à compter du 1<sup>er</sup> janvier 2025.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
