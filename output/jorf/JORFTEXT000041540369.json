{
  "titre": "Arrêté du 31 janvier 2020 portant extension d'un avenant à la convention collective nationale des ateliers et chantiers d'insertion (n° 3016)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000041540369_01-01-2999",
