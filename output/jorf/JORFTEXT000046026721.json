{
  "titre": "Arrêté du 27 juin 2022 portant extension d'un avenant conclu dans le cadre de la convention collective nationale des cabinets dentaires (n° 1619)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000046026721_01-01-2999",
