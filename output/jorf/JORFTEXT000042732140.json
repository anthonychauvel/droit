    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000042732143",
        "cid": "JORFARTI000042732143",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000042732143",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des industries des jeux, jouets, articles de fêtes et ornements de Noël, articles de puériculture et voitures d'enfants, modélisme et industries connexes du 25 janvier 1991, les stipulations l'avenant n° 85 du 10 décembre 2019 relatif à la formation professionnelle et à l'apprentissage à l'avenant n° 67 du 22 mai 2015, à la convention collective susvisée.<br/>L'article 6.4 est étendu sous réserve du respect des dispositions des articles <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000037369836&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L6223-8-1 (V)\">L. 6223-8-1</a> et <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000018497380&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. R6223-22 (V)\">R. 6223-22</a> du code du travail.</p>",
        "nota": null,
