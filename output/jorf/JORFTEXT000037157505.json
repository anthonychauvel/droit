    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000037157508",
        "cid": "JORFARTI000037157508",
        "intOrdre": 524287,
