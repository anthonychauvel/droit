{
  "titre": "Arrêté du 6 février 2026 portant extension d'un avenant à la convention collective nationale de l'optique-lunetterie de détail (n° 1431)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000053459488_01-01-2999",
