    "alias": null,
    "jorfText": "JORF n°0051 du 29 février 2020",
    "jurisState": "Sans état juridique",
    "visa": "<p align=\"left\"><br/>La ministre du travail,<br/>Vu le <a href=\"/affichCode.do?cidTexte=LEGITEXT000006072050&dateTexte=29990101&categorieLien=cid\" title=\"Code du travail (V)\">code du travail</a>, notamment ses articles L. 6323-17-5, R. 6323-18-2-1 et D. 6323-18-1 ;<br/>Vu le <a href=\"/affichTexte.do?cidTexte=JORFTEXT000000261276&categorieLien=cid\" title=\"Décret n°2005-850 du 27 juillet 2005 (V)\">décret n° 2005-850 du 27 juillet 2005</a> relatif aux délégations de signature des membres du Gouvernement ;<br/>Vu le décret du 1er avril 2019 portant nomination du délégué général à l'emploi et à la formation professionnelle,<br/>Arrête :</p>",
    "modifDate": null,
    "jurisDate": null,
    "dateDebutVersion": "2999-01-01",
    "dateFinVersion": "2999-01-01",
    "signers": "<p align=\"left\"><br/>Fait le 26 février 2020.</p><p align=\"left\"><br/>Pour la ministre et par délégation :<br/>Le délégué général à l'emploi et à la formation professionnelle,<br/>B. Lucas</p>",
    "prepWork": "",
    "dateParution": 1582934400000,
    "dateTexte": 1582675200000,
    "numParution": "0051",
    "notice": "",
    "nota": "",
