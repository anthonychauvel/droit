{
  "titre": "Arrêté du 17 décembre 2021 portant extension d'un avenant à la convention collective nationale de la production cinématographique (n° 3097)",
  "text": {
    "executionTime": 11,
    "dereferenced": false,
    "id": "JORFTEXT000044548192_01-01-2999",
