    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000034031894",
        "cid": "JORFARTI000034031894",
        "intOrdre": 524287,
