    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000047483508",
        "cid": "JORFARTI000047483508",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000047483508",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des organismes de tourisme du 5 février 1996, les stipulations de l'avenant n° 1 du 15 novembre 2022 à l'accord n° 24 du 6 décembre 2018 relatif au contrat à durée indéterminée d'opération, conclu dans le cadre de la convention collective nationale susvisée.<br/>L'article 7 du présent avenant renouvelant l'accord n° 24 dans les mêmes conditions est étendu sous réserve du respect des <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000006901173&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L1236-8 (V)\">dispositions de l'article L. 1236-8 du code du travail</a>.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
