        "path": "/JORFARTI000054666329",
        "pathTitle": [],
        "content": "<p><br/>A compter du 1<sup>er</sup> mai 2021, le montant définitif du droit à compensation des accroissements nets de charges nouvelles nettes pour les régions, les collectivités de Corse et de Saint-Martin, les collectivités territoriales de Martinique et de Guyane et le département-région de Mayotte de l'application des décrets n° 2021-521 et n° 2021-522 du 29 avril 2021 précités est fixé à 110 721 572 €.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
        "type": "AUTONOME",
        "lstLienModification": [],
        "lstLienCitation": [],
        "conditionDiffere": null,
        "historique": null,
        "surtitre": null,
        "renvoi": null,
        "versionLabel": null,
        "infosComplementaires": null,
        "infosComplementairesHtml": null,
        "infosRestructurationBranche": null,
        "infosRestructurationBrancheHtml": null,
        "dateDebut": 32472144000000,
        "dateFin": 32472144000000,
        "notaSectionsAafficher": null,
        "multipleVersions": true
      },
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000054666330",
        "cid": "JORFARTI000054666330",
        "intOrdre": 1048574,
        "etat": "VIGUEUR",
        "num": "2",
        "path": "/JORFARTI000054666330",
        "pathTitle": [],
        "content": "<p><br/>Le montant du droit à compensation fixé à l'article 1<sup>er</sup> est réparti entre les collectivités précitées conformément aux montants figurant dans le tableau suivant :</p><p><div align=\"center\"><center><table border=\"1\"><tr><th><br/>Collectivité</th><th><br/>Montant du droit à compensation définitif</th></tr><tr><td valign=\"middle\" align=\"left\"><br/>Auvergne-Rhône-Alpes</td><td valign=\"middle\" align=\"right\"><br/>2 420 558 €</td></tr><tr><td valign=\"middle\" align=\"left\"><br/>Bourgogne-Franche-Comté</td><td valign=\"middle\" align=\"right\"><br/>4 167 909 €</td></tr><tr><td valign=\"middle\" align=\"left\"><br/>Bretagne</td><td valign=\"middle\" align=\"right\"><br/>4 375 237 €</td></tr><tr><td valign=\"middle\" align=\"left\"><br/>Centre-Val de Loire</td><td valign=\"middle\" align=\"right\"><br/>3 782 035 €</td></tr><tr><td valign=\"middle\" align=\"left\"><br/>Corse</td><td valign=\"middle\" align=\"right\"><br/>178 019 €</td></tr><tr><td valign=\"middle\" align=\"left\"><br/>Grand Est</td><td valign=\"middle\" align=\"right\"><br/>7 558 187 €</td></tr><tr><td valign=\"middle\" align=\"left\"><br/>Hauts-de-France</td><td valign=\"middle\" align=\"right\"><br/>24 496 031 €</td></tr><tr><td valign=\"middle\" align=\"left\"><br/>Ile-de-France</td><td valign=\"middle\" align=\"right\"><br/>17 583 656 €</td></tr><tr><td valign=\"middle\" align=\"left\"><br/>Normandie</td><td valign=\"middle\" align=\"right\"><br/>10 467 037 €</td></tr><tr><td valign=\"middle\" align=\"left\"><br/>Nouvelle-Aquitaine</td><td valign=\"middle\" align=\"right\"><br/>7 552 055 €</td></tr><tr><td valign=\"middle\" align=\"left\"><br/>Occitanie</td><td valign=\"middle\" align=\"right\"><br/>10 552 073 €</td></tr><tr><td valign=\"middle\" align=\"left\"><br/>Pays de la Loire</td><td valign=\"middle\" align=\"right\"><br/>3 693 929 €</td></tr><tr><td valign=\"middle\" align=\"left\"><br/>Provence-Alpes-Côte d'Azur</td><td valign=\"middle\" align=\"right\"><br/>5 479 718 €</td></tr><tr><td valign=\"middle\" align=\"left\"><br/>Guadeloupe</td><td valign=\"middle\" align=\"right\"><br/>2 265 766 €</td></tr><tr><td valign=\"middle\" align=\"left\"><br/>Guyane</td><td valign=\"middle\" align=\"right\"><br/>220 319 €</td></tr><tr><td valign=\"middle\" align=\"left\"><br/>La Réunion</td><td valign=\"middle\" align=\"right\"><br/>3 369 448 €</td></tr><tr><td valign=\"middle\" align=\"left\"><br/>Martinique</td><td valign=\"middle\" align=\"right\"><br/>393 881 €</td></tr><tr><td valign=\"middle\" align=\"left\"><br/>Mayotte</td><td valign=\"middle\" align=\"right\"><br/>1 941 341 €</td></tr><tr><td valign=\"middle\" align=\"left\"><br/>Saint-Martin</td><td valign=\"middle\" align=\"right\"><br/>224 373 €</td></tr></table></center></div></p>",
