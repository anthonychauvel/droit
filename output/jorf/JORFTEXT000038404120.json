{
  "titre": "Arrêté du 16 avril 2019 portant extension d'un avenant à la convention collective nationale du personnel des huissiers de justice (n° 1921)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000038404120_01-01-2999",
