{
  "titre": "Arrêté du 25 janvier 2021 portant extension d'un accord conclu dans le cadre de la convention collective nationale des avocats salariés (n° 1850)",
  "text": {
    "executionTime": 11,
    "dereferenced": false,
    "id": "JORFTEXT000043090919_01-01-2999",
