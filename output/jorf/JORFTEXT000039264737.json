{
  "titre": "Arrêté du 18 octobre 2019 portant extension d'un accord conclu dans le cadre de la convention collective nationale des services de l'automobile (n° 1090)",
  "text": {
    "executionTime": 21,
    "dereferenced": false,
    "id": "JORFTEXT000039264737_01-01-2999",
