{
  "titre": "Arrêté du 6 février 2025 portant extension d'un avenant à la convention collective nationale des opérateurs de voyage et des guides (n° 3245)",
  "text": {
    "executionTime": 21,
    "dereferenced": false,
    "id": "JORFTEXT000051224230_01-01-2999",
