    "textAbroge": false,
    "etat": null,
    "dossiersLegislatifs": [],
    "nature": "ARRETE",
    "resume": null,
    "rectificatif": null,
    "motsCles": [],
    "appellations": [],
    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000038354315",
        "cid": "JORFARTI000038354315",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000038354315",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de l'accord professionnel du 30 juin 2015 relatif aux astreintes de nuit dans les associations régionales gestionnaires des CFA du BTP, les dispositions de l'avenant du 28 septembre 2017 à l'accord professionnel susvisé.<br/>Les articles 1, 2 et 3 de l'avenant sont étendus sous réserve que les articles 4, 1, 8 et 13 qui y sont respectivement mentionnés soient entendus comme faisant référence à l'accord professionnel susvisé.<br/>Les articles 5 et 6 sont étendus sous réserve que l'accord du 30 juin 2015 mentionné soit entendu comme l'accord professionnel susvisé.<br/>L'article 5 est étendu sous réserve du respect des <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000006901785&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L2261-7 (V)\">dispositions de l'article L. 2261-7 du code du travail</a>.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
