    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000037305048",
        "cid": "JORFARTI000037305048",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000037305048",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires pour tous les employeurs et tous les salariés du secteur des maîtres d'oeuvre en bâtiment, dans leur propre champ d'application territorial, et dans les mêmes conditions, les dispositions de :</p><p><br/>-l'accord territorial (Nord-Pas-de-Calais) du 6 janvier 2017 relatif à la valeur du point, conclu dans le cadre de la convention collective nationale susvisée, tel qu'étendu par arrêté du 6 février 2018 publié au Journal officiel du 16 février 2018.</p>",
