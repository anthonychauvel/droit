      },
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000039003731",
        "cid": "JORFARTI000039003731",
        "intOrdre": 1048574,
        "etat": "VIGUEUR",
        "num": "2",
        "path": "/JORFARTI000039003731",
        "pathTitle": [],
        "content": "<p><br/>Délégation est donnée à Mme Claire Vernet-Garnier, à M. Jérémie Gué et M. Philippe Marseille, agents contractuels, à l'effet de signer, au nom du ministre de l'économie et des finances, et dans la limite de leurs attributions, tous actes, arrêtés, décisions ou conventions.<br/>Délégation est en outre donnée à Mme Claire Vernet-Garnier, à M. Jérémie Gué et M. Philippe Marseille à l'effet de signer, au nom du ministre de l'économie et des finances, tous actes, arrêtés, décisions ou conventions relatifs à une assemblée d'actionnaires d'une société relevant de la compétence d'une direction de participations lorsque Mme Claire Vernet-Garnier, M. Jérémie Gué et M. Philippe Marseille ont été désigné par le commissaire aux participations de l'Etat pour assurer la représentation de l'Etat actionnaire à cette assemblée.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
