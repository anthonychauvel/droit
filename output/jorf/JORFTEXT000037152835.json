    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000037152838",
        "cid": "JORFARTI000037152838",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000037152838",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des cabinets d'experts-comptables et de commissaires aux comptes du 9 décembre 1974, les dispositions de l'accord du 8 décembre 2017 relatif au financement de la formation professionnelle, conclu dans le cadre de la convention collective susvisée.<br/>L'article 3 est étendu sous réserve du respect du principe général de non-rétroactivité des actes administratif.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
