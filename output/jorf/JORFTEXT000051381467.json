    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000051381470",
        "cid": "JORFARTI000051381470",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000051381470",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale du caoutchouc du 6 mars 1953, les stipulations de l'accord national du 22 octobre 2024 relatif à la définition des catégories de bénéficiaires des régimes de protection sociale complémentaire des entreprises de la branche du caoutchouc, conclu dans le cadre de la convention collective susvisée.<br/>Le 2e alinéa de l'article 5 est étendu sous réserve du respect des dispositions de l'<a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000006901785&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L2261-7\">article L. 2261-7 du code du travail</a> relatif aux modalités de révision d'un accord.</p>",
        "nota": null,
        "comporteLiens": true,
