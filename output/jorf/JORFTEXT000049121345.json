    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000049121348",
        "cid": "JORFARTI000049121348",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000049121348",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale du commerce de détail et de gros à prédominance alimentaire du 12 juillet 2001, les stipulations de l'avenant n° 85 du 9 juin 2022 relatif au contrat à durée déterminée et au travail temporaire, à la convention collective nationale susvisée.<br/>L'article 4 est étendu sous réserve de l'application des <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000006901662&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L2222-1 (MMN)\">dispositions du 3e alinéa de l'article L. 2222-1 du code du travail</a>.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
