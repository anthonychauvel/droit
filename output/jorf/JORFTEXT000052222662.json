    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000052222667",
        "cid": "JORFARTI000052222667",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000052222667",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des industries de carrières et matériaux de construction applicable aux ouvriers, employés, techniciens, agents de maîtrise et aux cadres du 6 juillet 2022, et dans leur propre champ d'application professionnel (secteur de l'industrie du béton), les stipulations de l'avenant du 21 mai 2025 à l'accord d'harmonisation du 11 avril 2024 relatif aux salaires minimaux (secteur de l'industrie du béton), conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
