{
  "titre": "Arrêté du 8 novembre 2024 portant extension d'un avenant à la convention collective nationale de l'industrie de la fabrication des ciments (n° 3233)",
  "text": {
    "executionTime": 10,
    "dereferenced": false,
    "id": "JORFTEXT000050491358_01-01-2999",
