{
  "titre": "Arrêté du 6 janvier 2026 portant extension d'un avenant à la convention collective nationale de la production cinématographique (n° 3097)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000053378949_01-01-2999",
