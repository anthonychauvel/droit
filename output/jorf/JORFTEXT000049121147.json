    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000049121153",
        "cid": "JORFARTI000049121153",
        "intOrdre": 524287,
