        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000054733195",
        "pathTitle": [],
        "content": "<p><br/>Le dernier alinéa de l'<a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000021547898&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. D2135-7\">article D. 2135-7 du code du travail</a> est supprimé.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
        "modificatorTitle": null,
