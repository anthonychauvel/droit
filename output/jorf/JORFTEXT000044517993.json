        "pathTitle": [],
        "content": "<p><br/>Sont reconnues représentatives dans le secteur des entreprises du bâtiment employant plus de 10 salariés couvert par l'ensemble des conventions collectives figurant en annexe, les organisations professionnelles d'employeurs suivantes :</p><p><br/>- Fédération Française du Bâtiment (FFB) ;<br/>- Confédération de l'Artisanat et des Petites Entreprises du Bâtiment (CAPEB).</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
