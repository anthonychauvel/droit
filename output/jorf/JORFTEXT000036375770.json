        "pathTitle": [],
        "content": "<p><br/>Sont reconnues représentatives dans la convention collective départementale du commerce de la Réunion (n° 1225) les organisations syndicales suivantes :</p><p><br/>- La Confédération française démocratique du travail (CFDT) ;<br/>- La Confédération générale du travail (CGT) ;<br/>- La Confédération générale du travail-Force ouvrière (CGT-FO) ;<br/>- L'Union Régionale 974 (UR 974).</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
