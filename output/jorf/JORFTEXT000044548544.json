    "textAbroge": false,
    "etat": null,
    "dossiersLegislatifs": [],
    "nature": "ARRETE",
    "resume": null,
    "rectificatif": null,
    "motsCles": [],
    "appellations": [],
    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000044548549",
        "cid": "JORFARTI000044548549",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000044548549",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale de la plasturgie du 1er juillet 1960, les stipulations de l'accord du 30 juin 2021 relatif à l'attribution de jours pour enfants malades, conclu dans le cadre de la convention collective susvisée.</p>",
        "nota": null,
