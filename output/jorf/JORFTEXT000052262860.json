    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000052262863",
        "cid": "JORFARTI000052262863",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000052262863",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale du personnel au sol des entreprises de transport aérien du 22 mai 1959, les stipulations de l'avenant du 26 mai 2025 à l'accord du 19 décembre 2024 relatif à la définition de catégories objectives pour le bénéfice de régime de prévoyance, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
