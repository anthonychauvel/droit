{
  "titre": "Arrêté du 9 mars 2018 portant extension d'un avenant à un accord conclu dans le cadre de la convention collective nationale des professions de la photographie (n° 3168)",
  "text": {
    "executionTime": 10,
    "dereferenced": false,
    "id": "JORFTEXT000036709161_01-01-2999",
