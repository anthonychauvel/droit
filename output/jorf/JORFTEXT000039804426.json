{
  "titre": "Arrêté du 23 décembre 2019 portant extension d'un avenant à la convention collective nationale de la pâtisserie (n° 1267)",
  "text": {
    "executionTime": 12,
    "dereferenced": false,
    "id": "JORFTEXT000039804426_01-01-2999",
