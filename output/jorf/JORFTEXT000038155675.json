{
  "titre": "Arrêté du 18 février 2019 portant extension d'un avenant à la convention collective nationale des mareyeurs-expéditeurs (n° 1589)",
  "text": {
    "executionTime": 14,
    "dereferenced": false,
    "id": "JORFTEXT000038155675_01-01-2999",
