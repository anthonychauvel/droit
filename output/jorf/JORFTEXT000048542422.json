{
  "titre": "Arrêté du 30 novembre 2023 portant extension d'un avenant à la convention collective nationale des salariés en portage salarial (n° 3219)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000048542422_01-01-2999",
