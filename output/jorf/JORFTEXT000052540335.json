        "pathTitle": [],
        "content": "<p><br/>Sont reconnues représentatives dans la convention collective nationale de l'assainissement et de la maintenance industrielle (IDCC n° 2272) les organisations syndicales suivantes :</p><p><br/>- la Confédération française démocratique du travail (CFDT) ;<br/>- la Confédération générale du travail (CGT) ;<br/>- l'Union nationale des syndicats autonomes (UNSA) ;<br/>- la Confédération générale du travail-Force ouvrière (CGT-FO).</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
