{
  "titre": "Arrêté du 25 septembre 2024 portant extension d'un avenant à la convention collective nationale de la charcuterie de détail (n° 953)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000050317632_01-01-2999",
