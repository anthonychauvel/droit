    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000047912024",
        "cid": "JORFARTI000047912024",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000047912024",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale de la coopération maritime du 7 décembre 2004, les stipulations de l'accord du 19 avril 2023 relatif aux salaires, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
