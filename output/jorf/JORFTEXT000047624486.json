    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000047624489",
        "cid": "JORFARTI000047624489",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000047624489",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale de l'optique-lunetterie de détail du 2 juin 1986, les stipulations de l'avenant du 15 décembre 2022 à l'accord du 26 mai 2016 modifiant le nom du CQP « Opti-Vision » en CQP « Opticien Spécialisé », conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
