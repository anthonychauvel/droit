{
  "titre": "Arrêté du 5 février 2020 portant extension d'un avenant à la convention collective nationale de l'immobilier (n° 1527)",
  "text": {
    "executionTime": 19,
    "dereferenced": false,
    "id": "JORFTEXT000041559501_01-01-2999",
