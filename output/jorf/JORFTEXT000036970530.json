{
  "titre": "Arrêté du 25 mai 2018 portant extension d'un avenant à la convention collective nationale de la transformation des grains (n° 1930)",
  "text": {
    "executionTime": 15,
    "dereferenced": false,
    "id": "JORFTEXT000036970530_01-01-2999",
    "idConteneur": null,
    "cid": "JORFTEXT000036970530",
    "title": "Arrêté du 25 mai 2018 portant extension d'un avenant à la convention collective nationale de la transformation des grains (n° 1930)",
    "nor": "MTRT1814353A",
    "eli": null,
