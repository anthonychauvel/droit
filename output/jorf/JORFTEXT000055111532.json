    "dateFinVersion": "2999-01-01",
    "signers": "<p align=\"left\"><br/>Fait le 18 novembre 2026.</p><p align=\"left\"><br/>Pour le ministre et par délégation :<br/>La cheffe du bureau des agents titulaires,<br/>L. BATALLA</p>",
