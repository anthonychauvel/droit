    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000046830238",
        "cid": "JORFARTI000046830238",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000046830238",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale de la transformation des grains du 16 juin 1996, les stipulations de l'avenant n° 22 du 28 septembre 2022 relatif à la rémunération mensuelle minimum (REMM) 2022, à la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
