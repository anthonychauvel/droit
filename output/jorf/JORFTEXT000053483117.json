{
  "titre": "Arrêté du 11 février 2026 portant extension d'un avenant à la convention collective nationale des entreprises du bureau et du numérique - commerces et services (n° 1539)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000053483117_01-01-2999",
