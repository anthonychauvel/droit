{
  "titre": "Arrêté du 16 avril 2019 portant extension d'un avenant à la convention collective nationale de la boulangerie-pâtisserie (entreprises artisanales) (n° 843)",
  "text": {
    "executionTime": 31,
    "dereferenced": false,
    "id": "JORFTEXT000038404268_01-01-2999",
