{
  "titre": "Arrêté du 24 septembre 2024 portant extension d'un avenant à la convention collective nationale du bricolage (n° 1606)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000050317117_01-01-2999",
