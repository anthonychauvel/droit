    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000050317120",
        "cid": "JORFARTI000050317120",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000050317120",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale du bricolage du 30 septembre 1991, les stipulations de l'avenant du 13 février 2024 portant modification de l'article 6.7 « Congés pour évènements familiaux » et de l'article 7.6 « Absence pour soigner un enfant malade », à la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
