{
  "titre": "Arrêté du 3 juillet 2026 portant extension d'un accord conclu dans le cadre de la convention collective nationale des acteurs du lien social et familial (n° 1261)",
  "text": {
    "executionTime": 0,
    "dereferenced": false,
    "id": "JORFTEXT000054415664_01-01-2999",
