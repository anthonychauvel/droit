{
  "titre": "Arrêté du 5 mars 2025 portant extension d'un avenant à la convention collective nationale des ateliers et chantiers d'insertion (n° 3016)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000051337217_01-01-2999",
