    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000049475072",
        "cid": "JORFARTI000049475072",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000049475072",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale de l'hôtellerie de plein air du 2 juin 1993, les stipulations de l'avenant n° 45 du 5 février 2024 relatif aux salaires, à la convention collective susvisée.</p>",
        "nota": null,
