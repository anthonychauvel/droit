    "textAbroge": false,
    "etat": null,
    "dossiersLegislatifs": [],
    "nature": "ARRETE",
    "resume": null,
    "rectificatif": null,
    "motsCles": [],
    "appellations": [],
    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000043794367",
        "cid": "JORFARTI000043794367",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000043794367",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale du personnel des agences de voyages et de tourisme du 12 mars 1993 tel que modifié par les arrêtés des 5 janvier 2017 et 23 janvier 2019 susvisés, les stipulations de l'accord du 20 juin 2019 relatif à la mise à disposition des salariés, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
