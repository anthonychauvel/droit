{
  "titre": "Arrêté du 19 octobre 2026 portant extension d'un accord conclu dans le cadre de la <mark>convention</mark> collective nationale du bricolage (n° 1606)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000055006672_01-01-2999",
