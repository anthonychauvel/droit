    "textAbroge": false,
    "etat": null,
    "dossiersLegislatifs": [],
    "nature": "ARRETE",
    "resume": null,
    "rectificatif": null,
    "motsCles": [],
    "appellations": [],
    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000046534524",
        "cid": "JORFARTI000046534524",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000046534524",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective de la métallurgie des Côtes-d'Armor du 5 avril 1991, les stipulations de l'accord du 5 juillet 2022 relatif au barème de taux effectifs garantis annuels (TEGA) 2022, conclu dans le cadre de la convention collective susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
