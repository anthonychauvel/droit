{
  "titre": "Arrêté du 28 juin 2024 portant extension d'un avenant à un accord, conclu dans le cadre de la convention collective nationale des entreprises d'architecture (n° 2332)",
  "text": {
    "executionTime": 15,
    "dereferenced": false,
    "id": "JORFTEXT000049895475_01-01-2999",
