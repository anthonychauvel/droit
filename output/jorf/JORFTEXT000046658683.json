{
  "titre": "Arrêté du 23 novembre 2022 portant extension d'un avenant concernant le financement du dialogue social dans la V Branches",
  "text": {
    "executionTime": 13,
    "dereferenced": false,
    "id": "JORFTEXT000046658683_01-01-2999",
