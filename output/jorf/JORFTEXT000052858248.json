        "pathTitle": [],
        "content": "<p><br/>Sont reconnues représentatives dans la convention collective nationale des gardiens, concierges et employés d'immeubles (IDCC n° 1043), les organisations syndicales suivantes :</p><p><br/>- la Confédération générale du travail (CGT) ;<br/>- le Syndicat national indépendant des gardiens d'immeubles et concierges (SNIGIC) ;<br/>- l'Union nationale des syndicats autonomes (UNSA) ;<br/>- la Confédération générale du travail-Force ouvrière (CGT-FO) ;<br/>- la Confédération française démocratique du travail (CFDT).</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
