{
  "titre": "Arrêté du 6 février 2026 portant extension d'un avenant à la convention collective nationale du sport (n° 2511)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000053459540_01-01-2999",
