{
  "titre": "Arrêté du 12 mars 2024 portant extension d'un avenant à un accord conclu dans le cadre de la convention collective nationale de l'import-export et du commerce international (n° 43)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000049358538_01-01-2999",
