    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000036259989",
        "cid": "JORFARTI000036259989",
        "intOrdre": 524287,
