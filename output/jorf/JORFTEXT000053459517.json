{
  "titre": "Arrêté du 6 février 2026 portant extension d'un avenant à la convention collective nationale de l'enseignement privé indépendant (n° 2691)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000053459517_01-01-2999",
