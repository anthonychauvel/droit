    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000046781073",
        "cid": "JORFARTI000046781073",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000046781073",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de l'accord du 22 janvier 2021 relatif à la période de reconversion ou de promotion par alternance dite « Pro-A » pour les salariés intérimaires en contrat à durée indéterminée conclu dans le secteur du travail temporaire, les stipulations de l'avenant n° 1 du 7 octobre 2022 audit accord.</p>",
        "nota": null,
