{
  "titre": "Arrêté du 30 octobre 2019 portant extension d'un avenant à la convention collective nationale des sociétés d'assistance (n° 1801)",
  "text": {
    "executionTime": 13,
    "dereferenced": false,
    "id": "JORFTEXT000039309959_01-01-2999",
