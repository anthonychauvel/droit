    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000049358816",
        "cid": "JORFARTI000049358816",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000049358816",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale du négoce de l'ameublement du 31 mai 1995, les stipulations de l'avenant du 16 novembre 2023 relatif au remboursement des frais d'hébergement liés à la participation aux réunions paritaires pendant les jeux Olympiques 2024, à la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
