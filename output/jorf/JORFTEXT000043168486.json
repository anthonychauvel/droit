    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000043168489",
        "cid": "JORFARTI000043168489",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000043168489",
        "pathTitle": [],
        "content": "<p><br/>Au titre de l'année 2021, la progression annuelle maximale du nombre de jours pouvant être inscrits sur un compte épargne-temps au-delà du seuil mentionné à l'<a href=\"/affichTexteArticle.do?cidTexte=JORFTEXT000000774142&idArticle=JORFARTI000001050625&categorieLien=cid\" title=\"Décret n°2002-788 du 3 mai 2002 - art. 4 (M)\">article 4 du décret du 3 mai 2002 susvisé</a>, est fixée à vingt jours.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
