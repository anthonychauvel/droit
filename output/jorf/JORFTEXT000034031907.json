{
  "titre": "Arrêté du 6 février 2017 portant extension d'un avenant à la convention collective nationale des entreprises artistiques et culturelles (n° 1285)",
  "text": {
    "executionTime": 15,
    "dereferenced": false,
    "id": "JORFTEXT000034031907_01-01-2999",
