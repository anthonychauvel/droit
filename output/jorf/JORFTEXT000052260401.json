{
  "titre": "Arrêté du 12 septembre 2025 portant extension d'un accord conclu dans le cadre de la convention collective nationale des entreprises artistiques et culturelles (n° 1285)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000052260401_01-01-2999",
