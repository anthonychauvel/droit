        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000051532712",
        "pathTitle": [],
        "content": "<p><br/>Il est procédé au changement des locaux de l'établissement de placement éducatif, dénommé « EPE Toulouse », et de l'unité éducative d'hébergement collectif dénommée « UEHC La Cale », désormais domiciliés au 5, chemin de la Cale, 31400 Toulouse.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
