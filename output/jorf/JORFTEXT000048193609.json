    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000048193612",
        "cid": "JORFARTI000048193612",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000048193612",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale du personnel sédentaire des entreprises de navigation du 14 septembre 2010, les stipulations de l'avenant rectificatif du 11 avril 2023 à l'accord du 15 février 2022 relatif au télétravail, conclu dans le cadre de la convention collective nationale susvisée.<br/>Le 2e alinéa de l'article 1 du chapitre 2 de l'accord du 15 février 2022, tel que modifié par l'article 1 de l'avenant, est étendu sous réserve du respect des mentions obligatoires de l'<a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000025558060&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L1222-9 (M)\">article L. 1222-9 du code du travail</a>.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
