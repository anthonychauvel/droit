{
  "titre": "Arrêté du 18 décembre 2020 portant extension d'un avenant à la convention collective nationale du sport (n° 2511)",
  "text": {
    "executionTime": 5,
    "dereferenced": false,
    "id": "JORFTEXT000042731787_01-01-2999",
