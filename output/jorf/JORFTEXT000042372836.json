{
  "titre": "Arrêté du 18 septembre 2020 portant extension d'un avenant à la convention collective nationale du négoce de l'ameublement (n° 1880)",
  "text": {
    "executionTime": 28,
    "dereferenced": false,
    "id": "JORFTEXT000042372836_01-01-2999",
