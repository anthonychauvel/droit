{
  "titre": "Arrêté du 25 septembre 2024 portant extension d'un avenant à un accord conclu dans le cadre de la convention collective nationale des entreprises d'architecture (n° 2332)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000050317614_01-01-2999",
