    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000053042759",
        "cid": "JORFARTI000053042759",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000053042759",
        "pathTitle": [],
        "content": "<p><br/>Sont reconnues représentatives dans la convention collective des coopératives agricoles, unions de coopératives agricoles et SICA, de fleurs, fruits et légumes frais, transformés et conserveries, de teillage de lin-chanvre et de déshydratation (IDCC n° 7028) les organisations professionnelles d'employeurs suivantes :</p><p><br/>- Fédération française de la coopération fruitière, légumière et horticole (FELCOOP) ;<br/>- Fédération syndicale du teillage agricole du lin (FESTAL) ;<br/>- Fédération nationale des déshydrateurs (FND).</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
