{
  "titre": "Arrêté du 6 février 2017 portant élargissement d'un avenant à la convention collective nationale des entreprises d'architecture au secteur des maîtres d'œuvre en bâtiment (n° 2332)",
  "text": {
    "executionTime": 14,
    "dereferenced": false,
    "id": "JORFTEXT000034050319_01-01-2999",
