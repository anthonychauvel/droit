{
  "titre": "Arrêté du 14 décembre 2018 portant extension d'un avenant à la convention collective nationale des organismes de formation (n° 1516)",
  "text": {
    "executionTime": 4,
    "dereferenced": false,
    "id": "JORFTEXT000037840319_01-01-2999",
