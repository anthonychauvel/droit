{
  "titre": "Arrêté du 16 septembre 2025 portant extension d'un avenant à la convention collective nationale de l'optique-lunetterie de détail (n° 1431)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000052262882_01-01-2999",
