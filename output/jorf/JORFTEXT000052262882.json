    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000052262886",
        "cid": "JORFARTI000052262886",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000052262886",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale de l'optique-lunetterie de détail du 2 juin 1986, les stipulations de l'avenant du 19 juin 2025 relatif aux plafonds de remboursement des frais d'hôtel et de restauration, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
