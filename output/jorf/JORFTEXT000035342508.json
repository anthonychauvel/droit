{
  "titre": "Arrêté du 25 juillet 2017 portant extension d'un avenant à la convention collective nationale des cinq branches des industries alimentaires diverses (n° 3109)",
  "text": {
    "executionTime": 33,
    "dereferenced": false,
    "id": "JORFTEXT000035342508_01-01-2999",
