{
  "titre": "Arrêté du 4 février 2022 portant extension d'un avenant à la convention collective nationale des entreprises de courtage d'assurances et/ou de réassurances (n° 2247)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000045155740_01-01-2999",
