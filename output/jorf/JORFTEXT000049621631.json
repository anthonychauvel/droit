    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000049621635",
        "cid": "JORFARTI000049621635",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000049621635",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des activités de production des eaux embouteillées, des boissons rafraichissantes sans alcool et de bière du 24 mai 1988, les stipulations de l'avenant n° 44 du 10 janvier 2024 relatif aux salaires minima conventionnels, à la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
