{
  "titre": "Arrêté du 28 avril 2017 portant extension d'un avenant à un accord conclu dans le cadre de la convention collective nationale des organismes de formation (n° 1516)",
  "text": {
    "executionTime": 21,
    "dereferenced": false,
    "id": "JORFTEXT000034640628_01-01-2999",
