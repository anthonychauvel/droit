        "id": "JORFARTI000054854991",
        "cid": "JORFARTI000054854991",
        "intOrdre": 1048574,
        "etat": "VIGUEUR",
        "num": "2",
        "path": "/JORFARTI000054854991",
        "pathTitle": [],
        "content": "<p><br/>Le montant de l'abattement à défalquer du total des salaires servant de base au calcul de la cotisation due par les employeurs aux caisses de congés payés prévu aux <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000018496488&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. D5424-36\">articles D. 5424-36</a> et <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000018496496&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. D5424-40\">D. 5424-40 du code du travail</a> est fixé pour la période du 1<sup>er</sup> avril 2026 au 31 mars 2027 à 96 168 euros.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
        "type": "AUTONOME",
        "lstLienModification": [],
        "lstLienCitation": [],
        "conditionDiffere": null,
        "historique": null,
        "surtitre": null,
        "renvoi": null,
        "versionLabel": null,
        "infosComplementaires": null,
        "infosComplementairesHtml": null,
        "infosRestructurationBranche": null,
        "infosRestructurationBrancheHtml": null,
        "dateDebut": 32472144000000,
        "dateFin": 32472144000000,
