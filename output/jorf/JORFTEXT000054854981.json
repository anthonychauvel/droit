      },
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000054854994",
        "cid": "JORFARTI000054854994",
        "intOrdre": 1572861,
        "etat": "VIGUEUR",
        "num": "3",
        "path": "/JORFARTI000054854994",
        "pathTitle": [],
        "content": "<p><br/>Le taux de cotisation du régime intempéries prévu à l'<a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000018496496&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. D5424-40\">article D. 5424-40 du code du travail</a> est fixé, pour la période du 1<sup>er</sup> avril 2026 au 31 mars 2027, à 0,68 % du montant des salaires à prendre en compte déduction faite de l'abattement défini à l'<a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000018496488&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. D5424-36\">article D. 5424-36 du même code</a> pour les entreprises appartenant à la catégorie du gros œuvre et des travaux publics et à 0,13 % du montant des salaires pris en compte après déduction de l'abattement pour les entreprises n'entrant pas dans la catégorie du gros œuvre et des travaux publics.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
