{
  "titre": "Arrêté du 3 juillet 2026 portant extension d'un avenant à la convention collective nationale de <mark>travail</mark> des journalistes (n° 1480)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000054415827_01-01-2999",
