    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000054415830",
        "cid": "JORFARTI000054415830",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000054415830",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale de travail des journalistes du 27 octobre 1987, et dans leur propre champ d'application professionnel, les stipulations de l'avenant n° 1 du 10 octobre 2025 portant révision de la classification et des salaires minima des journalistes travaillant dans des entreprises de presse hebdomadaire régionale (PHR), à la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
