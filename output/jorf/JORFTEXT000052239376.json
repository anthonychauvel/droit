      },
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000052239389",
        "cid": "JORFARTI000052239389",
        "intOrdre": 1572861,
        "etat": "VIGUEUR",
        "num": "3",
        "path": "/JORFARTI000052239389",
        "pathTitle": [],
        "content": "<p><br/>Lorsque la convention prévue à l'<a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000045205483&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L6235-2\">article L. 6235-2 du code du travail</a> prévoit la possibilité de conclure un contrat d'apprentissage transfrontalier à temps partiel en application de la réglementation du pays frontalier, le niveau de prise en charge mentionné à l'article 1<sup>er</sup>, majoré, le cas échéant, dans les conditions prévues à l'article 2, est versé au prorata de la quotité de temps de travail de l'apprenti.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
