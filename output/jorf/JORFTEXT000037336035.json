{
  "titre": "Arrêté du 17 août 2018 portant extension d'un accord conclu dans le cadre de la convention collective nationale de l'édition phonographique (n° 2770)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000037336035_01-01-2999",
