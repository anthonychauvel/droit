    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000054149353",
        "cid": "JORFARTI000054149353",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000054149353",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des sociétés d'expertises et d'évaluations du 7 décembre 1976, les stipulations de l'avenant n° 75 du 23 février 2026 relatif aux minima conventionnels à la convention collective susvisée.</p>",
        "nota": null,
