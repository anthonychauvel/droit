{
  "titre": "Arrêté du 19 décembre 2025 portant extension d'un accord conclu dans le cadre de la convention collective nationale des organismes de tourisme (n° 1909)",
  "text": {
    "executionTime": 17,
    "dereferenced": false,
    "id": "JORFTEXT000053287180_01-01-2999",
