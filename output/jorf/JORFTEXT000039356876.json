{
  "titre": "Arrêté du 4 novembre 2019 portant extension d'un avenant à la convention collective nationale des entreprises de services à la personne (n° 3127)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000039356876_01-01-2999",
