{
  "titre": "Arrêté du 22 mars 2024 portant extension d'un avenant à la convention collective nationale des entreprises artistiques et culturelles (n° 1285)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000049358822_01-01-2999",
