    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000051207380",
        "cid": "JORFARTI000051207380",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000051207380",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des activités de production des eaux embouteillées, des boissons rafraîchissantes sans alcool et de bière du 24 mai 1988, les stipulations de l'avenant du 10 janvier 2024 relatif à la révision du chapitre III, article 3.15 - Problèmes généraux de l'emploi, à la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
