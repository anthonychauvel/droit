    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000037658391",
        "cid": "JORFARTI000037658391",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000037658391",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des maisons d'étudiants du 27 mai 1992, les dispositions de l'avenant n° 65 du 12 mars 2018 relatif à la Commission paritaire nationale de négociation, à la convention collective nationale susvisée.<br/>L'article 1.9.3. est étendu sous réserve de l'application des <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000006901694&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L2232-9 (VT)\">dispositions de l'article L. 2232-9 du code du travail</a>.</p>",
        "nota": null,
