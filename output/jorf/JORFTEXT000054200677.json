    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000054200680",
        "cid": "JORFARTI000054200680",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000054200680",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale de l'habitat et du logement accompagnés du 16 juillet 2003, les stipulations de l'avenant n° 72 du 6 février 2026 relatif à l'évolution des cotisations « Prévoyance », à la convention collective nationale susvisée.</p>",
        "nota": null,
