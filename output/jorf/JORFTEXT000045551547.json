{
  "titre": "Arrêté du 1er avril 2022 portant extension d'un avenant à la convention collective nationale des entreprises de désinfection, désinsectisation et dératisation (n° 1605)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000045551547_01-01-2999",
