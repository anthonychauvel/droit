{
  "titre": "Arrêté du 15 janvier 2020 portant extension d'un avenant à la convention collective nationale unifiée « Ports et Manutention » (n° 3017)",
  "text": {
    "executionTime": 10,
    "dereferenced": false,
    "id": "JORFTEXT000041460300_01-01-2999",
