{
  "titre": "Arrêté du 25 septembre 2024 portant extension d'un avenant à la convention collective nationale de la métallurgie (n° 3248)",
  "text": {
    "executionTime": 34,
    "dereferenced": false,
    "id": "JORFTEXT000050317577_01-01-2999",
