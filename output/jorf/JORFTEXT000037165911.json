{
  "titre": "Arrêté du 2 juillet 2018 portant extension d'un accord conclu dans le cadre de la convention collective nationale des cabinets dentaires (n° 1619)",
  "text": {
    "executionTime": 19,
    "dereferenced": false,
    "id": "JORFTEXT000037165911_01-01-2999",
