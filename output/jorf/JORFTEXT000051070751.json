{
  "titre": "Arrêté du 15 janvier 2025 portant extension d'un avenant à un accord conclu dans le cadre de la convention collective nationale du bricolage (n° 1606)",
  "text": {
    "executionTime": 10,
    "dereferenced": false,
    "id": "JORFTEXT000051070751_01-01-2999",
