{
  "titre": "Arrêté du 11 décembre 2025 portant extension d'un avenant à la convention collective nationale des coopératives de consommation (n° 3205)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000053167900_01-01-2999",
