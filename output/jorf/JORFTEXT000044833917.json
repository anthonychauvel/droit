{
  "titre": "Arrêté du 27 décembre 2021 portant extension d'un accord conclu dans le cadre de la convention collective nationale de l'architecture (n° 2332)",
  "text": {
    "executionTime": 0,
    "dereferenced": false,
    "id": "JORFTEXT000044833917_01-01-2999",
