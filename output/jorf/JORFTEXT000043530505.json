    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000043530509",
        "cid": "JORFARTI000043530509",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000043530509",
        "pathTitle": [],
        "content": "<p><br/>Sont étendues, conformément aux <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006073189&idArticle=LEGIARTI000006745466&dateTexte=&categorieLien=cid\" title=\"Code de la sécurité sociale. - art. L911-3 (VD)\">dispositions de l'article L. 911-3 du code de la sécurité sociale</a>, les stipulations de l'avenant n° 7, conclu le 17 mars 2020, et des avenants n° 8 et n° 9, conclus le 15 octobre 2020, à l'accord national interprofessionnel du 17 novembre 2017 instituant le régime AGIRC-ARRCO de retraite complémentaire. <br/>Cette extension a pour effet de rendre les stipulations de ces avenants obligatoires pour tous les salariés, anciens salariés et leurs ayants droit et pour tous les employeurs compris dans leur champ d'application.</p>",
        "nota": null,
