{
  "titre": "Arrêté du 27 décembre 2016 portant extension d'un accord conclu dans le cadre de la convention collective nationale des distributeurs conseils hors domicile (n° 1536)",
  "text": {
    "executionTime": 4,
    "dereferenced": false,
    "id": "JORFTEXT000033781443_01-01-2999",
