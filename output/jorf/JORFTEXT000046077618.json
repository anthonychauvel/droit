{
  "titre": "Arrêté du 18 juillet 2022 portant extension d'un avenant à la convention collective des industries de la métallurgie de Saône-et-Loire (n° 1564)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000046077618_01-01-2999",
