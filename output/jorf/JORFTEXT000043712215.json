{
  "titre": "Arrêté du 9 juin 2021 portant extension d'un accord conclu dans le cadre de la convention collective nationale des cabinets d'experts-comptables et de commissaires aux comptes (n° 787)",
  "text": {
    "executionTime": 12,
    "dereferenced": false,
    "id": "JORFTEXT000043712215_01-01-2999",
