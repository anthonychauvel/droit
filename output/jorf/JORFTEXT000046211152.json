{
  "titre": "Arrêté du 11 août 2022 portant extension d'un accord conclu dans le cadre de la convention collective nationale du portage de presse (n° 2683)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000046211152_01-01-2999",
