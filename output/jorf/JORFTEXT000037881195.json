{
  "titre": "Arrêté du 27 décembre 2018 portant extension d'un avenant à la convention collective nationale des organisations professionnelles de l'habitat social (n° 2526)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000037881195_01-01-2999",
