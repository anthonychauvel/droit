{
  "titre": "Arrêté du 2 juillet 2021 portant extension d'un avenant à la convention collective nationale de l'habitat et du logement accompagné (n° 2336)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000043794192_01-01-2999",
