{
  "titre": "Arrêté du 28 juin 2024 portant extension d'un avenant interprétatif à la convention collective nationale de l'import-export et du commerce international (n° 43)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000049895442_01-01-2999",
