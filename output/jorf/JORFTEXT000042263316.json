{
  "titre": "Arrêté du 20 août 2020 portant nomination d'un administrateur provisoire de la caisse interprofessionnelle de prévoyance et d'assurance vieillesse (CIPAV)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000042263316_01-01-2999",
