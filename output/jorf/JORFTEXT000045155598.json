    "textAbroge": false,
    "etat": null,
    "dossiersLegislatifs": [],
    "nature": "ARRETE",
    "resume": null,
    "rectificatif": null,
    "motsCles": [],
    "appellations": [],
    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000045155603",
        "cid": "JORFARTI000045155603",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000045155603",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris le champ d'application de l'accord national du 20 novembre 2020 relatif aux rôles et missions de la commission paritaire nationale de l'emploi et de la formation professionnelle (CPNEFP) conclu dans le secteur des industries de carrières et matériaux de construction et de la chaux, les stipulations de l'avenant n° 1 du 15 septembre 2021 audit accord national.</p>",
        "nota": null,
        "comporteLiens": true,
