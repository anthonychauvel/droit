{
  "titre": "Arrêté du 14 janvier 2025 portant extension d'un avenant à la convention collective nationale du personnel sédentaire des entreprises de navigation (n° 2972)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000051032021_01-01-2999",
