    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000050495760",
        "cid": "JORFARTI000050495760",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000050495760",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des hôtels, cafés, restaurants du 30 avril 1997, les stipulations de l'avenant n° 34 du 19 juin 2024 relatif au bénéfice de jours d'absences rémunérés en cas de maladie de l'enfant, à la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
