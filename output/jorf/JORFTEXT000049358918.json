{
  "titre": "Arrêté du 22 mars 2024 portant extension d'un avenant à la convention collective nationale des commerces de détail non alimentaires (n° 1517)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000049358918_01-01-2999",
