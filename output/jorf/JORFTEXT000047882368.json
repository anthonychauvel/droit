    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000047882370",
        "cid": "JORFARTI000047882370",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000047882370",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale de la pharmacie d'officine du 3 décembre 1997, les stipulations de l'avenant du 5 décembre 2022 relatif aux régimes de prévoyance et aux régimes de frais de soins de santé des salariés, à la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
