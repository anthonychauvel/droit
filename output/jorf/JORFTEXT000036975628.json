    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000036975631",
        "cid": "JORFARTI000036975631",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000036975631",
        "pathTitle": [],
        "content": "<p><br/>Les dispositions de l'avenant n° 5 du 9 février 2018 à l'accord départemental du 17 septembre 2009 relatif à l'assurance complémentaire frais de santé des salariés agricoles non cadres du Gers sont rendues obligatoires pour tous les employeurs et tous les salariés compris dans le champ d'application professionnel et territorial dudit accord, sous réserve à l'alinéa 4 de l'article 3 du respect des dispositions de l'article 6.3.1 de l'accord du 10 juin 2008 étendu par l'arrêté du 3 décembre 2008 susvisé.</p>",
        "nota": null,
