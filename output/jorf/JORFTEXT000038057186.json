{
  "titre": "Arrêté du 21 janvier 2019 portant extension d'un avenant à la convention collective nationale de l'animation (n° 1518)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000038057186_01-01-2999",
