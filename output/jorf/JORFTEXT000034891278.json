{
  "titre": "Arrêté du 1er juin 2017 portant extension d'un avenant à la convention collective de <mark>travail</mark> concernant les exploitations agricoles du département du Lot",
  "text": {
    "executionTime": 20,
    "dereferenced": false,
    "id": "JORFTEXT000034891278_01-01-2999",
