    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000048148574",
        "cid": "JORFARTI000048148574",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000048148574",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective des industries métallurgiques, mécaniques, électriques et connexes de la Côte-d'Or du 1er septembre 1995, les stipulations de l'avenant 2023-01 du 3 juillet 2023 relatif aux salaires, à la convention collective susvisée.</p>",
        "nota": null,
