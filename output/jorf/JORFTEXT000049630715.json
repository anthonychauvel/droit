{
  "titre": "Arrêté du 27 mai 2024 portant extension d'un avenant à la convention collective nationale des cabinets dentaires (n° 1619)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000049630715_01-01-2999",
