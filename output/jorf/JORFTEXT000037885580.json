{
  "titre": "Arrêté du 28 décembre 2018 portant extension d'un avenant à la convention collective nationale des maisons d'étudiants (n° 1671)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000037885580_01-01-2999",
