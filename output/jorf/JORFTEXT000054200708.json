    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000054200711",
        "cid": "JORFARTI000054200711",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000054200711",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des entreprises du négoce et de l'industrie des produits du sol, engrais et produits connexes du 2 juillet 1980, les stipulations de l'avenant du 25 novembre 2025 à l'accord du 11 juillet 2017 relatif à un régime de prévoyance pour les non-cadres complété par l'avenant du 2 février 2026 susvisé, conclus dans le cadre de la convention collective nationale susvisée.<br/>A l'article 1<sup>er</sup> de l'avenant, les mots : « selon les coefficients fixés par le conseil d'administration de l'organisme assureur désigné pour la garantie rente éducation sur proposition des partenaires sociaux » sont exclus de l'extension en tant qu'ils contreviennent aux dispositions de l'<a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006073189&idArticle=LEGIARTI000006745472&dateTexte=&categorieLien=cid\" title=\"Code de la sécurité sociale. - art. L912-1\">article L. 912-1 du code de la sécurité sociale</a>.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
