{
  "titre": "Arrêté du 27 mars 2019 portant extension d'un accord conclu dans le cadre de la convention collective nationale des entreprises du commerce à distance (n° 2198)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000038334669_01-01-2999",
