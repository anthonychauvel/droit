{
  "titre": "Arrêté du 28 avril 2017 portant extension d'un accord national conclu dans le secteur de la métallurgie",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000034599534_01-01-2999",
