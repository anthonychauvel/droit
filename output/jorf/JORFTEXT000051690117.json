        "cid": "JORFARTI000051690127",
        "intOrdre": 1048574,
        "etat": "VIGUEUR",
        "num": "2",
        "path": "/JORFARTI000051690127",
        "pathTitle": [],
        "content": "<p><br/>Le montant de l'abattement à défalquer du total des salaires servant de base au calcul de la cotisation due par les employeurs aux caisses de congés payés en application des articles susvisés du <a href=\"/affichCode.do?cidTexte=LEGITEXT000006072050&dateTexte=&categorieLien=cid\" title=\"Code du travail\">code du travail</a> est fixé pour la période du 1er avril 2024 au 31 mars 2025 à 93 204 euros.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
        "type": "AUTONOME",
        "lstLienModification": [],
        "lstLienCitation": [],
