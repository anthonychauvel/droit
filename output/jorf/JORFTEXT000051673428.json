    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000051673432",
        "cid": "JORFARTI000051673432",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000051673432",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des entreprises du négoce et de la distribution de combustibles solides, liquides, gazeux et produits pétroliers du 20 décembre 1985, les stipulations de l'accord du 13 mars 2025 portant revalorisation des salaires minima conventionnels au 1er mai 2025, conclu dans le cadre de la convention collective susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
