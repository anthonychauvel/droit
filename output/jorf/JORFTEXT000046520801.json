    "textAbroge": false,
    "etat": null,
    "dossiersLegislatifs": [],
    "nature": "ARRETE",
    "resume": null,
    "rectificatif": null,
    "motsCles": [],
    "appellations": [],
    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000046520804",
        "cid": "JORFARTI000046520804",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000046520804",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective des industries métallurgiques, mécaniques et connexes d'Eure-et-Loir du 27 juillet 1978, les stipulations de l'avenant du 8 juillet 2022 relatif à la valeur du point, aux rémunérations annuelles garanties et au montant de l'indemnité de restauration sur le lieu de travail, à la convention collective susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
