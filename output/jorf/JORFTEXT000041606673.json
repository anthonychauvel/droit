{
  "titre": "Arrêté du 13 février 2020 portant extension d'un avenant à la convention collective nationale du golf (n° 2021)",
  "text": {
    "executionTime": 13,
    "dereferenced": false,
    "id": "JORFTEXT000041606673_01-01-2999",
