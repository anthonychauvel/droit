{
  "titre": "Arrêté du 13 novembre 2025 portant extension d'un avenant à un accord conclu dans le cadre de la convention collective nationale du bricolage (n° 1606)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000052821049_01-01-2999",
