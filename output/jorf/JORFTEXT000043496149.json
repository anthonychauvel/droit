    "appellations": [],
    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000043496152",
        "cid": "JORFARTI000043496152",
        "intOrdre": 524287,
