    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000044470148",
        "cid": "JORFARTI000044470148",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000044470148",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des services de l'automobile du 15 janvier 1981, les stipulations de l'accord paritaire national du 8 avril 2021 relatif au capital de fin de carrière au bénéfice de certains salariés prenant avant 60 ans une retraite anticipée pour carrière longue, conclu dans le cadre de la convention collective susvisée.</p>",
        "nota": null,
