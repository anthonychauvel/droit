{
  "titre": "Arrêté du 3 avril 2020 portant extension d'un avenant à la convention collective nationale des entreprises de propreté et services associés (n° 3043)",
  "text": {
    "executionTime": 8,
    "dereferenced": false,
    "id": "JORFTEXT000041789971_01-01-2999",
