    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000046144838",
        "cid": "JORFARTI000046144838",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000046144838",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés du commerce de gros de la poissonnerie, les stipulations de l'avenant du 29 novembre 2021 relatif à la suppression de la garantie dépendance à compter du 1er janvier 2022, à la convention collective nationale de la poissonnerie, tel qu'étendu par arrêté du 27 juin 2022 publié au Journal officiel de la République française du 8 juillet 2022.</p>",
        "nota": null,
        "comporteLiens": false,
