{
  "titre": "Arrêté du 24 novembre 2016 portant extension d'avenants à la convention collective nationale des entreprises techniques au service de la création et de l'événement (n° 2717)",
  "text": {
    "executionTime": 24,
    "dereferenced": false,
    "id": "JORFTEXT000033545691_01-01-2999",
