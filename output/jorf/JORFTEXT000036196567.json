{
  "titre": "Arrêté du 6 décembre 2017 portant extension d'un avenant à la convention collective nationale du thermalisme (n° 2104)",
  "text": {
    "executionTime": 17,
    "dereferenced": false,
    "id": "JORFTEXT000036196567_01-01-2999",
