    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000034129045",
        "cid": "JORFARTI000034129045",
        "intOrdre": 524287,
