{
  "titre": "Arrêté du 26 mars 2026 portant extension d'un avenant à la convention collective nationale de la production cinématographique (n° 3097)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000053755072_01-01-2999",
