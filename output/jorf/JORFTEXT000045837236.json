    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000045837239",
        "cid": "JORFARTI000045837239",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000045837239",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans leur propre champ d'application, les stipulations de l'accord du 15 avril 2022 relatif l'activité partielle de longue durée pour le maintien en emploi des salariés intérimaires, conclu dans le secteur du travail temporaire.</p>",
        "nota": null,
