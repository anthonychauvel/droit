    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000047882391",
        "cid": "JORFARTI000047882391",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000047882391",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective des ateliers et chantiers d'insertion du 31 mars 2011, à l'exclusion des entités soumises à agrément au sens de l'<a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006074069&idArticle=LEGIARTI000006797523&dateTexte=&categorieLien=cid\" title=\"Code de l'action sociale et des familles - art. L314-6 (V)\">article L. 314-6 du code de l'action sociale et des familles</a> modifié par la loi n° 2008-130 du 17 décembre 2008 (article 63), les stipulations de l'avenant n° 32 du 15 mai 2023 relatif au régime de prévoyance, à la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
