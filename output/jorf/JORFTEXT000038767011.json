{
  "titre": "Arrêté du 9 juillet 2019 portant extension d'un avenant à la convention collective nationale du personnel des cabinets médicaux (n° 1147)",
  "text": {
    "executionTime": 22,
    "dereferenced": false,
    "id": "JORFTEXT000038767011_01-01-2999",
