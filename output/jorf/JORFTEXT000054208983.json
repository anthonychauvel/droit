{
  "titre": "Arrêté du 20 mai 2026 portant extension d'un avenant à la convention collective nationale de l'exploitation cinématographique (n° 1307)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000054208983_01-01-2999",
