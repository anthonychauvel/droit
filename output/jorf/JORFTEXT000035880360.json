{
  "titre": "Arrêté du 17 octobre 2017 portant extension d'un avenant à la convention collective nationale du personnel des entreprises de restauration de collectivités (n° 1266)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000035880360_01-01-2999",
