{
  "titre": "Arrêté du 5 février 2021 portant extension d'un avenant à la convention collective nationale de l'enseignement privé indépendant (n° 2691)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000043130563_01-01-2999",
