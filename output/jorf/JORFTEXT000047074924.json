    "textAbroge": false,
    "etat": null,
    "dossiersLegislatifs": [],
    "nature": "ARRETE",
    "resume": null,
    "rectificatif": null,
    "motsCles": [],
    "appellations": [],
    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000047074928",
        "cid": "JORFARTI000047074928",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000047074928",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application professionnel de la convention collective nationale de la coiffure et des professions connexes du 10 juillet 2006, les stipulations de l'avenant n° 45 du 26 octobre 2022 relatif aux rémunérations minimales et à la prime d'ancienneté, à la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
