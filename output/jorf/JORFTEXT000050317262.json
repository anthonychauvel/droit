{
  "titre": "Arrêté du 24 septembre 2024 portant extension d'avenants à la convention collective nationale de la production cinématographique (n° 3097)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000050317262_01-01-2999",
