{
  "titre": "Arrêté du 7 octobre 2019 portant extension d'un avenant à la convention collective nationale des commerces de détail non alimentaires (n° 1517)",
  "text": {
    "executionTime": 7,
    "dereferenced": false,
    "id": "JORFTEXT000039202630_01-01-2999",
