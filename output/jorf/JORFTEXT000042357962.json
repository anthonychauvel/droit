{
  "titre": "Arrêté du 18 septembre 2020 portant extension d'avenants à la convention collective nationale du sport (n° 2511)",
  "text": {
    "executionTime": 39,
    "dereferenced": false,
    "id": "JORFTEXT000042357962_01-01-2999",
