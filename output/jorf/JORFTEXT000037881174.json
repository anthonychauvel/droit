{
  "titre": "Arrêté du 27 décembre 2018 portant extension d'un avenant à la convention collective nationale des cabinets et cliniques vétérinaires (n° 1875)",
  "text": {
    "executionTime": 15,
    "dereferenced": false,
    "id": "JORFTEXT000037881174_01-01-2999",
