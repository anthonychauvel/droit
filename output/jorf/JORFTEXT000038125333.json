{
  "titre": "Arrêté du 8 février 2019 portant extension d'un avenant à la convention collective nationale des professions de la photographie (n° 3168)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000038125333_01-01-2999",
