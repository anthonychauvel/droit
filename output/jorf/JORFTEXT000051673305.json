    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000051673308",
        "cid": "JORFARTI000051673308",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000051673308",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application professionnel de la convention collective nationale des entreprises de prévention et de sécurité du 15 février 1985, les stipulations de l'avenant n° 2 du 26 novembre 2024 à l'accord du 26 septembre 2016 relatif aux qualifications professionnelles, conclu dans le cadre de la convention collective susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
