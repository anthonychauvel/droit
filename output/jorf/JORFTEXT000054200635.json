{
  "titre": "Arrêté du 20 mai 2026 portant extension d'un avenant à la convention collective nationale de l'enseignement privé indépendant (n° 2691)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000054200635_01-01-2999",
