            "content": "<p><div align=\"center\"><center><table border=\"1\"><tr><th><br/>IDCC</th><th><br/>Convention collective concernée</th><th><br/>Avenant de salaire concerné par l'extension</th><th><br/>N° du BOCC\n      <br/>\n     où l'avenant est publié</th><th><br/>Date de publication\n      <br/>\n     de l'avis au JORF</th></tr><tr><td valign=\"middle\" align=\"center\"><br/>7018</td><td valign=\"middle\" align=\"left\"><br/>Convention collective nationale des entreprises du paysage du 10 octobre 2008</td><td valign=\"middle\" align=\"center\"><br/>Avenant n° 37 du 7 septembre 2022</td><td valign=\"middle\" align=\"center\"><br/>2022/37</td><td valign=\"middle\" align=\"center\"><br/>9 octobre 2022</td></tr><tr><td valign=\"middle\" align=\"center\"><br/>7023</td><td valign=\"middle\" align=\"left\"><br/>Convention collective de travail du 5 juin 2018 concernant les entreprises agricole de déshydratation</td><td valign=\"middle\" align=\"center\"><br/>Avenant n° 6 du 7 juillet 2022</td><td valign=\"middle\" align=\"center\"><br/>2022/37</td><td valign=\"middle\" align=\"center\"><br/>9 octobre 2022</td></tr><tr><td valign=\"middle\" align=\"center\"><br/>8435</td><td valign=\"middle\" align=\"left\"><br/>Convention collective des coopératives fruitières des départements de l'Ain, du Doubs et du Jura du 29 août 2001</td><td valign=\"middle\" align=\"center\"><br/>Avenant n° 39 du 20 mai 2022</td><td valign=\"middle\" align=\"center\"><br/>2022/37</td><td valign=\"middle\" align=\"center\"><br/>9 octobre 2022</td></tr></table></center></div></p>",
