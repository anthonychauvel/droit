    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000047524438",
        "cid": "JORFARTI000047524438",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000047524438",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des grands magasins et des magasins populaires du 30 juin 2000, les stipulations de l'avenant n° 2 du 13 décembre 2022 à l'accord du 12 décembre 2019 relatif à la mise en œuvre de la reconversion et promotion par l'alternance (PRO-A), conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
