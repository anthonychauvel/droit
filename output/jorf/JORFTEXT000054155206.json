{
  "titre": "Arrêté du 27 mai 2026 portant extension d'un avenant à la convention collective nationale des personnels des structures associatives cynégétiques (n° 2697)",
  "text": {
    "executionTime": 0,
    "dereferenced": false,
    "id": "JORFTEXT000054155206_01-01-2999",
