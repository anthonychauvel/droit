    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000054155210",
        "cid": "JORFARTI000054155210",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000054155210",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des personnels des structures cynégétiques du 13 décembre 2007, les stipulations de l'avenant n° 21 du 10 mars 2026 relatif à la rémunération, à la convention collective susvisée.</p>",
        "nota": null,
