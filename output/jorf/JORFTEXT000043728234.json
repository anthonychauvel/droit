{
  "titre": "Arrêté du 11 mai 2021 fixant la journée de solidarité pour les personnels du Conseil d'Etat",
  "text": {
    "executionTime": 7,
    "dereferenced": false,
    "id": "JORFTEXT000043728234_01-01-2999",
