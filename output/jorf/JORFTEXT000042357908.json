{
  "titre": "Arrêté du 18 septembre 2020 portant extension d'un avenant à la convention collective nationale du personnel des prestataires de services dans le domaine du secteur tertiaire (n° 2098)",
  "text": {
    "executionTime": 3,
    "dereferenced": false,
    "id": "JORFTEXT000042357908_01-01-2999",
