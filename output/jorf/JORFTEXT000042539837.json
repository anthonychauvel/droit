{
  "titre": "Arrêté du 6 novembre 2020 portant extension d'un accord conclu dans le cadre de la convention collective nationale des pompes funèbres (n° 759)",
  "text": {
    "executionTime": 17,
    "dereferenced": false,
    "id": "JORFTEXT000042539837_01-01-2999",
