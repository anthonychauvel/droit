{
  "titre": "Arrêté du 10 novembre 2021 portant extension d'un avenant à la convention collective nationale du personnel des cabinets médicaux (n° 1147)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000044327847_01-01-2999",
