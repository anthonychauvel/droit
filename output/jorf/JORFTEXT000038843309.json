    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000038843312",
        "cid": "JORFARTI000038843312",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000038843312",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale de la fabrication et du commerce des produits à usage pharmaceutique, parapharmaceutique et vétérinaire du 1er juin 1989, les dispositions de l'accord du 13 novembre 2018 relatif à l'impérativité de l'article 5.1 des dispositions générales de la convention collective nationale, conclu dans le cadre de la convention collective nationale susvisée.<br/>Le sixième alinéa de l'article 2 de l'accord est étendu sous réserve du respect des dispositions de l'article 2253-2 du code du travail.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
