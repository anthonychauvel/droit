    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000046447512",
        "cid": "JORFARTI000046447512",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000046447512",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective de l'industrie des métaux du Bas-Rhin du 4 avril 1996, les stipulations de l'avenant du 20 juin 2022 à l'accord du 22 juin 1993 relatif aux rémunérations, conclu dans le cadre de la convention collective susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
