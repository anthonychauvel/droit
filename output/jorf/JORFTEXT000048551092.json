{
  "titre": "Arrêté du 30 novembre 2023 portant extension d'un avenant à la convention collective nationale de la branche télédiffusion (n° 3241)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000048551092_01-01-2999",
