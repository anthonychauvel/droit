    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000050663550",
        "cid": "JORFARTI000050663550",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000050663550",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des activités industrielles de boulangerie et pâtisserie du 13 juillet 1993 (secteurs des entrepreneurs de la boulangerie, de la viennoiserie, de la pâtisserie et des professionnels de l'œuf), les stipulations de l'accord du 23 avril 2024 relatif à la classification, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
