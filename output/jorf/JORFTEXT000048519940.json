        "cid": "JORFARTI000048519945",
        "intOrdre": 2097148,
        "etat": "VIGUEUR",
        "num": "4",
        "path": "/JORFARTI000048519945",
        "pathTitle": [],
        "content": "<p><br/>M. Philippe Renard rend régulièrement compte de sa mission au directeur de la sécurité sociale et lui remet, au terme de son mandat, un rapport sur les conditions d'exercice de son mandat d'administrateur provisoire.</p>",
        "nota": null,
