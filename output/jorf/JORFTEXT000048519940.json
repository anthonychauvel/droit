        "pathTitle": [],
        "content": "<p><br/>Le conseil d'administration de la caisse interprofessionnelle de prévoyance et d'assurance vieillesse est suspendu jusqu'au 15 juin 2024.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
