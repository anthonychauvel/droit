{
  "titre": "Arrêté du 27 février 2019 portant extension d'un avenant à la convention collective nationale de <mark>travail</mark> des entreprises du paysage (n° 7018)",
  "text": {
    "executionTime": 26,
    "dereferenced": false,
    "id": "JORFTEXT000038185430_01-01-2999",
