    "textAbroge": false,
    "etat": null,
    "dossiersLegislatifs": [],
    "nature": "ARRETE",
    "resume": null,
    "rectificatif": null,
    "motsCles": [],
    "appellations": [],
    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000044340869",
        "cid": "JORFARTI000044340869",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000044340869",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des cabinets d'experts-comptables et de commissaires aux comptes du 9 décembre 1974, tel que modifié par l'arrêté du 28 juillet 2018 portant fusion de la convention collective nationale des cabinets d'experts-comptables et de commissaires aux comptes et de la convention collective nationale des associations de gestion de la comptabilité, et dans leur propre champ professionnel, les stipulations de l'accord du 25 janvier 2021 relatif au financement de la formation professionnelle, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
