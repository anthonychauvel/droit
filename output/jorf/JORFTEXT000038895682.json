{
  "titre": "Arrêté du 24 juillet 2019 portant extension d'un avenant à la convention collective nationale de la transformation des grains (n° 1930)",
  "text": {
    "executionTime": 10,
    "dereferenced": false,
    "id": "JORFTEXT000038895682_01-01-2999",
