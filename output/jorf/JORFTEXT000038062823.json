    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000038062829",
        "cid": "JORFARTI000038062829",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000038062829",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des commerces de détail non alimentaires du 14 juin 1988, les dispositions de :</p><p><br/>- l'avenant n° 4 du 22 novembre 2017 à l'accord du 22 juin 2015 relatif à la mise en place d'un régime de complémentaire santé, conclu dans le cadre de la convention collective nationale susvisée ;<br/>- l'avenant n° 5 du 22 novembre 2017 relatif au maintien des garanties à l'accord du 22 juin 2015 relatif à la mise en œuvre d'un régime de complémentaire santé, conclu dans le cadre de la convention collective susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
