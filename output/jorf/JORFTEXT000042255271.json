{
  "titre": "Arrêté du 12 août 2020 portant extension d'un accord conclu dans le cadre de la convention collective nationale des commerces de gros (n° 573)",
  "text": {
    "executionTime": 15,
    "dereferenced": false,
    "id": "JORFTEXT000042255271_01-01-2999",
