    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000046431268",
        "cid": "JORFARTI000046431268",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000046431268",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application professionnel de la convention collective nationale des fleuristes, de la vente et des services des animaux familiers du 21 janvier 1997, les stipulations de l'accord autonome du 16 mars 2022 relatif au concours UMOF (un des meilleurs ouvriers de France) et au concours MAF (meilleurs apprentis de France) dans le secteur 3 (services aux animaux de compagnie), conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
