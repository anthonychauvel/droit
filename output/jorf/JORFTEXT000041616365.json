    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000041616369",
        "cid": "JORFARTI000041616369",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000041616369",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective des industries métallurgiques et industries connexes du Vaucluse du 20 janvier 1976, à l'exclusion de la réparation d'appareils électriques pour le ménage non associée à un magasin de vente, les stipulations de l'avenant n° 70 du 16 mai 2019 (1 annexe), à la convention collective susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
