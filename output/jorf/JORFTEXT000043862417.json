{
  "titre": "Arrêté du 5 juillet 2021 portant extension d'un avenant à la convention collective nationale de l'industrie des cuirs et peaux (n° 207)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000043862417_01-01-2999",
