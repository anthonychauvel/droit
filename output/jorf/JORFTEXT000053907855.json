{
  "titre": "Arrêté du 10 avril 2026 portant extension d'un avenant à la convention collective nationale des gardiens, concierges et employés d'immeubles (n° 1043)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000053907855_01-01-2999",
