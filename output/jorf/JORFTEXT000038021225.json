        "path": "/JORFARTI000038021228",
        "pathTitle": [],
        "content": "<p><br/>A compter du 1er février 2019 un tarif forfaitaire de responsabilité est institué pour le groupe générique mentionné ci-dessous. Le montant du tarif applicable à ce groupe générique est le suivant :</p><p><div align=\"center\"><center><table border=\"1\"><tr><th><br/>Groupe Générique</th><th><br/>Conditionnement</th><th><br/>Tarif Forfaitaire de Responsabilité (en euros)</th></tr><tr><td valign=\"middle\" align=\"left\"><br/>FLUOXETINE (CHLORHYDRATE DE) 20 mg</td><td valign=\"middle\" align=\"center\"><br/>14 gélules</td><td valign=\"middle\" align=\"center\"><br/>2,81</td></tr></table></center></div></p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
