{
  "titre": "Arrêté du 10 juillet 2020 portant extension d'un avenant à la convention collective nationale des espaces de loisirs, d'attractions et culturels (n° 1790)",
  "text": {
    "executionTime": 10,
    "dereferenced": false,
    "id": "JORFTEXT000042185791_01-01-2999",
