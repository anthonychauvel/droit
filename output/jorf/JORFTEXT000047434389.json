    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000047434393",
        "cid": "JORFARTI000047434393",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000047434393",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des taxis du 11 septembre 2001, les stipulations de l'avenant n° 1 du 7 décembre 2022 à l'accord du 11 décembre 2019 relatif au dialogue social, conclu dans le cadre de la convention collective susvisée.<br/>Le 2e alinéa de l'article 2 est étendu sous réserve du respect des <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000006901774&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L2253-1 (M)\">dispositions de l'article L. 2253-1 du code du travail</a>.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
