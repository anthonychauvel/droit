{
  "titre": "Arrêté du 13 décembre 2024 portant extension d'un avenant à un avenant à la convention collective nationale de l'optique-lunetterie de détail (n° 1431)",
  "text": {
    "executionTime": 7,
    "dereferenced": false,
    "id": "JORFTEXT000050823491_01-01-2999",
