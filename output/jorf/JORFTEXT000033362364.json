        "id": "JORFARTI000033362367",
        "cid": "JORFARTI000033362367",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000033362367",
        "pathTitle": [],
        "content": "<p><br/>Par dérogation au cinquième alinéa de l'article 1er de l'arrêté du 17 avril 2015 susvisé et à la phrase figurant à la suite du tableau n° 1 de l'annexe de cet arrêté, la limite maximale du montant d'allocation forfaitaire majoré est portée à 1 850 euros pour les demandes d'aide au retour présentées jusqu'au 31 décembre 2016.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
