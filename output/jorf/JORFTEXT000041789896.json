{
  "titre": "Arrêté du 3 avril 2020 portant extension d'un avenant à la convention collective nationale des cabinets ou entreprises d'expertises en automobile (n° 1951)",
  "text": {
    "executionTime": 89,
    "dereferenced": false,
    "id": "JORFTEXT000041789896_01-01-2999",
