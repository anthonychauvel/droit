    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000049630527",
        "cid": "JORFARTI000049630527",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000049630527",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale du sport du 7 juillet 2005, les stipulations de :</p><p><br/>- l'avenant n° 195 du 19 janvier 2024 portant sur l'annexe 1 relative aux certificats de qualification professionnelle (CQP - CQP moniteur de sports à roulettes) de la convention collective nationale susvisée ;<br/>- l'avenant n° 196 du 19 janvier 2024 portant sur l'annexe 1 relative aux certificats de qualification professionnelle (CQP - CQP technicien sportif de rugby à XV) de la convention collective nationale susvisée.</p>",
        "nota": null,
