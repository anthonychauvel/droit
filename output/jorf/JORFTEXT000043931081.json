    "jorfText": "JORF n°0186 du 12 août 2021",
    "jurisState": "Sans état juridique",
    "visa": "<p align=\"left\"><br/>La ministre du travail, de l'emploi et de l'insertion,<br/>Vu le <a href=\"/affichCode.do?cidTexte=LEGITEXT000006072050&dateTexte=29990101&categorieLien=cid\" title=\"Code du travail (V)\">code du travail</a>, notamment ses articles L. 2121-1, L. 2122-5, L. 2122-7 et L. 2122-11 ;<br/>Vu la présentation des résultats enregistrés à l'issue du cycle électoral au Haut Conseil du dialogue social le 26 mai 2021 et le 7 juillet 2021 ;<br/>Vu l'avis du Haut Conseil du dialogue social en date du 7 juillet 2021,<br/>Arrête :</p>",
    "modifDate": null,
    "jurisDate": null,
    "dateDebutVersion": "2999-01-01",
    "dateFinVersion": "2999-01-01",
    "signers": "<p align=\"left\"><br/>Fait le 5 août 2021.</p><p align=\"left\"><br/>Pour la ministre et par délégation :<br/>Le directeur général du travail,<br/>P. Ramain</p>",
    "prepWork": "",
