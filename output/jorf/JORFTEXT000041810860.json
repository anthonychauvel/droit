{
  "titre": "Arrêté du 7 avril 2020 portant extension d'un accord conclu dans le cadre de la convention collective nationale du bricolage (n° 1606)",
  "text": {
    "executionTime": 18,
    "dereferenced": false,
    "id": "JORFTEXT000041810860_01-01-2999",
