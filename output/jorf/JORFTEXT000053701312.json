    "textAbroge": false,
    "etat": null,
    "dossiersLegislatifs": [],
    "nature": "ARRETE",
    "resume": null,
    "rectificatif": null,
    "motsCles": [],
    "appellations": [],
    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000053701316",
        "cid": "JORFARTI000053701316",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000053701316",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale de travail du personnel des imprimeries de labeur et des industries graphiques du 29 mai 1956, les stipulations de l'accord paritaire du 6 janvier 2026 relatif à la politique salariale, conclu dans le cadre de la convention collective susvisée.</p>",
        "nota": null,
