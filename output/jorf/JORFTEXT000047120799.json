    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000047120802",
        "cid": "JORFARTI000047120802",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000047120802",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale du personnel des industries du cartonnage du 9 janvier 1969, tel que modifié par l'arrêté du 23 janvier 2019 susvisé, et dans leur propre champ d'application professionnel, les stipulations de l'avenant n° 1 du 26 avril 2022 à l'accord de révision de la convention collective du 17 avril 2019 conclu dans le cadre de la convention collective nationale susvisée.</p>",
