    "jorfText": "JORF n°0182 du 7 août 2025",
    "jurisState": "Sans état juridique",
    "visa": "<p align=\"left\"><br/>La ministre du travail, de la santé, des solidarités et des familles,<br/>Vu le <a href=\"/affichCode.do?cidTexte=LEGITEXT000006072050&dateTexte=29990101&categorieLien=cid\" title=\"Code du travail\">code du travail</a>, notamment ses <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000006901580&dateTexte=29990101&categorieLien=cid\" title=\"Code du travail - art. L2121-1\">articles L. 2121-1</a>, <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000019347598&dateTexte=29990101&categorieLien=cid\" title=\"Code du travail - art. L2122-5\">L. 2122-5</a>, <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000019347619&dateTexte=29990101&categorieLien=cid\" title=\"Code du travail - art. L2122-7\">L. 2122-7</a> et <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000019347748&dateTexte=29990101&categorieLien=cid\" title=\"Code du travail - art. L2122-11\">L. 2122-11</a> ;<br/>Vu la présentation des résultats enregistrés à l'issue du cycle électoral au Haut Conseil du dialogue social le 8 avril 2025 et le 12 juin 2025 ;<br/>Vu l'avis du Haut Conseil du dialogue social en date du 12 juin 2025,<br/>Arrête :</p>",
    "modifDate": null,
    "jurisDate": null,
    "dateDebutVersion": "2999-01-01",
    "dateFinVersion": "2999-01-01",
    "signers": "<p align=\"left\"><br/>Fait le 24 juin 2025.</p><p align=\"left\"><br/>Pour la ministre et par délégation :<br/>Le directeur général du travail,<br/>P. Ramain</p>",
    "prepWork": "",
    "dateParution": 1754524800000,
    "dateTexte": 1750723200000,
