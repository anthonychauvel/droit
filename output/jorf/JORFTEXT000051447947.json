            "path": "/JORFSCTA000051447964/JORFARTI000051447986",
            "pathTitle": [
              "Chapitre III : Cotisations"
            ],
            "content": "<p><br/>Les garanties complémentaires mentionnées à l'article 3 font l'objet d'une cotisation distincte de celle des garanties additionnelles mentionnées à l'article 6.</p>",
            "nota": null,
            "comporteLiens": false,
            "comporteLiensSP": false,
            "modificatorTitle": null,
            "modificatorCid": null,
            "modificatorDate": null,
            "articleVersion": "INITIALE",
            "type": "AUTONOME",
