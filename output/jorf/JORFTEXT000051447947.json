    "cid": "JORFTEXT000051447947",
    "title": "Décret n° 2025-326 du 9 avril 2025 relatif à la protection sociale complémentaire en matière de prévoyance du personnel militaire",
    "nor": "ARMH2504986D",
    "eli": "/eli/decret/2025/4/9/ARMH2504986D/jo/texte",
