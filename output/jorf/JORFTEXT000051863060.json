{
  "titre": "Arrêté du 27 juin 2025 portant extension d'un avenant à la convention collective nationale des commissaires de justice et sociétés de ventes volontaires (n° 3250)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000051863060_01-01-2999",
