        "path": "/JORFARTI000036868950",
        "pathTitle": [],
        "content": "<p><br/>Le traitement a pour objet de communiquer aux collectivités locales et aux établissements publics de coopération intercommunale concernés les informations relatives aux locaux meublés exonérés de cotisation foncière des entreprises.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
