{
  "titre": "Arrêté du 8 octobre 2026 portant extension d'un accord conclu dans le cadre de la <mark>convention</mark> collective nationale des commerces de gros (n° 573)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000054977774_01-01-2999",
