{
  "titre": "Arrêté du 21 mars 2025 portant extension d'un avenant à la convention collective nationale de la production cinématographique (n° 3097)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000051392172_01-01-2999",
