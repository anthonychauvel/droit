    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000047008469",
        "cid": "JORFARTI000047008469",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000047008469",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective des industries métallurgiques, électriques et connexes du Var du 17 mars 1978, mise à jour le 30 juin 1987, les stipulations de l'avenant du 26 septembre 2022 relatif aux taux effectifs garantis annuels (TEGA) et aux rémunérations minimales hiérarchiques (RMH), à la convention collective susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
