    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000042539621",
        "cid": "JORFARTI000042539621",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000042539621",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale de l'industrie pharmaceutique du 6 avril 1956, les stipulations de l'accord du 21 novembre 2019 relatif à l'emploi des personnes en situation de handicap, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
