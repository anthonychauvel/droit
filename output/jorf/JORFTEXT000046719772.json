    "textAbroge": false,
    "etat": null,
    "dossiersLegislatifs": [],
    "nature": "ARRETE",
    "resume": null,
    "rectificatif": null,
    "motsCles": [],
    "appellations": [],
    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000046719776",
        "cid": "JORFARTI000046719776",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000046719776",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective des industries métallurgiques, électriques, électroniques et connexes du département des Vosges du 16 mars 1998, les stipulations de l'accord du 23 septembre 2022 relatif aux rémunérations, conclu dans le cadre de la convention collective susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
