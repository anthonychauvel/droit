{
  "titre": "Arrêté du 20 mai 2020 portant extension d'un avenant à la convention collective nationale des 5 branches des industries alimentaires diverses (n° 3109)",
  "text": {
    "executionTime": 9,
    "dereferenced": false,
    "id": "JORFTEXT000041946877_01-01-2999",
