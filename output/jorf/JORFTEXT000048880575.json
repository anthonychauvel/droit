    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000048880579",
        "cid": "JORFARTI000048880579",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000048880579",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, conformément aux <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006073189&idArticle=LEGIARTI000006745509&dateTexte=&categorieLien=cid\" title=\"Code de la sécurité sociale. - art. L921-4 (M)\">dispositions de l'article L. 921-4 du code de la sécurité sociale</a>, pour tous les employeurs et tous les salariés, anciens salariés et leurs ayants droits compris dans son champ d'application, les stipulations de l'accord national interprofessionnel sur la retraite complémentaire AGIRC-ARRCO, conclu le 5 octobre 2023.</p>",
        "nota": null,
