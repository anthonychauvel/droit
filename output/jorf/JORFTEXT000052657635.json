    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000052657638",
        "cid": "JORFARTI000052657638",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000052657638",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des remontées mécaniques et domaines skiables du 15 mai 1968, les stipulations de l'avenant n° 85 du 18 juin 2025 relatif à la reformulation de l'article 2.11, à la convention collective nationale susvisée.</p>",
        "nota": null,
