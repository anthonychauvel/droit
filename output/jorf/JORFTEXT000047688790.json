{
  "titre": "Arrêté du 17 avril 2023 relatif à l'extension et l'élargissement de l'avenant n° 14 du 13 décembre 2022 à l'accord national interprofessionnel du 17 novembre 2017",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000047688790_01-01-2999",
