    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000047688796",
        "cid": "JORFARTI000047688796",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000047688796",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires pour tous les employeurs et tous les salariés, anciens salariés et leurs ayants droits compris dans son champ d'application, les stipulations de l'avenant n° 14 à l'accord national interprofessionnel du 17 novembre 2017 instituant le régime AGIRC-ARRCO de retraite complémentaire, conclu le 13 décembre 2022.</p>",
