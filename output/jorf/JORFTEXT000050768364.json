    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000050768367",
        "cid": "JORFARTI000050768367",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000050768367",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des vins, cidres, jus de fruits, sirops, spiritueux et liqueurs de France du 13 février 1969, les stipulations de l'avenant n° 1 du 29 mars 2024 à l'accord du 9 octobre 2020 relatif à un régime de prévoyance, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
