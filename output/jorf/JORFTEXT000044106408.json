{
  "titre": "Arrêté du 17 septembre 2021 portant extension d'un accord conclu dans le cadre de la convention collective nationale du bricolage (n° 1606)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000044106408_01-01-2999",
