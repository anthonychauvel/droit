{
  "titre": "Arrêté du 16 décembre 2024 portant extension d'un avenant à la convention collective nationale du sport (n° 2511)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000050831278_01-01-2999",
