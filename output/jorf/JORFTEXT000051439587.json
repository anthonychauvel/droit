{
  "titre": "Arrêté du 21 mars 2025 portant extension d'avenants à la convention collective nationale des cabinets dentaires (n° 1619)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000051439587_01-01-2999",
