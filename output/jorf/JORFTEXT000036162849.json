{
  "titre": "Arrêté du 28 novembre 2017 portant extension d'un avenant à la convention collective nationale du commerce de détail et de gros à prédominance alimentaire (n° 2216)",
  "text": {
    "executionTime": 7,
    "dereferenced": false,
    "id": "JORFTEXT000036162849_01-01-2999",
