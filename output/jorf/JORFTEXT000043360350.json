    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000043360353",
        "cid": "JORFARTI000043360353",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000043360353",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale du négoce et des prestations de services dans les domaines médico-techniques du 9 avril 1997 telle qu'étendue par l'arrêté du 3 mars 1998, les stipulations de l'accord du 12 mars 2020 portant règlement intérieur de la Commission paritaire permanente de négociation et d'interprétation, conclu dans le cadre de la convention collective nationale susvisée.<br/>Le 1er alinéa de l'article 5 est étendu sous réserve du respect des <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000006901785&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L2261-7 (V)\">dispositions de l'article L. 2261-7 du code du travail</a>.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
