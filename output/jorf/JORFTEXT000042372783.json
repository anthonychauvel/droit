{
  "titre": "Arrêté du 18 septembre 2020 portant extension d'un accord conclu dans le cadre de la convention collective nationale des entreprises d'architecture (n° 2332)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000042372783_01-01-2999",
