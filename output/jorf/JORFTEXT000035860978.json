{
  "titre": "Arrêté du 12 octobre 2017 portant extension d'un accord conclu dans le cadre de la convention collective des industries métallurgiques, mécaniques et connexes de l'Aisne (n° 2542)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000035860978_01-01-2999",
