{
  "titre": "Arrêté du 6 février 2025 portant extension d'un avenant à la convention collective nationale des entreprises artistiques et culturelles (n° 1285)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000051207441_01-01-2999",
