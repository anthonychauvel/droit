        "notaSectionsAafficher": null,
        "multipleVersions": true
      },
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000052001102",
        "cid": "JORFARTI000052001102",
        "intOrdre": 3670009,
        "etat": "VIGUEUR",
        "num": "7",
        "path": "/JORFARTI000052001102",
        "pathTitle": [],
        "content": "<p><br/>Les dispositions du présent arrêté entrent en vigueur à compter du 1<sup>er</sup> janvier 2026.</p>",
