    "appellations": [],
    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000054208977",
        "cid": "JORFARTI000054208977",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000054208977",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale du sport du 7 juillet 2005, les stipulations de l'avenant n° 216 du 20 novembre 2025 relatif au dialogue social, à la convention collective nationale susvisée.</p>",
