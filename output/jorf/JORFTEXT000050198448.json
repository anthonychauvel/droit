    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000050198452",
        "cid": "JORFARTI000050198452",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000050198452",
        "pathTitle": [],
        "content": "<p><br/>Les dispositions de l'avenant n° 2 du 19 janvier 2024 à l'accord départemental de prévoyance du 22 septembre 2009 des salariés non cadres des exploitations agricoles du Cantal sont rendues obligatoires pour tous les employeurs et tous les salariés compris dans le champ d'application professionnel et territorial dudit accord sous les réserves et l'exclusion suivantes :<br/>1° L'article 4 de l'avenant est étendu sous réserve de l'application des stipulations de l'accord national interprofessionnel du 17 novembre 2017 instituant le régime AGIRC-ARRCO de retraite complémentaire et de l'accord national interprofessionnel du 17 novembre 2017 relatif à la prévoyance des cadres, étendus par arrêtés du 24 avril et du 27 juillet 2018 ;<br/>2° Le terme « adhérente » à l'article 5 de l'avenant est exclu de l'extension en ce qu'il contrevient aux dispositions de l'<a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000006901793&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L2261-15\">article L. 2261-15 du code du travail</a>.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
