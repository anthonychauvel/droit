{
  "titre": "Arrêté du 29 août 2017 portant extension d'un avenant à la convention collective nationale de <mark>travail</mark> des entreprises du paysage",
  "text": {
    "executionTime": 15,
    "dereferenced": false,
    "id": "JORFTEXT000035526520_01-01-2999",
