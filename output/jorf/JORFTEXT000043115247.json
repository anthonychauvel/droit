{
  "titre": "Arrêté du 5 février 2021 portant extension d'un avenant à l'annexe de la convention collective nationale de l'hospitalisation privée (n° 2264)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000043115247_01-01-2999",
