{
  "titre": "Arrêté du 5 mars 2025 portant extension d'un avenant à la convention collective nationale des cinq branches des industries alimentaires diverses (n° 3109)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000051363956_01-01-2999",
