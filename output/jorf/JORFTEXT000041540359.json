{
  "titre": "Arrêté du 31 janvier 2020 portant extension d'un avenant à la convention collective nationale du tourisme social et familial (n° 1316)",
  "text": {
    "executionTime": 9,
    "dereferenced": false,
    "id": "JORFTEXT000041540359_01-01-2999",
