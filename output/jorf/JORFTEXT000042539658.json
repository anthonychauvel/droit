{
  "titre": "Arrêté du 6 novembre 2020 portant extension d'un avenant à un avenant à la convention collective nationale de la restauration rapide (n° 1501)",
  "text": {
    "executionTime": 8,
    "dereferenced": false,
    "id": "JORFTEXT000042539658_01-01-2999",
