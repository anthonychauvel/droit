{
  "titre": "Arrêté du 6 septembre 2019 portant extension d'un avenant à la convention collective nationale des gardiens, concierges et employés d'immeubles (n° 1043)",
  "text": {
    "executionTime": 7,
    "dereferenced": false,
    "id": "JORFTEXT000039080017_01-01-2999",
