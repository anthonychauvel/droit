    "jorfText": "JORF n°0016 du 19 janvier 2017",
    "jurisState": "Sans état juridique",
    "visa": "<p align=\"left\"><br/>Le garde des sceaux, ministre de la justice,<br/>Vu le <a href=\"/affichCode.do?cidTexte=LEGITEXT000006072050&dateTexte=29990101&categorieLien=cid\" title=\"Code du travail (V)\">code du travail</a> ;<br/>Vu la <a href=\"/affichTexte.do?cidTexte=JORFTEXT000000504704&categorieLien=cid\" title=\"Loi n° 83-634 du 13 juillet 1983 (V)\">loi n° 83-634 du 13 juillet 1983</a> modifiée portant droits et obligations des fonctionnaires, ensemble la <a href=\"/affichTexte.do?cidTexte=JORFTEXT000000501099&categorieLien=cid\" title=\"Loi n° 84-16 du 11 janvier 1984 (V)\">loi n° 84-16 du 11 janvier 1984</a> modifiée portant dispositions statutaires relatives à la fonction publique de l'Etat ;<br/>Vu le <a href=\"/affichTexte.do?cidTexte=JORFTEXT000000519520&categorieLien=cid\" title=\"Décret n°82-453 du 28 mai 1982 (V)\">décret n° 82-453 du 28 mai 1982</a> modifié relatif à l'hygiène et à la sécurité du travail ainsi qu'à la prévention médicale dans la fonction publique ;<br/>Vu le <a href=\"/affichTexte.do?cidTexte=JORFTEXT000023592572&categorieLien=cid\" title=\"Décret n°2011-184 du 15 février 2011 (V)\">décret n° 2011-184 du 15 février 2011</a> modifié relatif aux comités techniques dans les administrations et les établissements publics de l'Etat ;<br/>Vu l'arrêté du 10 juillet 2014 portant création de comités d'hygiène, de sécurité et des conditions de travail au sein du ministère de la justice ;<br/>Vu l'avis du comité technique ministériel en date du 16 décembre 2016,<br/>Arrête :</p>",
    "modifDate": null,
    "jurisDate": null,
    "dateDebutVersion": "2999-01-01",
    "dateFinVersion": "2999-01-01",
    "signers": "<p align=\"left\"><br/>Fait le 11 janvier 2017.</p><p align=\"left\"><br/>Pour le ministre et par délégation :<br/>Le secrétaire général,<br/>S. Verclytte</p>",
    "prepWork": "",
    "dateParution": 1484784000000,
    "dateTexte": 1484092800000,
    "numParution": "0016",
    "notice": "",
    "nota": "",
    "inap": false,
    "textNumber": "23",
    "textAbroge": false,
    "etat": null,
    "dossiersLegislatifs": [],
    "nature": "ARRETE",
    "resume": null,
    "rectificatif": null,
    "motsCles": [],
    "appellations": [],
