    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000051862992",
        "cid": "JORFARTI000051862992",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000051862992",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale du sport du 7 juillet 2005, les stipulations de l'accord du 12 décembre 2024 relatif à la création du titre à finalité professionnelle Technicien territorial de basketball, conclu dans le cadre de la convention collective nationale susvisée.</p>",
