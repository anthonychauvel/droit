{
  "titre": "Arrêté du 21 août 2017 portant extension d'un accord conclu dans le cadre de la convention collective nationale des industries du camping (n° 1618)",
  "text": {
    "executionTime": 46,
    "dereferenced": false,
    "id": "JORFTEXT000035531868_01-01-2999",
