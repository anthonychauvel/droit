{
  "titre": "Arrêté du 26 décembre 2017 portant extension d'un avenant à la convention collective nationale du sport (n° 2511)",
  "text": {
    "executionTime": 24,
    "dereferenced": false,
    "id": "JORFTEXT000036338411_01-01-2999",
