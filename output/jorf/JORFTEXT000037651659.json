{
  "titre": "Arrêté du 21 novembre 2018 portant extension d'un avenant à la convention collective nationale du personnel des huissiers de justice (n° 1921)",
  "text": {
    "executionTime": 13,
    "dereferenced": false,
    "id": "JORFTEXT000037651659_01-01-2999",
