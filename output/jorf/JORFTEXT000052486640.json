{
  "titre": "Arrêté du 30 octobre 2025 portant extension d'un avenant à la convention collective nationale de l'habitat et du logement accompagnés (n° 2336)",
  "text": {
    "executionTime": 13,
    "dereferenced": false,
    "id": "JORFTEXT000052486640_01-01-2999",
