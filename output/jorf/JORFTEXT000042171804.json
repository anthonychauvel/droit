{
  "titre": "Arrêté du 10 juillet 2020 portant extension d'un avenant à la convention collective nationale des organismes de formation (n° 1516)",
  "text": {
    "executionTime": 11,
    "dereferenced": false,
    "id": "JORFTEXT000042171804_01-01-2999",
