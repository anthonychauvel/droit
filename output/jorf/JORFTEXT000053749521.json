{
  "titre": "Arrêté du 18 mars 2026 portant extension d'un avenant à la convention collective nationale des cinq branches des industries alimentaires diverses (n° 3109)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000053749521_01-01-2999",
