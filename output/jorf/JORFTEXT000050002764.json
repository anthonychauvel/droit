{
  "titre": "Arrêté du 11 juillet 2024 portant extension d'un accord dans la branche professionnelle des industries électriques et gazières",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000050002764_01-01-2999",
