    "dateFinVersion": "2999-01-01",
    "signers": "<p align=\"left\"><br/>Fait le 13 décembre 2021.</p><p align=\"left\"><br/>Pour la ministre et par délégation :<br/>Le directeur général du travail,<br/>P. Ramain</p>",
    "prepWork": "",
