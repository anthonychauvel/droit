{
  "titre": "Arrêté du 17 octobre 2017 portant extension d'un avenant à un accord conclu dans le cadre de la convention collective nationale des professions de la photographie (n° 3168)",
  "text": {
    "executionTime": 15,
    "dereferenced": false,
    "id": "JORFTEXT000035880341_01-01-2999",
