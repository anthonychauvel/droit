            "infosRestructurationBranche": null,
            "infosRestructurationBrancheHtml": null,
            "dateDebut": 32472144000000,
            "dateFin": 32472144000000,
            "notaSectionsAafficher": null,
            "multipleVersions": false
          },
          {
            "executionTime": 0,
            "dereferenced": false,
            "id": "JORFARTI000047524646",
            "cid": "JORFARTI000047524646",
            "intOrdre": 1048574,
            "etat": "VIGUEUR",
            "num": "1",
            "path": "/JORFSCTA000047524640/JORFARTI000047524646",
            "pathTitle": [
              "Annexe"
            ],
            "content": "<p><br/>Les traitements-types conventionnés de l'établissement thermal de Nancy sont modifiés au titre de la Commission paritaire nationale du 15 juin 2022. Leur nouvelle composition est fixée par l'annexe 1 au présent avenant.</p>",
            "nota": null,
            "comporteLiens": false,
            "comporteLiensSP": false,
            "modificatorTitle": null,
            "modificatorCid": null,
            "modificatorDate": null,
            "articleVersion": "INITIALE",
            "type": "AUTONOME",
            "lstLienModification": [],
            "lstLienCitation": [],
            "conditionDiffere": null,
            "historique": null,
            "surtitre": null,
            "renvoi": null,
            "versionLabel": null,
            "infosComplementaires": null,
            "infosComplementairesHtml": null,
            "infosRestructurationBranche": null,
            "infosRestructurationBrancheHtml": null,
            "dateDebut": 32472144000000,
            "dateFin": 32472144000000,
            "notaSectionsAafficher": null,
            "multipleVersions": false
          },
          {
            "executionTime": 0,
            "dereferenced": false,
            "id": "JORFARTI000047524647",
            "cid": "JORFARTI000047524647",
            "intOrdre": 1572861,
            "etat": "VIGUEUR",
            "num": "2",
            "path": "/JORFSCTA000047524640/JORFARTI000047524647",
            "pathTitle": [
              "Annexe"
            ],
            "content": "<p><br/>Les tarifs appliqués en 2023 sont fixés conformément aux annexes 2 et 3 du présent avenant. Ils sont applicables à compter du 1er mars 2023 à l'ensemble des établissements thermaux inscrits à la nomenclature générale des actes et prestations remboursables par l'assurance maladie (titre XV, chapitre IV, article 4). Si leur publication au Journal officiel n'a pu avoir lieu avant cette date, ils sont applicables à compter du lendemain de cette publication.</p>",
            "nota": null,
            "comporteLiens": false,
            "comporteLiensSP": false,
            "modificatorTitle": null,
            "modificatorCid": null,
