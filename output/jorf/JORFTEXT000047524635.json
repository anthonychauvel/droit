            "path": "/JORFSCTA000047524640/JORFARTI000047524644",
            "pathTitle": [
              "Annexe"
            ],
            "content": "<p><br/><p> <br/><a href=\"/affichTexte.do?cidTexte=JORFTEXT000033165938&categorieLien=cid\" title=\"Avenant n°7 du 14 septembre 2016, v. init.\">ANNEXEAVENANT NO 7</a> À LA CONVENTION NATIONALE DESTINÉE À ORGANISER LES RAPPORTS ENTRE LES CAISSES D'ASSURANCE MALADIE ET LES ÉTABLISSEMENTS THERMAUX</p><p><br/>Entre, d'une part :<br/>L'Union nationale des caisses d'assurance maladie, représentée par Thomas FATOME, directeur général,<br/>Et, d'autre part :<br/>Le Conseil national des établissements thermaux (CNETh), représenté par Thierry DUBOIS, président.<br/>Vu les demandes de modification de traitements-types soumises à l'examen de la Commission paritaire nationale au titre de l'année 2022 ;<br/>Vu l'avis formulé par la Commission paritaire nationale réunie le 15 juin 2022,<br/>Il est convenu et exposé ce qui suit :</p>",
            "nota": null,
            "comporteLiens": true,
            "comporteLiensSP": false,
            "modificatorTitle": null,
            "modificatorCid": null,
            "modificatorDate": null,
            "articleVersion": "INITIALE",
            "type": "AUTONOME",
            "lstLienModification": [],
            "lstLienCitation": [],
            "conditionDiffere": null,
            "historique": null,
            "surtitre": null,
            "renvoi": null,
            "versionLabel": null,
