{
  "titre": "Arrêté du 1er juillet 2026 portant extension d'un avenant à la convention collective nationale des opérateurs de voyages et des guides (n° 3245)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000054408776_01-01-2999",
