    "jurisState": "Sans état juridique",
    "visa": "<p align=\"left\"><br/>Le ministre de l'intérieur et des outre-mer,<br/>Vu le <a href=\"/affichCode.do?cidTexte=LEGITEXT000006074228&dateTexte=29990101&categorieLien=cid\" title=\"Code de la route.\">code de la route</a>, notamment ses <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006074228&idArticle=LEGIARTI000006841017&dateTexte=29990101&categorieLien=cid\" title=\"Code de la route. - art. L225-5\">articles L. 225-5</a>, <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006074228&idArticle=LEGIARTI000006841503&dateTexte=29990101&categorieLien=cid\" title=\"Code de la route. - art. R225-5\">R. 225-5</a>, <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006074228&idArticle=LEGIARTI000037408280&dateTexte=29990101&categorieLien=cid\" title=\"Code de la route. - art. R225-5-1\">R. 225-5-1</a> et son <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006074228&idArticle=LEGIARTI000044619580&dateTexte=29990101&categorieLien=cid\" title=\"Code de la route. - art. R225-5-2\">article R. 225-5-2</a>,<br/>Arrête :</p>",
    "modifDate": null,
    "jurisDate": null,
