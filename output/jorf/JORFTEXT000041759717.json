{
  "titre": "Arrêté du 19 mars 2020 portant extension d'un avenant à la convention collective nationale de l'exploitation cinématographique (n° 1307)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000041759717_01-01-2999",
