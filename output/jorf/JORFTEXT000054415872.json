{
  "titre": "Arrêté du 3 juillet 2026 portant extension d'un avenant à la convention collective nationale des télécommunications (n° 2148)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000054415872_01-01-2999",
