    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000045874052",
        "cid": "JORFARTI000045874052",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000045874052",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des entreprises d'expédition et d'exportation de fruits et légumes du 17 décembre 1985, les stipulations de l'accord collectif du 10 février 2022 d'activité Partielle de Longue Durée (APLD), à l'exclusion de ses annexes, conclu dans le cadre de la convention collective susvisée.<br/>Le 2e alinéa de l'article 4.3 est étendu sous réserve du respect des dispositions du <a href=\"/affichTexte.do?cidTexte=JORFTEXT000045653593&categorieLien=cid\" title=\"Décret n°2022-654 du 25 avril 2022 (V)\">décret n° 2022-654 du 25 avril 2022</a>, et de l'<a href=\"/affichTexteArticle.do?cidTexte=JORFTEXT000042169955&idArticle=JORFARTI000042169973&categorieLien=cid\" title=\"Décret n°2020-926 du 28 juillet 2020 - art. 7 (M)\">article 7 du décret n° 2020-926 du 28 juillet 2020</a> relatif au dispositif spécifique d'activité partielle en cas de réduction d'activité durable.</p>",
        "nota": null,
        "comporteLiens": true,
