{
  "titre": "Arrêté du 14 décembre 2022 portant extension d'un accord conclu dans le cadre de la convention collective nationale de l'exploitation cinématographique (n° 1307)",
  "text": {
    "executionTime": 19,
    "dereferenced": false,
    "id": "JORFTEXT000046781020_01-01-2999",
