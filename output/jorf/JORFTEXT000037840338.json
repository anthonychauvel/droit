{
  "titre": "Arrêté du 14 décembre 2018 portant extension d'un avenant à la convention collective nationale des mareyeurs-expéditeurs (n° 1589)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000037840338_01-01-2999",
