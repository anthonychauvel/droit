    "textAbroge": false,
    "etat": null,
    "dossiersLegislatifs": [],
    "nature": "ARRETE",
    "resume": null,
    "rectificatif": null,
    "motsCles": [],
    "appellations": [],
    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000044127341",
        "cid": "JORFARTI000044127341",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000044127341",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale du commerce des articles de sport et équipements de loisirs tel que modifié par l'arrêté du 15 février 2019 susvisé, et dans leur propre champ d'application professionnel, les stipulations de l'avenant n° 3 du 1er octobre 2020 à l'accord du 12 mai 2005 portant création du certificat de qualification professionnelle « préparateur/réparateur de véhicules de loisirs », conclu dans la cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
