    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000048642536",
        "cid": "JORFARTI000048642536",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000048642536",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des organismes de tourisme du 5 février 1996, les stipulations de l'accord de branche n° 39 du 4 mai 2023 relatif aux classifications, conclu dans le cadre de la convention collective nationale susvisée.</p>",
