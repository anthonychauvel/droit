    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000045946519",
        "cid": "JORFARTI000045946519",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000045946519",
        "pathTitle": [],
        "content": "<p><br/>Sont étendues, conformément aux <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006073189&idArticle=LEGIARTI000006745466&dateTexte=&categorieLien=cid\" title=\"Code de la sécurité sociale. - art. L911-3 (V)\">dispositions de l'article L. 911-3 du code de la sécurité sociale</a>, les stipulations de l'avenant n° 2 à l'accord du 16 novembre 2018 relatif aux garanties prévoyance des salariés intérimaires non-cadres et cadres, conclu le 26 mars 2021.<br/>Cette extension a pour effet de rendre les stipulations de cet avenant obligatoires pour tous les salariés, anciens salariés et leurs ayants droit et pour tous les employeurs compris dans son champ d'application.</p>",
        "nota": null,
