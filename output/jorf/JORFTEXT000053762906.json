{
  "titre": "Arrêté du 26 mars 2026 portant extension d'un avenant à la convention collective nationale des commerces de détail non alimentaires (n° 1517)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000053762906_01-01-2999",
