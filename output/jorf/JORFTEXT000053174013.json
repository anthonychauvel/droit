    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000053174019",
        "cid": "JORFARTI000053174019",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000053174019",
        "pathTitle": [],
        "content": "<p><br/>En cas de rappel sur astreinte des personnels relevant de la direction générale de la police nationale, de la direction générale de la sécurité intérieure ou placés sous l'autorité du préfet de police, le temps de trajet aller-retour entre le lieu de résidence de l'agent et le lieu d'intervention est pris en compte forfaitairement à hauteur d'une heure.</p>",
        "nota": null,
        "comporteLiens": false,
