{
  "titre": "Arrêté du 25 janvier 2021 portant extension d'un accord conclu dans le cadre de la convention collective nationale des cabinets dentaires (n° 1619)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000043090944_01-01-2999",
