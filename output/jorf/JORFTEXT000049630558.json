    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000049630561",
        "cid": "JORFARTI000049630561",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000049630561",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application professionnel de la convention collective nationale des entreprises de prévention et de sécurité du 15 février 1985, les stipulations de l'avenant n° 4 du 6 décembre 2023 à l'accord du 14 décembre 2017 relatif au financement des formations, conclu dans le cadre de la convention collective susvisée.<br/>L'alinéa 2 de l'article 8 est étendu sous réserve du strict respect des dispositions de l'<a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000006901785&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L2261-7\">article L. 2261-7 du code du travail</a> aux termes desquelles à l'issue du cycle électoral au cours duquel l'accord est conclu, l'engagement de la révision est ouvert à l'ensemble des organisations représentatives dans son champ d'application.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
