{
  "titre": "Arrêté du 18 septembre 2020 portant extension d'un avenant à la convention collective nationale de la pâtisserie (n° 1267)",
  "text": {
    "executionTime": 12,
    "dereferenced": false,
    "id": "JORFTEXT000042360907_01-01-2999",
