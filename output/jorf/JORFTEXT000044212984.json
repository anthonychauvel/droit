{
  "titre": "Arrêté du 4 octobre 2021 portant extension d'un avenant à un accord conclu dans le cadre de la convention collective nationale de la librairie (n° 3013)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000044212984_01-01-2999",
