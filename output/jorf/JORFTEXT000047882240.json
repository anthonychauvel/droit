    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000047882243",
        "cid": "JORFARTI000047882243",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000047882243",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application professionnel de la convention collective nationale de la coiffure et des professions connexes du 10 juillet 2006, les stipulations de l'avenant n° 6 du 20 avril 2023 à l'avenant n° 11 du 16 avril 2008 relatif au régime frais de santé, à la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
