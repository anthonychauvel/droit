    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000048560762",
        "cid": "JORFARTI000048560762",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000048560762",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective de la métallurgie des Deux-Sèvres du 1er juillet 1991, les stipulations de l'avenant du 5 juin 2023 relatif aux taux effectifs garantis annuels et à la valeur du point, à la convention collective susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
