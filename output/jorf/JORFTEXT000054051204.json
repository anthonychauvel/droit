{
  "titre": "Arrêté du 4 mai 2026 portant extension d'un avenant à la convention collective nationale des coopératives de consommateurs salariés (n° 3205)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000054051204_01-01-2999",
