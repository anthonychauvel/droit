    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000053762891",
        "cid": "JORFARTI000053762891",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000053762891",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des industries de carrières et matériaux de construction applicable aux ouvriers, employés, techniciens, agents de maîtrise et aux cadres du 6 juillet 2022, tel que modifié par l'arrêté du 3 juillet 2024 susvisé portant fusion des champs conventionnels, et dans leur propre champ d'application professionnel, les stipulations de l'avenant n° 2 du 27 novembre 2025 visant à apporter des précisions rédactionnelles, à la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
