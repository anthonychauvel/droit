    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000038930282",
        "cid": "JORFARTI000038930282",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000038930282",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des cadres, ingénieurs et assimilés des entreprises de gestion d'équipements thermiques et de climatisation du 3 mai 1983, les dispositions de l'accord du 20 décembre 2018 relatif au contrat de chantier ou d'opération, conclu dans le cadre de la convention collective susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
