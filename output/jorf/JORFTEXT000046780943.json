{
  "titre": "Arrêté du 12 décembre 2022 portant extension d'un avenant à la convention collective nationale du rouissage-teillage de lin (n° 1659)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000046780943_01-01-2999",
