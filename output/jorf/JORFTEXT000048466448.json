{
  "titre": "Arrêté du 10 novembre 2023 portant extension d'un avenant à la convention collective nationale du notariat (n° 2205)",
  "text": {
    "executionTime": 15,
    "dereferenced": false,
    "id": "JORFTEXT000048466448_01-01-2999",
