    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000045155700",
        "cid": "JORFARTI000045155700",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000045155700",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale de l'habitat et du logement accompagnés du 16 juillet 2003 tel que modifié par l'arrêté du 1er août 2019, les stipulations de l'avenant n° 55 du 1er avril 2021 relatif au droit syndical national, à la convention collective nationale susvisée.</p>",
        "nota": null,
