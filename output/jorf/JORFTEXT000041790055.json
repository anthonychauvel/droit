    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000041790058",
        "cid": "JORFARTI000041790058",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000041790058",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés du commerce de gros de la poissonnerie, les dispositions de l'avenant n° 95 du 12 décembre 2018 relatif à l'amélioration du régime de santé et à l'action sociale, à la convention collective nationale de la poissonnerie, tel qu'étendu par arrêté du 30 octobre 2019 publié au Journal officiel du 5 novembre 2019.</p>",
        "nota": null,
