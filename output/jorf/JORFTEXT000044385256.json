{
  "titre": "Arrêté du 16 novembre 2021 portant extension d'un avenant à la convention collective des industries de la métallurgie de Haute-Saône (n° 3053)",
  "text": {
    "executionTime": 6,
    "dereferenced": false,
    "id": "JORFTEXT000044385256_01-01-2999",
