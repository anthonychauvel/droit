{
  "titre": "Arrêté du 16 février 2026 portant extension d'un avenant à la convention collective nationale du tourisme social et familial (n° 1316)",
  "text": {
    "executionTime": 12,
    "dereferenced": false,
    "id": "JORFTEXT000053555505_01-01-2999",
