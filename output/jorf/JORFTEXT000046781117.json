    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000046781120",
        "cid": "JORFARTI000046781120",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000046781120",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des services de l'automobile du 15 janvier 1981, les stipulations de l'accord paritaire national du 12 mai 2022 relatif à la gestion prévisionnelle de l'emploi et des compétences (GPEC), conclu dans le cadre de la convention collective susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
