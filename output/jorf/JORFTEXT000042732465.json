{
  "titre": "Arrêté du 18 décembre 2020 portant extension d'un avenant à la convention collective nationale de branche des salariés en portage salarial n° 3219)",
  "text": {
    "executionTime": 14,
    "dereferenced": false,
    "id": "JORFTEXT000042732465_01-01-2999",
