    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000048099457",
        "cid": "JORFARTI000048099457",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000048099457",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des fleuristes, de la vente et des services des animaux familiers du 31 janvier 1997, les stipulations de l'accord du 20 juin 2023 relatif à la grille de salaires minima, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
