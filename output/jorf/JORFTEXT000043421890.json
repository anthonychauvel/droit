    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000043421894",
        "cid": "JORFARTI000043421894",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000043421894",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des services de l'automobile du 15 janvier 1981, les stipulations de l'avenant n° 97 du 19 janvier 2021 relatif aux salaires minima, à la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
