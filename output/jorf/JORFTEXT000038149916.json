{
  "titre": "Arrêté du 13 février 2019 portant extension d'un accord conclu dans le cadre de la convention collective nationale de la plasturgie (n° 292)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000038149916_01-01-2999",
