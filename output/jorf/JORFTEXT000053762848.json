    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000053762851",
        "cid": "JORFARTI000053762851",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000053762851",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application professionnel de la convention collective nationale de travail des industries de la maroquinerie, articles de voyage, chasse sellerie, gainerie, bracelets en cuir du 9 septembre 2005, et dans leur propre champ d'application (secteur de la maroquinerie et secteur des cuirs et peaux), les stipulations de l'accord du 8 décembre 2025 portant sur la mise en œuvre de mesures urgentes en faveur de l'emploi et de la formation professionnelle, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
