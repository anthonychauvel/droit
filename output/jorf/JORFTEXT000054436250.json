      },
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000054436259",
        "cid": "JORFARTI000054436259",
        "intOrdre": 1572861,
        "etat": "VIGUEUR",
        "num": "3",
        "path": "/JORFARTI000054436259",
        "pathTitle": [],
        "content": "<p><br/>La Caisse des dépôts et consignations procède à trois versements aux dates suivantes :<br/>1° A partir du 1<sup>er</sup> septembre 2026 pour les fonds répartis par les employeurs pendant la période mentionnée au 1° de l'article 1<sup>er</sup> ;<br/>2° A partir du 5 novembre 2026 pour les fonds répartis par les employeurs pendant la période mentionnée au 2° de l'article 1<sup>er</sup> ;<br/>3° A partir du 26 novembre 2026 pour les fonds affectés aux établissements bénéficiaires selon les modalités prévues à l'<a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000029414405&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. R6241-28\">article R. 6241-28 du code du travail</a>.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
        "type": "AUTONOME",
