    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000054436255",
        "cid": "JORFARTI000054436255",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000054436255",
        "pathTitle": [],
        "content": "<p><br/>Les employeurs peuvent désigner des établissements bénéficiaires du solde de la taxe d'apprentissage au moyen du service dématérialisé mentionné au 1° du II de l'<a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000006904090&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L6241-2\">article L. 6241-2 du code du travail</a> pendant les deux périodes suivantes :<br/>1° Du 26 mai au 21 août 2026 inclus ;<br/>2° Du 3 septembre au 21 octobre 2026 inclus.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
        "type": "AUTONOME",
        "lstLienModification": [],
        "lstLienCitation": [],
        "conditionDiffere": null,
        "historique": null,
        "surtitre": null,
        "renvoi": null,
        "versionLabel": null,
        "infosComplementaires": null,
        "infosComplementairesHtml": null,
        "infosRestructurationBranche": null,
        "infosRestructurationBrancheHtml": null,
        "dateDebut": 32472144000000,
        "dateFin": 32472144000000,
        "notaSectionsAafficher": null,
        "multipleVersions": true
      },
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000054436257",
        "cid": "JORFARTI000054436257",
        "intOrdre": 1048574,
        "etat": "VIGUEUR",
        "num": "2",
        "path": "/JORFARTI000054436257",
        "pathTitle": [],
        "content": "<p><br/>Les employeurs qui ont validé leurs choix de désignation et de répartition pendant la période mentionnée au 1° de l'article 1<sup>er</sup> pour la totalité des fonds à leur disposition ne peuvent plus modifier ces choix après la fin de cette période. La Caisse des dépôts et consignations effectue les versements correspondant à ces choix à la date mentionnée au 1° de l'article 3.<br/>Les employeurs qui n'ont pas validé leurs choix de désignation et de répartition pour la totalité des fonds à leur disposition à l'issue de la période mentionnée au 1° de l'article 1<sup>er</sup> peuvent modifier leurs choix jusqu'à la fin de la période mentionnée au 2° du même article. La Caisse des dépôts et consignations effectue les versements correspondant à ces choix à la date mentionnée au 2° de l'article 3.<br/>Elle affecte les fonds qui n'ont pas fait l'objet de choix selon les modalités prévues à l'<a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000029414405&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. R6241-28\">article R. 6241-28 du code du travail</a>.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
        "type": "AUTONOME",
        "lstLienModification": [],
        "lstLienCitation": [],
        "conditionDiffere": null,
        "historique": null,
        "surtitre": null,
        "renvoi": null,
        "versionLabel": null,
        "infosComplementaires": null,
        "infosComplementairesHtml": null,
        "infosRestructurationBranche": null,
        "infosRestructurationBrancheHtml": null,
        "dateDebut": 32472144000000,
