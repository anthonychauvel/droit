{
  "titre": "Arrêté du 21 juillet 2020 portant extension d'un avenant à la convention collective nationale des commerces de détail non alimentaires (n° 1517)",
  "text": {
    "executionTime": 6,
    "dereferenced": false,
    "id": "JORFTEXT000042183810_01-01-2999",
