{
  "titre": "Arrêté du 8 février 2021 portant extension d'un avenant à la convention collective nationale des cabinets ou entreprises d'expertises en automobile (n° 1951)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000043142626_01-01-2999",
