    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000045155846",
        "cid": "JORFARTI000045155846",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000045155846",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des cabinets ou entreprises d'expertises en automobile du 20 novembre 1996, à l'exclusion des groupements d'intérêt économique qui relèvent de la convention collective des sociétés d'assurance, les stipulations de l'avis d'interprétation n° 9 du 26 mai 2020 relatif à l'articulation de certaines dispositions de l'avenant n° 68 du 11 mars 2019, à la convention collective nationale susvisée.</p>",
        "nota": null,
