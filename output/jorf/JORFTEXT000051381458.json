    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000051381461",
        "cid": "JORFARTI000051381461",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000051381461",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des mareyeurs-expéditeurs du 15 mai 1990, les stipulations de l'accord du 29 novembre 2024 relatif à la détermination des catégories objectives, conclu dans le cadre à la convention collective nationale susvisée.</p>",
        "nota": null,
