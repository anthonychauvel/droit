    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000054181355",
        "cid": "JORFARTI000054181355",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000054181355",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des entreprises au service de la création et de l'événement du 27 juin 2024, les stipulations de'avenant n° 4 du 5 décembre 2025 relatif au fonds de solidarité, à la convention collective nationale susvisée.</p>",
        "nota": null,
