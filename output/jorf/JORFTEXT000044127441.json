{
  "titre": "Arrêté du 17 septembre 2021 portant extension d'un avenant à un accord conclu dans le cadre de la convention collective nationale des taxis (n° 2219)",
  "text": {
    "executionTime": 21,
    "dereferenced": false,
    "id": "JORFTEXT000044127441_01-01-2999",
