    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000044345744",
        "cid": "JORFARTI000044345744",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000044345744",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des cadres, ingénieurs et assimilés des entreprises de gestion d'équipements thermiques et de climatisation du 3 mai 1983, les stipulations de l'accord du 21 mars 2021 relatif à la valorisation des parcours des représentants du personnel, conclu dans le cadre de la convention collective susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
