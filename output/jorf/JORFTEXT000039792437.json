    "dateFinVersion": "2999-01-01",
    "signers": "<p align=\"left\"><br/>Fait le 19 décembre 2019.</p><p align=\"left\"><br/>Pour le comité économique des produits de santé :<br/>Le vice-président,<br/>J.-P. Sales</p>",
