    "textAbroge": false,
    "etat": null,
    "dossiersLegislatifs": [],
    "nature": "ARRETE",
    "resume": null,
    "rectificatif": null,
    "motsCles": [],
    "appellations": [],
    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000046211055",
        "cid": "JORFARTI000046211055",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000046211055",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des activités de production des eaux embouteillées, des boissons rafraichissantes sans alcool et de bière du 24 mai 1988, les stipulations de l'avenant n° 41 du 12 avril 2022 relatif aux salaires minima conventionnels, à la convention collective nationale susvisée.<br/>L'avenant est étendu sous réserve de l'application des dispositions règlementaires portant fixation du salaire minimum interprofessionnel de croissance.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
