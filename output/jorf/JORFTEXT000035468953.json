{
  "titre": "Arrêté du 19 juin 2017 portant extension d'un accord conclu dans le cadre de la convention collective nationale des industries de transformation des volailles (n° 1938)",
  "text": {
    "executionTime": 39,
    "dereferenced": false,
    "id": "JORFTEXT000035468953_01-01-2999",
