{
  "titre": "Arrêté du 6 novembre 2020 portant extension d'un avenant à la convention collective nationale du sport (n° 2511)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000042539668_01-01-2999",
