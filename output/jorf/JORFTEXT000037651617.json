{
  "titre": "Arrêté du 21 novembre 2018 portant extension d'un avenant à la convention collective nationale des gardiens, concierges et employés d'immeubles (n° 1043)",
  "text": {
    "executionTime": 29,
    "dereferenced": false,
    "id": "JORFTEXT000037651617_01-01-2999",
