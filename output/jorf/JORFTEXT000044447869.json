    "textAbroge": false,
    "etat": null,
    "dossiersLegislatifs": [],
    "nature": "ARRETE",
    "resume": null,
    "rectificatif": null,
    "motsCles": [],
    "appellations": [],
    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000044447873",
        "cid": "JORFARTI000044447873",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000044447873",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des chaînes de cafétérias et assimilés du 20 août 1998, les stipulations de l'avenant n° 18 du 9 juillet 2021 relatif à la négociation annuelle de branche, à la convention collective nationale susvisée.<br/>L'avenant est étendu sous réserve de l'application des dispositions règlementaires portant fixation du salaire minimum interprofessionnel de croissance.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
