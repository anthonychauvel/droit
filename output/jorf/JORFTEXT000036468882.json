{
  "titre": "Arrêté du 19 décembre 2017 portant extension d'un avenant à la convention collective nationale de l'hôtellerie de plein air (n° 1631)",
  "text": {
    "executionTime": 5,
    "dereferenced": false,
    "id": "JORFTEXT000036468882_01-01-2999",
