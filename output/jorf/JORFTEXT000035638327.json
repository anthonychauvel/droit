        "multipleVersions": false
      },
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000035638331",
        "cid": "JORFARTI000035638331",
        "intOrdre": 1048574,
        "etat": "VIGUEUR",
        "num": "2",
        "path": "/JORFARTI000035638331",
        "pathTitle": [],
        "content": "<p><br/>Le prix public toutes taxes comprises des spécialités génériques appartenant aux groupes visés à l'article 1er est fixé, au vu des conventions portant fixation de leurs prix fabricant hors taxes conclues avec leurs exploitants respectifs, au montant figurant, pour les groupes, à l'annexe prévue au même article.</p>",
        "nota": null,
