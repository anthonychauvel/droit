{
  "titre": "Arrêté du 5 février 2021 portant extension d'un avenant à la convention collective nationale de branche des salariés en portage salarial (n° 3219)",
  "text": {
    "executionTime": 9,
    "dereferenced": false,
    "id": "JORFTEXT000043115093_01-01-2999",
