{
  "titre": "Arrêté du 14 décembre 2020 portant extension d'un accord conclu dans le cadre de la convention collective nationale de la radiodiffusion (n° 1922)",
  "text": {
    "executionTime": 13,
    "dereferenced": false,
    "id": "JORFTEXT000042866190_01-01-2999",
