{
  "titre": "Arrêté du 2 avril 2026 portant extension d'un avenant à la convention collective nationale des cinq branches des industries alimentaires diverses (n° 3109)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000053907584_01-01-2999",
