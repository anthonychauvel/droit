    "dateFinVersion": "2999-01-01",
    "signers": "<p align=\"left\"><br/>Fait le 17 juillet 2025.</p><p align=\"left\"><br/>Pour la ministre et par délégation :<br/>Le directeur général du travail,<br/>P. Ramain</p>",
