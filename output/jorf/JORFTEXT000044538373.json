{
  "titre": "Arrêté du 10 décembre 2021 portant extension d'un avenant à la convention collective nationale de l'industrie et des services nautiques (n° 3236)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000044538373_01-01-2999",
