    "dateFinVersion": "2999-01-01",
    "signers": "<p align=\"left\"><br/>Fait le 24 novembre 2026.</p><p align=\"left\"><br/>Pour le comité économique des produits de santé :<br/>La présidente,<br/>V. BEAUMEUNIER</p>",
