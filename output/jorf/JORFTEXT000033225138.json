{
  "titre": "Arrêté du 4 octobre 2016 portant extension d'un avenant à la convention collective nationale de l'animation (n° 1518)",
  "text": {
    "executionTime": 8,
    "dereferenced": false,
    "id": "JORFTEXT000033225138_01-01-2999",
