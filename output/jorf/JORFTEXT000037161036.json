{
  "titre": "Arrêté du 2 juillet 2018 portant extension d'un avenant à la convention collective nationale de l'industrie des cuirs et peaux (n° 207)",
  "text": {
    "executionTime": 16,
    "dereferenced": false,
    "id": "JORFTEXT000037161036_01-01-2999",
