        "intOrdre": 1048574,
        "etat": "VIGUEUR",
        "num": "2",
        "path": "/JORFARTI000052657058",
        "pathTitle": [],
        "content": "<p><br/>Est habilitée à négocier et conclure des conventions et accords collectifs de travail dans la convention collective du notariat (n° 2205), en application de l'<a href=\"/affichTexteArticle.do?cidTexte=JORFTEXT000000699572&idArticle=LEGIARTI000006915246&dateTexte=&categorieLien=cid\" title=\"Ordonnance n° 45-2590 du 2 novembre 1945 - art. 6\">article 6 de l'ordonnance n° 45-2590 du 2 novembre 1945</a> relative au statut du notariat, l'organisation suivante :</p><p><br/>- Conseil supérieur du notariat (CSN).</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
