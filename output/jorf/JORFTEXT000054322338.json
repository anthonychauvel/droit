{
  "titre": "Arrêté du 11 juin 2026 portant extension d'un accord conclu dans le cadre de la convention collective nationale des commerces de gros (n° 573)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000054322338_01-01-2999",
