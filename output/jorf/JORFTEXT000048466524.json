{
  "titre": "Arrêté du 10 novembre 2023 portant extension d'un avenant à la convention collective nationale de l'import-export et du commerce international (n° 43)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000048466524_01-01-2999",
