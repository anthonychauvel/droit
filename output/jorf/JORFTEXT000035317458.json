    "dateFinVersion": "2999-01-01",
    "signers": "<p align=\"left\"><br/>Fait le 28 juillet 2017.</p><p align=\"left\"><br/>La ministre du travail,<br/>Muriel Pénicaud</p><p align=\"left\"><br/>Le ministre de l'action et des comptes publics,<br/>Gérald Darmanin</p>",
