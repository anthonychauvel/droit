{
  "titre": "Arrêté du 16 juin 2025 portant répartition entre les départements et les distilleries du contingent d'exportation de rhum traditionnel",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000051836476_01-01-2999",
