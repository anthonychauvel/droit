      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000037112380",
        "cid": "JORFARTI000037112380",
        "intOrdre": 1048574,
        "etat": "VIGUEUR",
        "num": "2",
        "path": "/JORFARTI000037112380",
        "pathTitle": [],
        "content": "<p><br/>Cette autorisation est délivrée à compter du 3 juillet 2018 et jusqu'au 24 juillet 2021. Le Conseil supérieur de l'audiovisuel pourra prononcer la caducité de la présente autorisation si l'exploitation effective n'a pas débuté trois mois après la date d'entrée en vigueur de l'autorisation.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
        "type": "AUTONOME",
        "lstLienModification": [],
        "lstLienCitation": [],
        "conditionDiffere": null,
        "historique": null,
        "surtitre": null,
        "renvoi": null,
        "versionLabel": null,
        "infosComplementaires": null,
