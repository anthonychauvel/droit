        "pathTitle": [],
        "content": "<p><br/>Sont reconnues représentatives dans la convention collective nationale du personnel des offices publics de l'habitat et des sociétés de coordination (IDCC n° 3220) les organisations syndicales suivantes :</p><p><br/>- la Confédération française démocratique du travail (CFDT) ;<br/>- la Confédération générale du travail (CGT) ;<br/>- la Confédération générale du travail-Force ouvrière (CGT-FO).</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
