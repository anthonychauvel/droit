{
  "titre": "Arrêté du 8 janvier 2026 portant extension d'un accord conclu dans le cadre de la convention collective nationale de l'industrie textile (n° 18)",
  "text": {
    "executionTime": 20,
    "dereferenced": false,
    "id": "JORFTEXT000053379012_01-01-2999",
