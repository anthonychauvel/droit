{
  "titre": "Arrêté du 30 octobre 2019 portant extension d'un avenant à la convention collective nationale des cabinets ou entreprises d'expertises en automobile (n° 1951)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000039310004_01-01-2999",
