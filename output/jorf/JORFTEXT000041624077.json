    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000041624080",
        "cid": "JORFARTI000041624080",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000041624080",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des détaillants en chaussures du 27 juin 1973, les stipulations de l'avenant n° 93 du 1er juillet 2019 à la convention collective susvisée.<br/>Le dernier alinéa de l'avenant précédant la signature des parties est étendu sous réserve du respect des <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000006901674&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L2231-5 (V)\">dispositions de l'article L. 2231-5 du code du travail</a>.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
