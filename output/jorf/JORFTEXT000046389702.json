{
  "titre": "Arrêté du 23 septembre 2022 portant extension d'un avenant à la convention collective nationale des commerces de détail non alimentaires (n° 1517)",
  "text": {
    "executionTime": 12,
    "dereferenced": false,
    "id": "JORFTEXT000046389702_01-01-2999",
