    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000037885673",
        "cid": "JORFARTI000037885673",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000037885673",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application professionnel de la convention collective nationale des employés, techniciens et agents de maîtrise (ETAM) des travaux publics du 12 juillet 2006, et dans leur propre champ d'application territorial, les dispositions de :</p><p><br/>- l'accord territorial (Pays de la Loire) du 8 décembre 2017 relatif aux salaires minima annuels, conclu dans le cadre de la convention collective susvisée ;<br/>- l'accord territorial (Poitou-Charentes) du 8 décembre 2017 relatif aux salaires minima annuels, conclu dans le cadre de la convention collective susvisée ;<br/>- l'accord territorial (Centre-Val de Loire) du 12 décembre 2017 relatif aux salaires minima annuels, conclu dans le cadre de la convention collective susvisée ;<br/>- l'accord territorial (Aquitaine) du 13 décembre 2017 relatif aux salaires minima annuels, conclu dans le cadre de la convention collective susvisée ;<br/>- l'accord territorial (Rhône-Alpes) du 21 décembre 2017 relatif aux salaires minima annuels, conclu dans le cadre de la convention collective susvisée ;</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
