    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000042539916",
        "cid": "JORFARTI000042539916",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000042539916",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans leur champ d'application, les stipulations de l'accord collectif national du 30 janvier 2020 relatif à la formation professionnelle pour les années 2020 à 2022, conclu dans le cadre de l'accord national susvisé.<br/>L'article 4 est étendu sous réserve du respect de l'<a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000028688789&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L6111-6 (M)\">article L. 6111-6 du code du travail</a>, tel qu'il résulte de la <a href=\"/affichTexte.do?cidTexte=JORFTEXT000037367660&categorieLien=cid\" title=\"LOI n°2018-771 du 5 septembre 2018 (V)\">loi n° 2018-771 du 5 septembre 2018</a> pour la liberté de choisir son avenir professionnel.</p>",
        "nota": null,
        "comporteLiens": true,
