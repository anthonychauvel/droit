{
  "titre": "Arrêté du 27 mars 2019 portant extension d'un avenant à la convention collective nationale des employés, techniciens et agents de maîtrise du bâtiment (n° 2609)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000038334639_01-01-2999",
