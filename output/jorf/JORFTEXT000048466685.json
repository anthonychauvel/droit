    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000048466690",
        "cid": "JORFARTI000048466690",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000048466690",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de l'accord du 19 décembre 2018 constitutif de l'opérateur de compétences interindustriel « OPCO 2I », les stipulations de l'avenant du 14 février 2022 à l'accord du 19 décembre 2018 constitutif de l'opérateur de compétences interindustriel « OPCO 2I » susvisé.</p>",
        "nota": null,
