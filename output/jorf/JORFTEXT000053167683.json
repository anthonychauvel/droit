{
  "titre": "Arrêté du 9 décembre 2025 portant extension d'un avenant à un avenant à la convention collective nationale du personnel des industries du cartonnage (n° 489)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000053167683_01-01-2999",
