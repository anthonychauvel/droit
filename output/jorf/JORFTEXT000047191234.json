    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000047191238",
        "cid": "JORFARTI000047191238",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000047191238",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale de l'import-export et du commerce international du 18 décembre 1952, les stipulations de l'accord paritaire du 14 novembre 2022 relatif aux salaires, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
