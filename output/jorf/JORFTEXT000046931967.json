    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000046931970",
        "cid": "JORFARTI000046931970",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000046931970",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale du personnel des prestataires de services dans le domaine du secteur tertiaire du 13 août 1999, les stipulations de l'avenant du 17 mai 2022 à l'accord du 25 septembre 2015 modifié et relatif à l'apérition du régime de frais de santé, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
