{
  "titre": "Arrêté du 19 décembre 2017 portant extension d'un avenant à la convention collective nationale des cabinets et cliniques vétérinaires (n° 1875)",
  "text": {
    "executionTime": 11,
    "dereferenced": false,
    "id": "JORFTEXT000036260034_01-01-2999",
