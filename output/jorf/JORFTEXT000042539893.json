{
  "titre": "Arrêté du 6 novembre 2020 portant extension d'un avenant à la convention collective nationale des distributeurs conseils hors domicile (n° 1536)",
  "text": {
    "executionTime": 36,
    "dereferenced": false,
    "id": "JORFTEXT000042539893_01-01-2999",
