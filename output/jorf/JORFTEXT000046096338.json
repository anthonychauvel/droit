    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000046096341",
        "cid": "JORFARTI000046096341",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000046096341",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des tuiles et briques du 17 février 1982, les stipulations de l'avenant du 24 mai 2022 à l'accord du 30 novembre 2021 portant sur la mise en place d'un dispositif spécifique d'activité partielle de longue durée (APLD), conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
