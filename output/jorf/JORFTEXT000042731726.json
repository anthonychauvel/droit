{
  "titre": "Arrêté du 18 décembre 2020 portant extension d'un avenant à la convention collective nationale de l'animation (n° 1518)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000042731726_01-01-2999",
