{
  "titre": "Arrêté du 14 décembre 2022 portant extension d'un avenant à la convention collective nationale de l'enseignement privé indépendant (n° 2691)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000046781093_01-01-2999",
