    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000052020185",
        "cid": "JORFARTI000052020185",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000052020185",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des activités de production des eaux embouteillées, des boissons rafraichissantes sans alcool et de bière du 24 mai 1988, les stipulations de l'avenant du 19 novembre 2024 à l'accord du 10 janvier 2024 portant transposition des règles agréées par l'AGIRC dans sa décision du 20 février 2007, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
