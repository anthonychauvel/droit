    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000044548358",
        "cid": "JORFARTI000044548358",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000044548358",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des organismes de formation du 10 juin 1988, les stipulations de l'avenant du 12 juin 2020 relatif à la précision des dispositions conventionnelles traitant des jours mobiles, à la convention collective nationale susvisée.</p>",
        "nota": null,
