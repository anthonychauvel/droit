{
  "titre": "Arrêté du 9 mars 2023 portant extension d'un avenant à la convention collective nationale des entreprises du paysage",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000047311223_01-01-2999",
