{
  "titre": "Arrêté du 4 septembre 2023 portant extension d'un avenant à la convention collective nationale des commerces de détail non alimentaires (n° 1517)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000048148369_01-01-2999",
