    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000050831301",
        "cid": "JORFARTI000050831301",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000050831301",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale de la plasturgie du 1er juillet 1960, les stipulations de l'accord du 27 juin 2024 relatif aux catégories de bénéficiaires du régime de protection sociale complémentaire conclu dans le cadre de la convention collective nationale susvisée.</p>",
