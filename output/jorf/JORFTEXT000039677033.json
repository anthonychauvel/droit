{
  "titre": "Arrêté du 23 décembre 2019 portant extension d'un avenant à la convention collective nationale des mareyeurs-expéditeurs (n° 1589)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000039677033_01-01-2999",
