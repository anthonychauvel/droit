      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000036705349",
        "cid": "JORFARTI000036705349",
        "intOrdre": 1048574,
        "etat": "VIGUEUR",
        "num": "2",
        "path": "/JORFARTI000036705349",
        "pathTitle": [],
        "content": "<p><br/>L'association Chrétienne Centre-Ouest des radios diocésaines (ACCORD) est autorisée à utiliser les fréquences mentionnées en annexe, conformément à la convention et aux annexes de la présente décision.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
