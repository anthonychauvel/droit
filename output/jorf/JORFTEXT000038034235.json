{
  "titre": "Arrêté du 15 janvier 2019 portant extension d'un avenant à la convention collective nationale des sociétés d'assistance (n° 1801)",
  "text": {
    "executionTime": 22,
    "dereferenced": false,
    "id": "JORFTEXT000038034235_01-01-2999",
