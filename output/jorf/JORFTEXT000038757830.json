    "dateFinVersion": "2999-01-01",
    "signers": "<p align=\"left\"><br/>Fait le 8 juillet 2019.</p><p align=\"left\"><br/>Pour la ministre et par délégation :<br/>Le directeur général du travail,<br/>Y. Struillou</p>",
