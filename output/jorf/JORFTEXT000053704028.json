    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000053704033",
        "cid": "JORFARTI000053704033",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000053704033",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de l'accord du 23 avril 2015 relatif au champ d'application de la branche ferroviaire, les stipulations de l'avenant du 17 décembre 2025 à l'accord du 6 décembre 2021 relatif aux classifications et aux rémunérations, conclu dans le cadre de la branche ferroviaire.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
