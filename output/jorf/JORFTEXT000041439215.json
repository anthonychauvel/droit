{
  "titre": "Arrêté du 15 janvier 2020 portant extension d'un avenant à la convention collective nationale de Pôle emploi (n° 2847)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000041439215_01-01-2999",
