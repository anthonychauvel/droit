    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000051715375",
        "cid": "JORFARTI000051715375",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000051715375",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des industries de carrières et matériaux de construction applicable aux ouvriers, employés, techniciens, agents de maîtrise et aux cadres du 6 juillet 2022, et dans leur propre champ d'application territorial, les stipulations de :</p><p><br/>- l'accord territorial (Centre-Val de Loire) du 27 mars 2025 relatif aux salaires minimaux des ouvriers, employés, techniciens, agents de maîtrise (niveaux 1 à 7), conclu dans le cadre de la convention collective nationale susvisée ;<br/>- l'accord territorial (Ile-de-France) du 13 mars 2025 relatif aux salaires minimaux des ouvriers, employés, techniciens, agents de maîtrise (niveaux 1 à 7), conclu dans le cadre de la convention collective nationale susvisée ;<br/>- l'accord territorial (Normandie) du 14 mars 2025 relatif aux salaires minimaux des ouvriers, employés, techniciens, agents de maîtrise (niveaux 1 à 7), conclu dans le cadre de la convention collective nationale susvisée ;<br/>- l'accord territorial (Nouvelle-Aquitaine) du 14 mars 2025 relatif aux salaires minimaux des ouvriers, employés, techniciens, agents de maîtrise (niveaux 1 à 7), conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
