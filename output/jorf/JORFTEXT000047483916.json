    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000047483920",
        "cid": "JORFARTI000047483920",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000047483920",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des entreprises à succursales du commerce de détail de la chaussure du 2 juillet 1968 devenue convention collective nationale du commerce succursaliste de la chaussure par avenant du 22 octobre 2008, les stipulations de l'avenant n° 1 du 31 mars 2022 portant modification de l'accord du 25 mars 2021 relatif à la prévoyance, conclu dans le cadre de la convention collective nationale susvisée.<br/>La dernière phrase du 1er alinéa de l'article 2 est étendue sous réserve du respect des <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000006901785&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L2261-7 (V)\">dispositions de l'article L. 2261-7 du code du travail</a>.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
