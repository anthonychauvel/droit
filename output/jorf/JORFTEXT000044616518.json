{
  "titre": "Arrêté du 17 décembre 2021 portant répartition entre les départements et les distilleries du contingent d'exportation de rhum traditionnel",
  "text": {
    "executionTime": 10,
    "dereferenced": false,
    "id": "JORFTEXT000044616518_01-01-2999",
