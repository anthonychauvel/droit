    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000038554618",
        "cid": "JORFARTI000038554618",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000038554618",
        "pathTitle": [],
        "content": "<p><br/>Sont étendues, conformément aux <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006073189&idArticle=LEGIARTI000006745466&dateTexte=&categorieLien=cid\" title=\"Code de la sécurité sociale. - art. L911-3 (M)\">dispositions de l'article L. 911-3 du code de la sécurité sociale</a>, les stipulations de l'avenant n° 1 à l'accord national interprofessionnel du 17 novembre 2017 instituant le régime Agirc-Arrco de retraite complémentaire, conclu le 7 mars 2018.<br/>Cette extension a pour effet de rendre les stipulations de cet avenant obligatoires pour tous les salariés, anciens salariés et leurs ayants droit et pour tous les employeurs compris dans son champ d'application.</p>",
        "nota": null,
