    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000042229265",
        "cid": "JORFARTI000042229265",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000042229265",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des personnels des sociétés anonymes et fondations d'HLM du 27 avril 2000, tel qu'étendu par arrêté du 22 janvier 2001, les stipulations de l'avenant n° 11 du 30 janvier 2020 relatif aux barèmes de rémunération, à la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
