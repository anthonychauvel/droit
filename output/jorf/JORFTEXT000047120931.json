    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000047120933",
        "cid": "JORFARTI000047120933",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000047120933",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des organismes de formation du 10 juin 1988 tel qu'étendu par arrêté du 16 mars 1989, les stipulations de l'avenant du 8 juillet 2022 relatif à l'insertion professionnelle et au maintien dans l'emploi des salariés en situation de handicap, à la convention collective susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
