{
  "titre": "Arrêté du 27 décembre 2018 portant extension d'un avenant à la convention collective nationale de l'immobilier (n° 1527)",
  "text": {
    "executionTime": 13,
    "dereferenced": false,
    "id": "JORFTEXT000037881153_01-01-2999",
