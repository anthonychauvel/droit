{
  "titre": "Arrêté du 7 novembre 2025 portant extension d'un avenant à la convention collective nationale des entreprises de courtage d'assurances et/ou de réassurances (n° 2247)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000052820756_01-01-2999",
