    "jurisState": "Sans état juridique",
    "visa": "<p align=\"left\"><br/>Le Premier ministre,<br/>Vu le <a href=\"/affichTexte.do?cidTexte=JORFTEXT000000231612&categorieLien=cid\" title=\"Décret n°2002-1022 du 29 juillet 2002\">décret n° 2002-1022 du 29 juillet 2002</a> relatif à la rémunération de services rendus aux personnels relevant du Premier ministre,<br/>Arrête :</p>",
    "modifDate": null,
    "jurisDate": null,
    "dateDebutVersion": "2999-01-01",
    "dateFinVersion": "2999-01-01",
    "signers": "<p align=\"left\"><br/>Fait le 10 octobre 2025.</p><p align=\"left\"><br/>Pour le Premier ministre et par délégation :<br/>Le directeur des services administratifs et financiers,<br/>T. de Vanssay de Blavous</p>",
    "prepWork": "",
