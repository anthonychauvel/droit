    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000042732364",
        "cid": "JORFARTI000042732364",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000042732364",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale de la production cinématographique du 19 janvier 2012, les stipulations de l'accord du 18 décembre 2018 relatif au développement de l'emploi durable dans la branche de la production cinématographique, conclu dans le cadre de la convention collective susvisée.</p>",
        "nota": null,
