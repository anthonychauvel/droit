    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000042732193",
        "cid": "JORFARTI000042732193",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000042732193",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des professions regroupées du cristal, du verre et du vitrail du 3 novembre 1994, les stipulations de l'accord relatif du 11 juillet 2018 relatif à l'observatoire prospectif des métiers, des qualifications et des compétences, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
