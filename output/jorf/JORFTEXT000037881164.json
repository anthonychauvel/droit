{
  "titre": "Arrêté du 27 décembre 2018 portant extension d'un avenant à la convention collective nationale des gardiens, concierges et employés d'immeubles (n° 1043)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000037881164_01-01-2999",
