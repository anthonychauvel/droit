    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000051381544",
        "cid": "JORFARTI000051381544",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000051381544",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale du personnel des entreprises de restauration de collectivités du 20 juin 1983, les stipulations de l'avenant n° 67 du 31 juillet 2024 relatif à la détermination des salariés assimilés au statut cadre au titre du régime de protection sociale complémentaire, à la convention collective susvisée.</p>",
