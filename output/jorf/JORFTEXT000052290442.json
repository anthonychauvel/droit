{
  "titre": "Arrêté du 18 septembre 2025 portant extension d'un avenant à la convention collective nationale de l'enseignement privé indépendant (n° 2691)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000052290442_01-01-2999",
