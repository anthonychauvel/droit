{
  "titre": "Arrêté du 17 février 2020 portant extension d'un avenant à la convention collective nationale de la navigation de plaisance (n° 1423)",
  "text": {
    "executionTime": 23,
    "dereferenced": false,
    "id": "JORFTEXT000041636494_01-01-2999",
