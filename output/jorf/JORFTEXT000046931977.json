    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000046931980",
        "cid": "JORFARTI000046931980",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000046931980",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale de la restauration rapide du 18 mars 1988, les stipulations de l'avenant n° 9 du 3 juin 2022 à l'avenant n° 42 du 11 mai 2010 relatif au régime de prévoyance complémentaire et à la garantie incapacité de travail, à la convention collective nationale de la restauration rapide.</p>",
        "nota": null,
        "comporteLiens": true,
