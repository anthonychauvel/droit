    "dateFinVersion": "2999-01-01",
    "signers": "<p align=\"left\"><br/>Fait le 27 décembre 2017.</p><p align=\"left\"><br/>Pour la ministre et par délégation :<br/>Le directeur adjoint,<br/>L. Vilboeuf</p>",
