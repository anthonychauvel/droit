    "dateFinVersion": "2999-01-01",
    "signers": "<p align=\"left\"><br/>Fait le 5 décembre 2025.</p><p align=\"left\"><br/>Pour le comité économique des produits de santé :<br/>La présidente,<br/>V. Beaumeunier</p>",
