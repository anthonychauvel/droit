    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000039194653",
        "cid": "JORFARTI000039194653",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000039194653",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des activités de marchés financiers du 11 juin 2010, les dispositions de l'accord du 13 décembre 2018 relatif à la désignation d'un Opérateur de compétences, conclu dans le cadre de la convention collective nationale susvisée.<br/>Le 2e alinéa de l'article 2 est étendu sous réserve que l'OPCO mentionné soit assimilé à l'OPCO Atlas, agréé par arrêté du 29 mars 2019.<br/>Le 5e alinéa de l'article 4 est étendu sous réserve du respect des <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000006901785&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L2261-7 (V)\">dispositions de l'article L. 2261-7 du code du travail</a>.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
