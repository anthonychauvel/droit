{
  "titre": "Arrêté du 11 janvier 2018 portant extension d'un avenant à la convention collective nationale du commerce de détail de l'horlogerie-bijouterie (n° 1487)",
  "text": {
    "executionTime": 11,
    "dereferenced": false,
    "id": "JORFTEXT000036526495_01-01-2999",
