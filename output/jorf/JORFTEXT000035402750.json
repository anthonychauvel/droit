{
  "titre": "Arrêté du 3 août 2017 portant extension d'un accord conclu dans le cadre de la convention collective nationale de l'industrie textile (n° 18)",
  "text": {
    "executionTime": 15,
    "dereferenced": false,
    "id": "JORFTEXT000035402750_01-01-2999",
