{
  "titre": "Arrêté du 2 juillet 2021 portant extension d'un avenant à la convention collective nationale unifiée « Ports et Manutention » (n° 3017)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000043794043_01-01-2999",
