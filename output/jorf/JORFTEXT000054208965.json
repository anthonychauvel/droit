    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000054208968",
        "cid": "JORFARTI000054208968",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000054208968",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale de la métallurgie du 7 février 2022, les stipulations de l'accord du 20 février 2026 relatif à la gouvernance et au suivi du dispositif d'épargne salariale, conclu dans le cadre de la convention collective nationale susvisée.</p>",
