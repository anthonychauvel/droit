{
  "titre": "Arrêté du 20 mai 2020 portant extension d'un avenant à la convention collective nationale de la production cinématographique (n° 3097)",
  "text": {
    "executionTime": 7,
    "dereferenced": false,
    "id": "JORFTEXT000041937635_01-01-2999",
