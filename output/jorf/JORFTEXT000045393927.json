    "dateFinVersion": "2999-01-01",
    "signers": "<p align=\"left\"><br/>Fait le 22 février 2022.</p><p align=\"left\"><br/>Pour le comité économique des produits de santé :<br/>Le président,<br/>P. Bouyoux</p>",
