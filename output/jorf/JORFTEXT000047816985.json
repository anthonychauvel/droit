{
  "titre": "Arrêté du 30 juin 2023 portant extension d'un avenant à la convention collective nationale des entreprises de courtage d'assurances et/ou de réassurances (n° 2247)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000047816985_01-01-2999",
