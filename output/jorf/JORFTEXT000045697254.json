        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000045697258",
        "pathTitle": [],
        "content": "<p><br/>Dans la collectivité de Corse, le Centre du sport et de la jeunesse de Corse est chargé de la mise en œuvre des missions relevant du ministre chargé des sports et de l'Agence nationale du sport en matière de formation et de préparation des sportifs figurant sur les listes mentionnées à l'<a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006071318&idArticle=LEGIARTI000006547582&dateTexte=&categorieLien=cid\" title=\"Code du sport. - art. L221-2 (V)\">article L. 221-2 du code du sport</a> et de participation au réseau national du sport de haut niveau.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
