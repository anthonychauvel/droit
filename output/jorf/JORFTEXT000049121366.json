{
  "titre": "Arrêté du 2 février 2024 portant extension d'un avenant à la convention collective nationale de la production de films d'animation (n° 2412)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000049121366_01-01-2999",
