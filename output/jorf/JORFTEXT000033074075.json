    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000033074078",
        "cid": "JORFARTI000033074078",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000033074078",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale du personnel des prestataires de services dans le secteur tertiaire du 13 août 1999, les dispositions de l'accord relatif aux salaires du 19 avril 2016 (2 annexes), conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
