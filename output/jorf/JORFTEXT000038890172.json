    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000038890176",
        "cid": "JORFARTI000038890176",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000038890176",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale du négoce et prestations de services dans les domaines médico-techniques du 9 avril 1997, les dispositions de l'accord du 4 juin 2009 relatif au régime prévoyance, conclu dans le cadre de la convention collective nationale susvisée.<br/>L'avenant est étendu sous réserve de l'application des stipulations de l'accord national interprofessionnel du 17 novembre 2017 instituant le régime Agirc-Arrco de retraite complémentaire et de l'accord national interprofessionnel du 17 novembre 2017 relatif à la prévoyance des cadres.<br/>L'article 5 est étendu sous réserve du respect des <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000006901674&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L2231-5 (V)\">dispositions de l'article L. 2231-5 du code du travail</a>.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
