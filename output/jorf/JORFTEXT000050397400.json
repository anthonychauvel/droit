        "intOrdre": 1048574,
        "etat": "VIGUEUR",
        "num": "2",
        "path": "/JORFARTI000050397410",
        "pathTitle": [],
        "content": "<p><br/>Le montant des acomptes à verser pour 2024 s'élève à 48 625 185,24 euros. Compte tenu des avances déjà versées au titre de 2024 pour un montant de 40 980 000 euros, il reste à verser pour 2024 un montant de 7 645 185,24 euros.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
