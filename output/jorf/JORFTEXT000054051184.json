    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000054051188",
        "cid": "JORFARTI000054051188",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000054051188",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des cabinets d'administrateurs de biens et des sociétés immobilières du 9 septembre 1988, devenue convention collective nationale de l'immobilier par l'avenant n° 3 du 27 octobre 1989, les stipulations de l'avenant n° 110 du 4 mars 2026 portant modification de l'annexe II relative aux « Salaires et primes d'ancienneté » et de l'annexe IV relative au « Statut de négociateur immobilier » de la convention collective nationale susvisée.</p>",
        "nota": null,
