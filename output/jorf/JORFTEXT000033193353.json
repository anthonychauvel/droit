    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000033193357",
        "cid": "JORFARTI000033193357",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000033193357",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des remontées mécaniques et domaines skiables du 15 mai 1968, modifié par l'avenant n° 20 du 16 novembre 1995 étendu par arrêté du 25 juin 1997, les dispositions de :</p><p><br/>-l'avenant n° 60 du 27 novembre 2013 relatif à la prévoyance, à la convention collective susvisée ;<br/>-l'avenant n° 61 du 27 novembre 2013 relatif aux contrats de génération, à la convention collective susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
