    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000046211190",
        "cid": "JORFARTI000046211190",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000046211190",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective des industries métallurgiques, mécaniques, électriques, connexes et similaires de Seine-et-Marne du 30 novembre 1976, les stipulations de l'avenant du 19 avril 2022 relatif aux taux annuels garantis, à la valeur du point et à l'indemnité de panier, à la convention collective susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
