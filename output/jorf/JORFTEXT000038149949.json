{
  "titre": "Arrêté du 13 février 2019 portant extension d'un avenant à la convention collective nationale des cabinets et cliniques vétérinaires (n° 1875)",
  "text": {
    "executionTime": 10,
    "dereferenced": false,
    "id": "JORFTEXT000038149949_01-01-2999",
