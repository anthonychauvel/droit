{
  "titre": "Arrêté du 3 juin 2022 portant extension d'un avenant à la convention collective nationale de la pâtisserie (n° 1267)",
  "text": {
    "executionTime": 26,
    "dereferenced": false,
    "id": "JORFTEXT000045925141_01-01-2999",
