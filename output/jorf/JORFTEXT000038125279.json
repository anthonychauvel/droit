{
  "titre": "Arrêté du 8 février 2019 portant extension d'un avenant à la convention collective nationale des entreprises de services à la personne (n° 3127)",
  "text": {
    "executionTime": 12,
    "dereferenced": false,
    "id": "JORFTEXT000038125279_01-01-2999",
