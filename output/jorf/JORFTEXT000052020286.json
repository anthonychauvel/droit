{
  "titre": "Arrêté du 16 juillet 2025 portant extension d'un avenant à la convention collective nationale de la production cinématographique (n° 3097)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000052020286_01-01-2999",
