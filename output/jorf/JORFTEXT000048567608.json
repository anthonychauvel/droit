    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000048567611",
        "cid": "JORFARTI000048567611",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000048567611",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application professionnel de la convention collective nationale de la coiffure et des professions connexes du 10 juillet 2006, les stipulations de l'avenant n° 47 du 11 mai 2023 relatif à la classification professionnelle des salariés titulaires du certificat « réaliser des techniques de coiffure pour cheveux spécifiques, bouclés à crépus », à la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
