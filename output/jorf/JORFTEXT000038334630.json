{
  "titre": "Arrêté du 27 mars 2019 portant extension d'un avenant à la convention collective nationale de l'animation (n° 1518)",
  "text": {
    "executionTime": 30,
    "dereferenced": false,
    "id": "JORFTEXT000038334630_01-01-2999",
