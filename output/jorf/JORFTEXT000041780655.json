    "dateFinVersion": "2999-01-01",
    "signers": "<p align=\"left\"><br/>Fait le 31 mars 2020.</p><p align=\"left\"><br/>Pour la ministre et par délégation :<br/>Le délégué général à l'emploi et à la formation professionnelle,<br/>B. Lucas</p>",
