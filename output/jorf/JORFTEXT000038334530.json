{
  "titre": "Arrêté du 27 mars 2019 portant extension d'un avenant à un accord conclu dans le cadre de la convention collective nationale des organismes de formation (n° 1516)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000038334530_01-01-2999",
