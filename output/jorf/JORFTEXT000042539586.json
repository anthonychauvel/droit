{
  "titre": "Arrêté du 6 novembre 2020 portant extension d'un avenant à la convention collective nationale du commerce de détail et de gros à prédominance alimentaire (n° 2216)",
  "text": {
    "executionTime": 39,
    "dereferenced": false,
    "id": "JORFTEXT000042539586_01-01-2999",
