{
  "titre": "Arrêté du 20 juin 2022 portant extension d'un avenant à la convention collective nationale des commerces de détail non alimentaires (n° 1517)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000046026523_01-01-2999",
