{
  "titre": "Arrêté du 11 décembre 2025 portant extension d'un avenant à la convention collective nationale des cabinets ou entreprises d'expertises en automobile (n° 1951)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000053167819_01-01-2999",
