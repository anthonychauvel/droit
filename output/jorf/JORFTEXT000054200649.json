{
  "titre": "Arrêté du 21 mai 2026 portant extension d'un avenant à la convention collective nationale de la pharmacie d'officine (n° 1996)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000054200649_01-01-2999",
