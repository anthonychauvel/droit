    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000045887502",
        "cid": "JORFARTI000045887502",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000045887502",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application professionnel de la convention collective nationale des entreprises de prévention et de sécurité du 15 février 1985, les stipulations de l'avenant du 27 septembre 2021 à l'accord du 30 avril 2003 relatif à la création d'une commission paritaire de l'emploi et de la formation professionnelle, conclu dans le cadre de la convention collective nationale susvisée.<br/>La 2e phrase du 3e alinéa de l'article 6 est étendu sous réserve du respect des <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000006901785&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L2261-7 (V)\">dispositions de l'article L. 2261-7 du code du travail</a>.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
