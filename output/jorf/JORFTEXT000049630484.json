    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000049630487",
        "cid": "JORFARTI000049630487",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000049630487",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des casinos du 29 mars 2002, les stipulations de l'avenant n° 36 du 18 décembre 2023 à l'accord du 30 juin 2008 relatif à l'emploi des seniors, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
