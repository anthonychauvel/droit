    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000048501348",
        "cid": "JORFARTI000048501348",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000048501348",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective des industries métallurgiques, mécaniques, similaires et connexes du Jura du 11 janvier 2019, les stipulations de l'avenant du 8 septembre 2023 relatif aux rémunérations effectives garanties, à la convention collective susvisée.</p>",
