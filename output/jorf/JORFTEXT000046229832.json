    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000046229837",
        "cid": "JORFARTI000046229837",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000046229837",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective des industries métallurgiques, mécaniques, électriques, électro-céramiques et connexes des Hautes-Pyrénées du 18 février 1992, les stipulations de :</p><p><br/>- l'accord du 4 avril 2022 sur les rémunérations minimales hiérarchiques des mensuels 2022 (ouvriers, administratifs, techniciens et agents de maîtrise d'atelier), conclu dans le cadre de la convention collective susvisée ;<br/>- l'accord du 4 avril 2022 sur les taux effectifs garantis des mensuels 2022 (ouvriers, administratifs, techniciens et agents de maîtrise d'atelier), conclu dans le cadre de la convention collective susvisée.</p>",
        "nota": null,
