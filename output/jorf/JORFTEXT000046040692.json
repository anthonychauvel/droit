{
  "titre": "Arrêté du 1er juillet 2022 portant extension d'un avenant à la convention collective nationale du personnel des cabinets médicaux (n° 1147)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000046040692_01-01-2999",
