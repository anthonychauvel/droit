    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000042994925",
        "cid": "JORFARTI000042994925",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000042994925",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés du commerce de gros de la poissonnerie, les stipulations de l'avenant du 6 février 2019 relatif au travail de nuit, à la convention collective nationale de la poissonnerie, tel qu'étendu par arrêté du 6 novembre 2020 publié au Journal officiel du 20 novembre 2020.</p>",
        "nota": null,
