{
  "titre": "Arrêté du 27 mars 2019 portant extension d'un avenant à la convention collective nationale des 5 branches des industries alimentaires diverses (n° 3109)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000038334556_01-01-2999",
