{
  "titre": "Arrêté du 10 novembre 2023 portant extension d'un avenant à la convention collective nationale de la boulangerie-pâtisserie (entreprises artisanales) (n° 843)",
  "text": {
    "executionTime": 16,
    "dereferenced": false,
    "id": "JORFTEXT000048466632_01-01-2999",
