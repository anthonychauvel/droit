    "jurisDate": null,
    "dateDebutVersion": "2999-01-01",
    "dateFinVersion": "2999-01-01",
    "signers": "<p align=\"left\"><br/>Fait à Paris, le 24 juillet 2019.</p><p align=\"left\"><br/>Pour le Conseil supérieur de l'audiovisuel :<br/>Le président,<br/>R.-O. Maistre</p>",
