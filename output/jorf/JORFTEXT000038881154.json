            "content": "<p><br/>ANNEXE (*)</p><p><br/>Nom du service : Radio FG.<br/>Zone géographique mise en appel : Fontainebleau.<br/>Fréquence : 98,3 MHz.<br/>Adresse du site : Butte de Montceau, Avon (77).<br/>Altitude du site (NGF) : 123 mètres.<br/>Hauteur d'antenne : 43 mètres/sol.<br/>Puissance apparente rayonnée (PAR max.) : 200 W.<br/>Limitation du rayonnement dans le plan horizontal :</p><p><div align=\"center\"><center><table border=\"1\"><tr><th><br/>AZIMUT (degrés)</th><th><br/>ATTÉNUATION (dB) (1)</th><th><br/>AZIMUT (degrés)</th><th><br/>ATTÉNUATION (dB) (1)</th><th><br/>AZIMUT (degrés)</th><th><br/>ATTÉNUATION (dB) (1)</th><th><br/>AZIMUT (degrés)</th><th><br/>ATTÉNUATION (dB) (1)</th></tr><tr><td valign=\"middle\" align=\"center\"><br/>0</td><td valign=\"middle\" align=\"center\"><br/>6</td><td valign=\"middle\" align=\"center\"><br/>90</td><td valign=\"middle\" align=\"center\"><br/>5</td><td valign=\"middle\" align=\"center\"><br/>180</td><td valign=\"middle\" align=\"center\"><br/>0</td><td valign=\"middle\" align=\"center\"><br/>270</td><td valign=\"middle\" align=\"center\"><br/>0</td></tr><tr><td valign=\"middle\" align=\"center\"><br/>10</td><td valign=\"middle\" align=\"center\"><br/>6</td><td valign=\"middle\" align=\"center\"><br/>100</td><td valign=\"middle\" align=\"center\"><br/>4</td><td valign=\"middle\" align=\"center\"><br/>190</td><td valign=\"middle\" align=\"center\"><br/>0</td><td valign=\"middle\" align=\"center\"><br/>280</td><td valign=\"middle\" align=\"center\"><br/>0</td></tr><tr><td valign=\"middle\" align=\"center\"><br/>20</td><td valign=\"middle\" align=\"center\"><br/>6</td><td valign=\"middle\" align=\"center\"><br/>110</td><td valign=\"middle\" align=\"center\"><br/>3</td><td valign=\"middle\" align=\"center\"><br/>200</td><td valign=\"middle\" align=\"center\"><br/>0</td><td valign=\"middle\" align=\"center\"><br/>290</td><td valign=\"middle\" align=\"center\"><br/>1</td></tr><tr><td valign=\"middle\" align=\"center\"><br/>30</td><td valign=\"middle\" align=\"center\"><br/>7</td><td valign=\"middle\" align=\"center\"><br/>120</td><td valign=\"middle\" align=\"center\"><br/>2</td><td valign=\"middle\" align=\"center\"><br/>210</td><td valign=\"middle\" align=\"center\"><br/>0</td><td valign=\"middle\" align=\"center\"><br/>300</td><td valign=\"middle\" align=\"center\"><br/>1</td></tr><tr><td valign=\"middle\" align=\"center\"><br/>40</td><td valign=\"middle\" align=\"center\"><br/>7</td><td valign=\"middle\" align=\"center\"><br/>130</td><td valign=\"middle\" align=\"center\"><br/>2</td><td valign=\"middle\" align=\"center\"><br/>220</td><td valign=\"middle\" align=\"center\"><br/>0</td><td valign=\"middle\" align=\"center\"><br/>310</td><td valign=\"middle\" align=\"center\"><br/>2</td></tr><tr><td valign=\"middle\" align=\"center\"><br/>50</td><td valign=\"middle\" align=\"center\"><br/>6</td><td valign=\"middle\" align=\"center\"><br/>140</td><td valign=\"middle\" align=\"center\"><br/>1</td><td valign=\"middle\" align=\"center\"><br/>230</td><td valign=\"middle\" align=\"center\"><br/>0</td><td valign=\"middle\" align=\"center\"><br/>320</td><td valign=\"middle\" align=\"center\"><br/>3</td></tr><tr><td valign=\"middle\" align=\"center\"><br/>60</td><td valign=\"middle\" align=\"center\"><br/>6</td><td valign=\"middle\" align=\"center\"><br/>150</td><td valign=\"middle\" align=\"center\"><br/>1</td><td valign=\"middle\" align=\"center\"><br/>240</td><td valign=\"middle\" align=\"center\"><br/>0</td><td valign=\"middle\" align=\"center\"><br/>330</td><td valign=\"middle\" align=\"center\"><br/>3</td></tr><tr><td valign=\"middle\" align=\"center\"><br/>70</td><td valign=\"middle\" align=\"center\"><br/>6</td><td valign=\"middle\" align=\"center\"><br/>160</td><td valign=\"middle\" align=\"center\"><br/>0</td><td valign=\"middle\" align=\"center\"><br/>250</td><td valign=\"middle\" align=\"center\"><br/>0</td><td valign=\"middle\" align=\"center\"><br/>340</td><td valign=\"middle\" align=\"center\"><br/>4</td></tr><tr><td valign=\"middle\" align=\"center\"><br/>80</td><td valign=\"middle\" align=\"center\"><br/>5</td><td valign=\"middle\" align=\"center\"><br/>170</td><td valign=\"middle\" align=\"center\"><br/>0</td><td valign=\"middle\" align=\"center\"><br/>260</td><td valign=\"middle\" align=\"center\"><br/>0</td><td valign=\"middle\" align=\"center\"><br/>350</td><td valign=\"middle\" align=\"center\"><br/>5</td></tr><tr><td colspan=\"8\" valign=\"middle\" align=\"justify\"><br/>(1) Atténuation par rapport à la PAR maximale.</td></tr></table></center></div></p><p class=\"note\"><br/>(*) Sous réserve d'un aboutissement favorable des procédures de coordination internationale.</p>",
