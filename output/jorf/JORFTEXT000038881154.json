        "type": "AUTONOME",
        "lstLienModification": [],
        "lstLienCitation": [],
        "conditionDiffere": null,
        "historique": null,
        "surtitre": null,
        "renvoi": null,
        "versionLabel": null,
        "infosComplementaires": null,
