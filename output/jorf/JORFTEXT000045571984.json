{
  "titre": "Arrêté du 1er avril 2022 portant extension d'un avenant à un avenant à la convention collective nationale de la distribution directe (n° 2372)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000045571984_01-01-2999",
