{
  "titre": "Arrêté du 8 décembre 2023 portant extension d'un avenant à la convention collective nationale des entreprises d'architecture (n° 2332)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000048567558_01-01-2999",
