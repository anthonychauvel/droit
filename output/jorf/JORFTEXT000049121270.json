    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000049121272",
        "cid": "JORFARTI000049121272",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000049121272",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des organismes de formation du 10 juin 1988, les stipulations de l'avenant du 27 juin 2023 relatif à la réécriture à droit constant de l'article 18 de la convention collective nationale susvisée.</p>",
