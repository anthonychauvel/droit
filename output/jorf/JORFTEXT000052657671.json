{
  "titre": "Arrêté du 7 novembre 2025 portant extension d'un avenant à la convention collective nationale de l'immobilier (n° 1527)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000052657671_01-01-2999",
