{
  "titre": "Arrêté du 6 février 2018 portant extension d'un avenant à la convention collective nationale des entreprises de propreté et des services associés (n° 3043)",
  "text": {
    "executionTime": 11,
    "dereferenced": false,
    "id": "JORFTEXT000036606223_01-01-2999",
