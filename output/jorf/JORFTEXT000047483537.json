    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000047483541",
        "cid": "JORFARTI000047483541",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000047483541",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des acteurs du lien social et familial du 4 juin 1983, les stipulations de l'avenant n° 09-22 du 27 octobre 2022 à l'accord du 4 novembre 2020 relatif au développement du dialogue social et portant prolongement de la date d'utilisation du reliquat des bons syndicaux, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
