    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000045358924",
        "cid": "JORFARTI000045358924",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000045358924",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des mareyeurs-expéditeurs du 15 mai 1990, les stipulations de l'avenant du 17 mars 2021 relatif au régime de prévoyance et modifiant le chapitre VII de la convention collective nationale des mareyeurs-expéditeurs susvisée.<br/>Le mot : « OCIRP » est exclu de l'extension, en application de la décision n° 2013-672 DC du 13 juin 2013 du Conseil constitutionnel relative au libre choix de l'employeur pour l'organisation de la couverture des salariés en matière de protection sociale complémentaire.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
