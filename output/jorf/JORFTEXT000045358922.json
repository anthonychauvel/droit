{
  "titre": "Arrêté du 21 février 2022 portant extension d'un avenant à la convention collective nationale des mareyeurs-expéditeurs (n° 1589)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000045358922_01-01-2999",
