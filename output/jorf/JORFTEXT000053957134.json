    "dateFinVersion": "2999-01-01",
    "signers": "<p align=\"left\"><br/>Fait le 21 avril 2026.</p><p align=\"left\"><br/>Pour la ministre et par délégation :<br/>Le chef du service des ressources humaines,<br/>J. Mifsud</p>",
