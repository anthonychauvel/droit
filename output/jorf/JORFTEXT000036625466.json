    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000036625472",
        "cid": "JORFARTI000036625472",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000036625472",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des hôtels, cafés, restaurants du 30 avril 1997, les dispositions de :</p><p><br/>- l'avenant n° 5 du 13 octobre 2017 à l'accord du 6 octobre 2010 relatif à la mise en place d'un régime professionnel de frais de santé, conclu dans le cadre de la convention collective nationale susvisée ;<br/>- l'avenant n° 6 du 13 octobre 2017 à l'accord du 6 octobre 2010 relatif à la mise en place d'un régime professionnel de frais de santé, conclu dans le cadre de la convention collective nationale susvisée ;</p>",
        "nota": null,
