    "textAbroge": false,
    "etat": null,
    "dossiersLegislatifs": [],
    "nature": "ARRETE",
    "resume": null,
    "rectificatif": null,
    "motsCles": [],
    "appellations": [],
    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000047614626",
        "cid": "JORFARTI000047614626",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000047614626",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale du personnel au sol des entreprises de transport aérien du 22 mai 1959, tel que modifié par l'arrêté du 23 janvier 2019 susvisé, à l'exclusion des entreprises relevant de l'industrie, de la manutention et du nettoyage sur les aéroports ouverts à la circulation publique, les stipulations de l'avenant n° 98 du 24 mars 2023 relatif aux salaires 2023, à la convention collective nationale susvisée.<br/>L'article 5 est étendu sous réserve du respect des <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000006901774&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L2253-1 (M)\">dispositions du dernier alinéa de l'article L. 2253-1 du code du travail</a>.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
