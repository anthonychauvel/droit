{
  "titre": "Arrêté du 1er mars 2021 portant extension d'un avenant à la convention collective des industries métallurgiques, mécaniques et connexes d'Eure-et-Loir (n° 984)",
  "text": {
    "executionTime": 40,
    "dereferenced": false,
    "id": "JORFTEXT000043227922_01-01-2999",
