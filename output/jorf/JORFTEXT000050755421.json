{
  "titre": "Arrêté du 28 novembre 2024 portant extension d'un avenant à la convention collective nationale des entreprises de services à la personne (n° 3127)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000050755421_01-01-2999",
