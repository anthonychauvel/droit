        "path": "/JORFARTI000052576014",
        "pathTitle": [],
        "content": "<p><br/>Le redevable de la cotisation est la personne procédant à l'importation des biens mentionnés à l'article 3.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
