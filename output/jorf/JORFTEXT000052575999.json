        "pathTitle": [],
        "content": "<p><br/>Au titre des années 2025 et 2026, la cotisation s'applique aux marchandises et tarifs suivants :</p><p><div align=\"center\"><center><table border=\"1\"><tr><th><br/>Nomenclatures douanières concernées</th><th><br/>Description des biens</th><th><br/>Tarif applicable</th></tr><tr><td valign=\"middle\" align=\"left\"><br/>0201 - 0202</td><td valign=\"middle\" align=\"left\"><br/>Viande de boeuf</td><td valign=\"middle\" align=\"center\"><br/>0,30 €/kg</td></tr><tr><td valign=\"middle\" align=\"left\"><br/>0203 hors 02032915 et 02032955</td><td valign=\"middle\" align=\"left\"><br/>Viande de porc</td><td valign=\"middle\" align=\"center\"><br/>0,10 €/kg</td></tr><tr><td valign=\"middle\" align=\"left\"><br/>02032915 - 02032955</td><td align=\"left\"><br/>Poitrine et succédanés de poitrine de porc</td><td align=\"center\"><br/>0,01 €/kg</td></tr><tr><td valign=\"middle\" align=\"left\"><br/>0206</td><td valign=\"middle\" align=\"left\"><br/>Abats de boeuf</td><td valign=\"middle\" align=\"center\"><br/>0,08 €/kg</td></tr><tr><td valign=\"middle\" align=\"left\"><br/>04011010 - 04012011 - 04012091 - 04014010</td><td valign=\"middle\" align=\"left\"><br/>Lait liquide</td><td valign=\"middle\" align=\"center\"><br/>0,06 €/kg</td></tr><tr><td valign=\"middle\" align=\"left\"><br/>04029910 - 04029999</td><td align=\"left\"><br/>Lait concentré</td><td valign=\"middle\" align=\"center\"><br/>0,04 €/kg</td></tr><tr><td valign=\"middle\" align=\"left\"><br/>020810</td><td align=\"left\"><br/>Viande de lapin</td><td valign=\"middle\" align=\"center\"><br/>0,40 €/kg</td></tr></table></center></div></p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
