        "path": "/JORFARTI000052263004",
        "pathTitle": [],
        "content": "<p><br/>L'autorisation délivrée à la SARL Marche à l'Onde par décision n° 2016-549 du 22 juin 2016 est déclarée à nouveau reconductible pour une durée de cinq ans, hors appel aux candidatures.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
