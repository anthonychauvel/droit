        "notaSectionsAafficher": null,
        "multipleVersions": false
      },
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000052263005",
        "cid": "JORFARTI000052263005",
        "intOrdre": 1048574,
        "etat": "VIGUEUR",
        "num": "2",
        "path": "/JORFARTI000052263005",
        "pathTitle": [],
        "content": "<p><br/>A défaut d'accord sur les termes de la convention entre l'Autorité de régulation de la communication audiovisuelle et numérique et le titulaire au plus tard le 28 décembre 2025, les autorisations correspondantes ne pourront pas être reconduites hors appel aux candidatures. Six mois avant la date d'expiration de cette autorisation, l'ARCOM se prononcera définitivement sur sa reconduction.</p>",
        "nota": null,
        "comporteLiens": false,
