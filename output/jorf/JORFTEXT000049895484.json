    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000049895487",
        "cid": "JORFARTI000049895487",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000049895487",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application professionnel de la convention collective nationale des fleuristes, de la vente et des services des animaux familiers du 21 janvier 1997, les stipulations de l'accord du 22 janvier 2024 relatif à la mise en place d'un observatoire prospectif paritaire des métiers et des qualifications, conclu dans le cadre de convention collective nationale susvisée.</p>",
        "nota": null,
