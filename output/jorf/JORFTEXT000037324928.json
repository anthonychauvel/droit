{
  "titre": "Arrêté du 17 août 2018 portant extension d'un avenant à la convention collective nationale des personnels des ports de plaisance (n° 1182)",
  "text": {
    "executionTime": 22,
    "dereferenced": false,
    "id": "JORFTEXT000037324928_01-01-2999",
