    "resume": null,
    "rectificatif": null,
    "motsCles": [],
    "appellations": [],
    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000037881099",
        "cid": "JORFARTI000037881099",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000037881099",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective des industries métallurgiques et industries connexes de Vaucluse du 20 janvier 1976, à l'exclusion de la réparation d'appareils électriques pour le ménage non associée à un magasin de vente, les dispositions de l'avenant n° 68 du 14 décembre 2017 relatif à la valeur du point et aux taux garantis annuels (1 annexe), à la convention collective susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
