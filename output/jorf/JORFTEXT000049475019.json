{
  "titre": "Arrêté du 15 avril 2024 portant extension d'un accord conclu dans le cadre de la convention collective nationale de la distribution directe (n° 2372)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000049475019_01-01-2999",
