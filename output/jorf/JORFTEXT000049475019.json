    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000049475023",
        "cid": "JORFARTI000049475023",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000049475023",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale de la distribution directe du 9 février 2004, les stipulations de l'accord NAO 2023 du 7 septembre 2023, conclu dans le cadre de la convention collective nationale susvisée.<br/>L'avenant est étendu sous réserve de l'application des dispositions règlementaires portant fixation du salaire minimum interprofessionnel de croissance.<br/>A défaut d'accord prévu à l'<a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000006901742&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L2241-5\">article L. 2241-5 du code du travail</a>, précisant la périodicité, les thèmes et les modalités de négociation dans cette branche, l'accord est étendu sous réserve du respect de l'obligation de prendre en compte lors de la négociation sur les salaires, l'objectif d'égalité professionnelle entre les femmes et les hommes ainsi que les mesures permettant de l'atteindre, en application des dispositions des <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000006901746&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L2241-8\">articles L. 2241-8</a> et <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000035610798&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L2241-17\">L. 2241-17 du code du travail</a>.</p>",
        "nota": null,
