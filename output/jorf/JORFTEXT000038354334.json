{
  "titre": "Arrêté du 2 avril 2019 portant extension d'avenants à la convention collective nationale du sport (n° 2511)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000038354334_01-01-2999",
