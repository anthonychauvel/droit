    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000049358844",
        "cid": "JORFARTI000049358844",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000049358844",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de l'accord national professionnel n° 2005-03 du 18 février 2005 conclu dans le secteur sanitaire, social et médico-social privé à but non lucratif, les stipulations de l'accord du secteur des activités sanitaires, sociales et médico-sociales privé à but non lucratif n° 2023-01 du 17 octobre 2023 visant à établir la liste des métiers et activités considérés comme particulièrement exposés aux facteurs de risques professionnels mentionnés au 1° du I de l'<a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000028495726&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L4161-1\">article L. 4161-1 du code du travail</a>, conclu dans le cadre de l'accord national susvisé.</p>",
        "nota": null,
