    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000034329378",
        "cid": "JORFARTI000034329378",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000034329378",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective des ateliers et chantiers d'insertion du 31 mars 2011 à l'exclusion des entités soumises à agrément au sens de l'<a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006074069&idArticle=LEGIARTI000006797523&dateTexte=&categorieLien=cid\" title=\"Code de l'action sociale et des familles - art. L314-6 (V)\">article L. 314-6 du code de l'action sociale et des familles</a>, modifié par la loi n° 2008-130 du 17 décembre 2008, les dispositions de l'avenant n° 12 du 8 octobre 2013 relatif au Titre II - Liberté et dialogue social, à la convention collective susvisée.</p>",
        "nota": null,
