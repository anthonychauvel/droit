    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000051392157",
        "cid": "JORFARTI000051392157",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000051392157",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application étendu de la convention collective nationale des pompes funèbres du 1er mars 1974, les stipulations de l'avenant du 14 janvier 2025 à l'accord du 1er décembre 2020 relatif à la mise en place de la CPPNI, à l'organisation et aux moyens accordés au dialogue social, conclu dans le cadre de la convention collective susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
