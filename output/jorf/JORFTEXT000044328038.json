{
  "titre": "Arrêté du 10 novembre 2021 portant extension d'un avenant à un accord conclu dans le cadre de la convention collective nationale de l'enseignement privé indépendant (n° 2691)",
  "text": {
    "executionTime": 13,
    "dereferenced": false,
    "id": "JORFTEXT000044328038_01-01-2999",
