    "textAbroge": false,
    "etat": null,
    "dossiersLegislatifs": [],
    "nature": "ARRETE",
    "resume": null,
    "rectificatif": null,
    "motsCles": [],
    "appellations": [],
    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000045551516",
        "cid": "JORFARTI000045551516",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000045551516",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dan leur propre champ d'application, les stipulations de l'accord du 10 novembre 2021 relatif au fonctionnement dématérialisé des réunions paritaires, conclu dans le secteur des industries de carrières et matériaux de construction et de la chaux.</p>",
        "nota": null,
