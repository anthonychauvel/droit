    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000042529425",
        "cid": "JORFARTI000042529425",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000042529425",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale du bricolage du 30 septembre 1991, les stipulations de l'avenant n° 2 du 16 janvier 2019 à l'accord du 18 mars 2010 relatif à la participation des représentants syndicaux et à l'indemnisation des frais de déplacement lors des réunions paritaires de branche, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
