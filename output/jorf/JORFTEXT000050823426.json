{
  "titre": "Arrêté du 13 décembre 2024 portant extension d'un avenant à la convention collective nationale des entreprises du commerce à distance (n° 2198)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000050823426_01-01-2999",
