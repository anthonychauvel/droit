    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000043360387",
        "cid": "JORFARTI000043360387",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000043360387",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale de la fabrication et le commerce des produits à usage pharmaceutique, parapharmaceutique et vétérinaire du 1er juin 1989, tel qu'étendu par arrêté du 20 avril 1990, les stipulations de l'accord du 15 mai 2019 relatif aux salariés en situation de handicap, conclu dans le cadre de la convention collective nationale susvisée.<br/>L'article XI est étendu sous réserve du respect des <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000006901775&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L2253-2 (M)\">dispositions de l'article L. 2253-2 du code du travail</a>.</p>",
        "nota": null,
        "comporteLiens": true,
