    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000044127329",
        "cid": "JORFARTI000044127329",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000044127329",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale de la coopération maritime du 7 décembre 2004, les stipulations de l'accord du 27 janvier 2021 relatif au contrat intermittent, conclu dans le cadre de la convention collective susvisée.</p>",
        "nota": null,
