{
  "titre": "Arrêté du 13 février 2019 portant extension d'un avenant à la convention collective nationale de la cordonnerie multiservice (n° 1561)",
  "text": {
    "executionTime": 7,
    "dereferenced": false,
    "id": "JORFTEXT000038149818_01-01-2999",
