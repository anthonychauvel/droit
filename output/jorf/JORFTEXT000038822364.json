    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000038822367",
        "cid": "JORFARTI000038822367",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000038822367",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application professionnel de la convention collective nationale des employés, techniciens et agents de maîtrise (ETAM) des travaux publics du 12 juillet 2006, et dans son propre champ d'application territorial, les dispositions de l'accord territorial (Rhône-Alpes) du 4 décembre 2018 portant fixation du barème des salaires minima hiérarchiques, conclu dans le cadre de la convention collective susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
