    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000049079360",
        "cid": "JORFARTI000049079360",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000049079360",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale de la fabrication et le commerce des produits à usage pharmaceutique, parapharmaceutique et vétérinaire du 1er juin 1989, les stipulations de l'avenant n° 2 du 24 novembre 2021 portant révision de l'accord du 14 décembre 2016 relatif au régime conventionnel de prévoyance, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
