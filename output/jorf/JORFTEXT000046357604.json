    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000046357608",
        "cid": "JORFARTI000046357608",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000046357608",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale du commerce de détail et de gros à prédominance alimentaire du 12 juillet 2001, les stipulations de l'avenant n° 2 du 9 juin 2022 à l'accord du 5 mai 2020 portant mise en œuvre de la réforme de la formation professionnelle sur la reconversion ou promotion par alternance (PRO-A), conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
