    "dateFinVersion": "2999-01-01",
    "signers": "<p align=\"left\"><br/>Fait le 3 février 2026.</p><p align=\"left\"><br/>Pour le ministre et par délégation :<br/>Le directeur général du travail,<br/>P. Ramain</p>",
