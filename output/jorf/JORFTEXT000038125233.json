{
  "titre": "Arrêté du 8 février 2019 portant extension d'un avenant à la convention collective nationale des mareyeurs-expéditeurs (n° 1589)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000038125233_01-01-2999",
