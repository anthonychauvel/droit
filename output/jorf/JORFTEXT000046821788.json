    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000046821792",
        "cid": "JORFARTI000046821792",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000046821792",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale de la restauration rapide du 24 novembre 1988, les stipulations de l'avenant n° 63 du 30 septembre 2022 relatif aux minima conventionnels et à l'indemnité de blanchissage, à la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
