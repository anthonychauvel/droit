{
  "titre": "Arrêté du 27 mars 2019 portant extension d'un avenant à la convention collective nationale de la transformation des grains (n° 1930)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000038334547_01-01-2999",
