    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000050317727",
        "cid": "JORFARTI000050317727",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000050317727",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale de l'industrie de la chaussure et des articles chaussants du 7 mars 1990, les stipulations de l'accord du 21 juin 2024 relatif à la protection sociale complémentaire, à la convention collective nationale susvisée.</p>",
