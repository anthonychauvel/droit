{
  "titre": "Arrêté du 15 février 2019 portant extension d'un avenant à la convention collective nationale de la production cinématographique (n° 3097)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000038150314_01-01-2999",
