        "infosRestructurationBranche": null,
        "infosRestructurationBrancheHtml": null,
        "dateDebut": 32472144000000,
        "dateFin": 32472144000000,
        "notaSectionsAafficher": null,
        "multipleVersions": true
      },
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000046242452",
        "cid": "JORFARTI000046242452",
        "intOrdre": 1048574,
        "etat": "VIGUEUR",
        "num": "2",
        "path": "/JORFARTI000046242452",
        "pathTitle": [],
        "content": "<p><br/>Les niveaux de prise en charge applicables aux contrats d'apprentissage conclus en vue de l'obtention de l'une des certifications figurant à l'annexe II sont ceux applicables à ces certifications antérieurement à la date d'entrée en vigueur du présent arrêté.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
        "type": "AUTONOME",
