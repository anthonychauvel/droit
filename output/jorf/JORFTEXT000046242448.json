        "dateDebut": 32472144000000,
        "dateFin": 32472144000000,
        "notaSectionsAafficher": null,
        "multipleVersions": true
      },
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000046242453",
        "cid": "JORFARTI000046242453",
        "intOrdre": 1572861,
        "etat": "VIGUEUR",
        "num": "3",
        "path": "/JORFARTI000046242453",
        "pathTitle": [],
        "content": "<p><br/>Les niveaux de prise en charge déterminés en application des articles D. 6332-78-1, D. 6332-78-2 et D. 6332-79 s'appliquent aux contrats d'apprentissage conclus à compter du 1er septembre 2022, sous réserve des dispositions prévues à l'article D. 6332-80.</p>",
        "nota": null,
        "comporteLiens": false,
