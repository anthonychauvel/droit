{
  "titre": "Arrêté du 8 février 2019 portant extension d'un accord conclu dans le cadre de la convention collective nationale de la radiodiffusion (n° 1922)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000038125167_01-01-2999",
