    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000044376892",
        "cid": "JORFARTI000044376892",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000044376892",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des organismes de formation du 10 juin 1988, les stipulations de l'avenant du 9 juin 2021 relatif aux salaire minima conventionnels bruts de l'année 2021, à la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
