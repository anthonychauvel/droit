{
  "titre": "Arrêté du 5 novembre 2025 portant extension d'un avenant à la convention collective nationale des personnels des activités hippiques",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000052556351_01-01-2999",
