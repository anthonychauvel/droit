    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000046534624",
        "cid": "JORFARTI000046534624",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000046534624",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application professionnel de la convention collective nationale des fleuristes, de la vente et des services des animaux familiers du 21 janvier 1997, les stipulations de l'avenant n° 1 du 13 juin 2022 à l'avenant n° 13 du 4 avril 2013 à l'accord du 9 décembre 1997 relatif au fonds d'action sociale, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
