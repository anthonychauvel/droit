{
  "titre": "Arrêté du 12 juin 2017 portant extension d'un avenant à la convention collective nationale de l'industrie des cuirs et peaux (n° 207)",
  "text": {
    "executionTime": 7,
    "dereferenced": false,
    "id": "JORFTEXT000034983350_01-01-2999",
