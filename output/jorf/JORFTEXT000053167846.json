{
  "titre": "Arrêté du 11 décembre 2025 portant extension d'un accord conclu dans le cadre de la convention collective nationale de la plasturgie (n° 292)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000053167846_01-01-2999",
