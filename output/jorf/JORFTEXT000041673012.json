    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000041673016",
        "cid": "JORFARTI000041673016",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000041673016",
        "pathTitle": [],
        "content": "<p><br/>Ne sont pas soumis aux <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000033406943&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. R5315-12 (V)\">dispositions du premier alinéa de l'article R. 5315-12 du code du travail</a> les projets de cession, d'apport ou de création de sûreté portant sur des biens meubles appartenant à l'établissement public chargé de la formation professionnelle des adultes mentionné à l'<a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000031073619&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L5315-1 (V)\">article L. 5315-1 du code du travail</a>, et nécessaires à la bonne exécution de ses missions de service public ou au développement de celles-ci, lorsqu'ils portent sur des biens dont la valeur nette comptable est inférieure à :<br/>a) 150 000 € pour les opérations de cession ;<br/>b) 1 000 000 € pour les opérations d'apports ;<br/>c) 1 000 000 € pour les créations de sûreté.<br/>Ces seuils s'apprécient par bien meuble.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
        "type": "AUTONOME",
