{
  "titre": "Arrêté du 1er juillet 2025 portant extension d'un avenant à un avenant à la convention collective nationale des distributeurs conseils hors domicile (n° 1536)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000051863150_01-01-2999",
