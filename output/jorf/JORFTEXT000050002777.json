    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000050002784",
        "cid": "JORFARTI000050002784",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000050002784",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de l'accord du 22 novembre 2023 relatif aux listes de métiers exposés à des risques ergonomiques au sein de la branche des industries électriques et gazières, les stipulations dudit accord susvisé ainsi que les stipulations de l'avenant du 15 avril 2024 susvisé.</p>",
        "nota": null,
        "comporteLiens": false,
