    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000041616191",
        "cid": "JORFARTI000041616191",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000041616191",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des entreprises de commission, de courtage et de commerce intracommunautaire et d'importation-exportation du 18 décembre 1952, tel que modifié par l'arrêté du 28 avril 2017 portant fusion des champs conventionnels, les dispositions de l'accord du 25 octobre 2018 relatif à la fusion de la convention collective du commerce des machines à coudre avec la convention collective nationale des entreprises de commission, de courtage et de commerce intracommunautaire et d'importation-exportation, conclu dans le cadre de la convention collective susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
