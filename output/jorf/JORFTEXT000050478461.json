{
  "titre": "Arrêté du 5 novembre 2024 portant extension d'un avenant à la convention collective nationale des hôtels, cafés, restaurants (n° 1979)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000050478461_01-01-2999",
