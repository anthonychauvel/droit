{
  "titre": "Arrêté du 29 avril 2021 portant extension d'un avenant à la convention collective nationale des espaces de loisirs, d'attractions et culturels (n° 1790)",
  "text": {
    "executionTime": 6,
    "dereferenced": false,
    "id": "JORFTEXT000043490596_01-01-2999",
