{
  "titre": "Arrêté du 1er juillet 2026 portant extension d'un accord conclu dans le cadre de la convention collective nationale de la métallurgie (n° 3248)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000054408762_01-01-2999",
