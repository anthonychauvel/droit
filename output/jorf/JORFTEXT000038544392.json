{
  "titre": "Arrêté du 29 mai 2019 portant extension d'un avenant à la convention collective nationale des cinq branches des industries alimentaires diverses (n° 3109)",
  "text": {
    "executionTime": 10,
    "dereferenced": false,
    "id": "JORFTEXT000038544392_01-01-2999",
