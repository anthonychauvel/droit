    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000046719786",
        "cid": "JORFARTI000046719786",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000046719786",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective des industries métallurgiques, mécaniques, électriques et connexes de l'Yonne du 11 mars 1993, les stipulations de l'avenant du 20 septembre 2022 relatif aux salaires, à la convention collective susvisée.</p>",
