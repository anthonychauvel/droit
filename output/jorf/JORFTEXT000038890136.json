{
  "titre": "Arrêté du 26 juillet 2019 portant extension d'un avenant à la convention collective nationale des entreprises d'architecture (n° 2332)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000038890136_01-01-2999",
