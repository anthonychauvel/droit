{
  "titre": "Arrêté du 26 décembre 2018 portant extension d'un avenant à la convention collective nationale des entreprises du secteur privé du spectacle vivant (n° 3090)",
  "text": {
    "executionTime": 5,
    "dereferenced": false,
    "id": "JORFTEXT000037881049_01-01-2999",
