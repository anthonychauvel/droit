    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000050771700",
        "cid": "JORFARTI000050771700",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000050771700",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des coopératives de consommateurs salariés du 16 octobre 2014, les stipulations de l'avenant n° 1 du 27 septembre 2024 à l'accord relatif à la prévoyance du 20 juin 2019, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
