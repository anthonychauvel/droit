{
  "titre": "Arrêté du 27 décembre 2018 portant extension d'un avenant à la convention collective nationale des avocats salariés (n° 1850)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000037885340_01-01-2999",
