{
  "titre": "Arrêté du 15 janvier 2020 portant extension d'un avenant à un accord conclu dans le cadre de la convention collective nationale de l'édition phonographique (n° 2770)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000041439332_01-01-2999",
