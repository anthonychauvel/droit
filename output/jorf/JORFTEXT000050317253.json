{
  "titre": "Arrêté du 24 septembre 2024 portant extension d'un accord conclu dans le cadre de la convention collective nationale de la pharmacie d'officine (n° 1996)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000050317253_01-01-2999",
