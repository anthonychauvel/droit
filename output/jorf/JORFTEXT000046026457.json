    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000046026461",
        "cid": "JORFARTI000046026461",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000046026461",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des cinq branches des industries alimentaires du 21 mars 2012, les stipulations de l'avenant n° 16 du 21 janvier 2022 relatif aux salaires, à la convention collective nationale susvisée.<br/>L'avenant est étendu sous réserve de l'application des dispositions règlementaires portant fixation du salaire minimum interprofessionnel de croissance.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
