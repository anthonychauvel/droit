{
  "titre": "Arrêté du 20 juin 2022 portant extension d'un avenant à la convention collective nationale des 5 branches des industries alimentaires diverses (n° 3109)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000046026457_01-01-2999",
