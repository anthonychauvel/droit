{
  "titre": "Arrêté du 13 décembre 2024 portant extension d'un avenant à la convention collective nationale des maisons d'étudiants (n° 1671)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000050823306_01-01-2999",
