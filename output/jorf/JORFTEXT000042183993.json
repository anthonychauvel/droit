    "appellations": [],
    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000042183997",
        "cid": "JORFARTI000042183997",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000042183997",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des remontées mécaniques et domaines skiables du 15 mai 1968, les stipulations de l'avenant n° 71 du 28 novembre 2019 relatif aux rémunérations minimales hiérarchiques, à la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
