{
  "titre": "Arrêté du 22 septembre 2023 portant extension d'un avenant à la convention collective nationale des employés, techniciens et cadres des agences de presse (IDCC 3221)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000048152095_01-01-2999",
