{
  "titre": "Arrêté du 23 décembre 2019 portant extension d'un accord conclu dans le cadre de la convention collective nationale des entreprises artistiques et culturelles (n° 1285)",
  "text": {
    "executionTime": 24,
    "dereferenced": false,
    "id": "JORFTEXT000039804460_01-01-2999",
