        "multipleVersions": true
      },
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000034581414",
        "cid": "JORFARTI000034581414",
        "intOrdre": 1048574,
        "etat": "VIGUEUR",
        "num": "2",
        "path": "/JORFARTI000034581414",
        "pathTitle": [],
        "content": "<p><br/>L'article L. 223-27 est ainsi modifié :<br/>1° La dernière phrase du quatrième alinéa est supprimée ; <br/>2° Après le quatrième alinéa, sont insérés deux alinéas ainsi rédigés : <br/>« Un ou plusieurs associés détenant le vingtième des parts sociales ont la faculté de faire inscrire à l'ordre du jour de l'assemblée des points ou projets de résolution qui sont portés à la connaissance des autres associés, dans les conditions déterminées par décret en Conseil d'Etat. <br/>« Toute clause contraire aux dispositions des deux alinéas précédents est réputée non écrite. »</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
        "type": "ENTIEREMENT_MODIF",
        "lstLienModification": [],
        "lstLienCitation": [],
        "conditionDiffere": null,
        "historique": null,
        "surtitre": null,
        "renvoi": null,
        "versionLabel": null,
        "infosComplementaires": null,
        "infosComplementairesHtml": null,
        "infosRestructurationBranche": null,
        "infosRestructurationBrancheHtml": null,
        "dateDebut": 32472144000000,
        "dateFin": 32472144000000,
        "notaSectionsAafficher": null,
        "multipleVersions": true
      },
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000034581415",
        "cid": "JORFARTI000034581415",
        "intOrdre": 1572861,
        "etat": "VIGUEUR",
        "num": "3",
        "path": "/JORFARTI000034581415",
        "pathTitle": [],
        "content": "<p><br/>Après l'article L. 225-103, il est inséré un article L. 225-103-1 ainsi rédigé : </p><p><br/>« Art. L. 225-103-1.-Dans les sociétés dont les actions ne sont pas admises aux négociations sur un marché réglementé, les statuts peuvent prévoir que, sans préjudice des dispositions du I de l'article L. 225-107, les assemblées générales extraordinaires mentionnées à l'article L. 225-96 et les assemblées générales ordinaires mentionnées à l'article L. 225-98 sont tenues exclusivement par visioconférence ou par des moyens de télécommunication permettant l'identification des actionnaires. <br/>« Toutefois, pour chaque assemblée générale, un ou plusieurs actionnaires représentant au moins 5 % du capital social peuvent s'opposer à ce qu'il soit recouru exclusivement aux modalités de participation à l'assemblée définies au premier alinéa. <br/>« Les conditions d'application du présent article sont précisées par décret en Conseil d'Etat. »</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
        "type": "ENTIEREMENT_MODIF",
        "lstLienModification": [],
        "lstLienCitation": [],
