        "pathTitle": [],
        "content": "<p><br/>Les livres II et IX du code de commerce sont modifiés conformément aux articles 2 à 6.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
        "type": "AUTONOME",
        "lstLienModification": [],
