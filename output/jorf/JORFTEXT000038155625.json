{
  "titre": "Arrêté du 13 février 2019 portant extension d'un avenant à la convention collective régionale de l'industrie du bois de pin maritime en forêt de Gascogne (n° 172)",
  "text": {
    "executionTime": 37,
    "dereferenced": false,
    "id": "JORFTEXT000038155625_01-01-2999",
