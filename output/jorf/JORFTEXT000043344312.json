{
  "titre": "Arrêté du 2 avril 2021 portant extension d'un avenant à un accord conclu dans le cadre de la convention collective nationale du bricolage (n° 1606)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000043344312_01-01-2999",
