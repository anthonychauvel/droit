{
  "titre": "Arrêté du 11 janvier 2018 portant extension d'un accord conclu dans le cadre de la convention collective nationale pour le personnel des entreprises de reprographie (n° 706)",
  "text": {
    "executionTime": 17,
    "dereferenced": false,
    "id": "JORFTEXT000036505263_01-01-2999",
