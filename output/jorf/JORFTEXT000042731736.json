    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000042731740",
        "cid": "JORFARTI000042731740",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000042731740",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale du commerce des articles de sport et équipements de loisirs tel que modifié par l'arrêté du 15 février 2019 susvisé, et dans leur propre champ d'application professionnel, les stipulations de l'avenant du 28 novembre 2019 à l'accord du 26 septembre 2001 portant création d'une Commission paritaire nationale de l'emploi et de la formation professionnelle (CPNEFP), conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
