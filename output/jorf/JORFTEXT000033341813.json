        "num": "3",
        "path": "/JORFARTI000033341818",
        "pathTitle": [],
        "content": "<p><br/>Les informations et les données à caractère personnel enregistrées dans le traitement sont conservées six ans à compter de la saisie par le professionnel de santé ou fournisseur de grand appareillage.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
