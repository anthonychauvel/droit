    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000050076901",
        "cid": "JORFARTI000050076901",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000050076901",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés des établissements d'accueil du jeune enfant (EAJE) relevant de la Prestation de Service Unique (PSU) et soumis à la convention collective nationale de la mutualité du 31 janvier 2000, les stipulations de l'accord du 11 juin 2024 relatif à l'attribution d'une indemnité forfaitaire dans les établissements d'accueil du jeune enfant (EAJE) relevant de la Prestation de Service Unique (PSU), conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
