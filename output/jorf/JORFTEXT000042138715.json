{
  "titre": "Arrêté du 10 juillet 2020 portant extension d'un avenant à la convention collective nationale de l'immobilier (n° 1527)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000042138715_01-01-2999",
