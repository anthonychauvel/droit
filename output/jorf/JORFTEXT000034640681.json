{
  "titre": "Arrêté du 28 avril 2017 portant extension d'un avenant à la convention collective nationale des laboratoires d'analyses médicales extra-hospitaliers (n° 959)",
  "text": {
    "executionTime": 9,
    "dereferenced": false,
    "id": "JORFTEXT000034640681_01-01-2999",
