        "num": "2",
        "path": "/JORFARTI000048347086",
        "pathTitle": [],
        "content": "<p><br/>L'indemnisation horaire des interventions pendant les périodes d'astreinte est de :</p><p><br/>a) 7,20 euros pour une intervention effectuée un jour de semaine ;<br/>b) 9,9 euros pour une intervention effectuée une nuit.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
        "type": "AUTONOME",
        "lstLienModification": [],
        "lstLienCitation": [],
        "conditionDiffere": null,
