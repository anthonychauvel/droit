        "num": "1",
        "path": "/JORFARTI000048347084",
        "pathTitle": [],
        "content": "<p><br/>Les montants de l'indemnité d'astreinte allouée aux personnes détenues mentionnées aux <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000045476241&idArticle=LEGIARTI000045661449&dateTexte=&categorieLien=cid\" title=\"Code pénitentiaire - art. R412-57 (VD)\">articles R. 412-57 à R. 412-60 du code pénitentiaire</a> sont fixés conformément aux dispositions suivantes :</p><p><div align=\"center\"><center><table border=\"1\"><tr><th><br/>Période d'astreinte</th><th><br/>Montant</th></tr><tr><td align=\"justify\"><br/>Semaine complète</td><td align=\"justify\"><br/>71,60 euros</td></tr><tr><td align=\"justify\"><br/>Jour</td><td align=\"justify\"><br/>4,80 euros</td></tr><tr><td align=\"justify\"><br/>Nuit</td><td align=\"justify\"><br/>4,80 euros</td></tr></table></center></div></p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
        "type": "AUTONOME",
        "lstLienModification": [],
        "lstLienCitation": [],
        "conditionDiffere": null,
