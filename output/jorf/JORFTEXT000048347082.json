        "surtitre": null,
        "renvoi": null,
        "versionLabel": null,
        "infosComplementaires": null,
        "infosComplementairesHtml": null,
        "infosRestructurationBranche": null,
        "infosRestructurationBrancheHtml": null,
        "dateDebut": 32472144000000,
        "dateFin": 32472144000000,
        "notaSectionsAafficher": null,
        "multipleVersions": false
      },
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000048347087",
        "cid": "JORFARTI000048347087",
        "intOrdre": 1572861,
        "etat": "VIGUEUR",
        "num": "3",
        "path": "/JORFARTI000048347087",
        "pathTitle": [],
        "content": "<p><br/>Le montant annuel maximum versé à chaque personne détenue au titre des indemnisations versées en application de articles 1er et 2 du présent arrêté est fixé à 1 125 euros.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
