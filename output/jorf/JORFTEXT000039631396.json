{
  "titre": "Arrêté du 3 décembre 2019 portant extension d'avenants à la convention collective nationale de l'enseignement privé indépendant (n° 2691)",
  "text": {
    "executionTime": 12,
    "dereferenced": false,
    "id": "JORFTEXT000039631396_01-01-2999",
