        "path": "/JORFARTI000052950287",
        "pathTitle": [],
        "content": "<p><br/>Sont reconnues représentatives dans la convention collective nationale des entreprises au service de la création et de l'évènement (IDCC n° 3252), les organisations syndicales suivantes :</p><p><br/>- la Confédération française démocratique du travail (CFDT) ;<br/>- la Confédération générale du travail (CGT) ;<br/>- la Confédération générale du travail-Force ouvrière (CGT-FO) ;<br/>- la Confédération française des travailleurs chrétiens (CFTC).</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
