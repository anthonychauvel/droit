{
  "titre": "Arrêté du 17 février 2020 portant extension d'un avenant à la convention collective nationale du sport (n° 2511)",
  "text": {
    "executionTime": 6,
    "dereferenced": false,
    "id": "JORFTEXT000041616291_01-01-2999",
