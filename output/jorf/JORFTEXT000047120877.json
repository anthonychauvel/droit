{
  "titre": "Arrêté du 3 février 2023 portant extension d'un avenant à la convention collective nationale du sport (n° 2511)",
  "text": {
    "executionTime": 22,
    "dereferenced": false,
    "id": "JORFTEXT000047120877_01-01-2999",
