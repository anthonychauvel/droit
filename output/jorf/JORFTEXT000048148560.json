    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000048148564",
        "cid": "JORFARTI000048148564",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000048148564",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective des industries métallurgiques de la Corrèze du 30 septembre 1983, les stipulations de l'avenant n° 80 du 6 juillet 2023 à l'avenant n° 79 du 19 janvier 2023 relatif aux salaires, à la convention collective susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
