{
  "titre": "Arrêté du 2 juillet 2018 portant extension d'un accord conclu dans le cadre de la convention collective nationale de l'horlogerie (n° 1044)",
  "text": {
    "executionTime": 13,
    "dereferenced": false,
    "id": "JORFTEXT000037160998_01-01-2999",
