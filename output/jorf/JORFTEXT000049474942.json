{
  "titre": "Arrêté du 15 avril 2024 portant extension d'un avenant à la convention collective nationale des gardiens, concierges et employés d'immeubles (n° 1043)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000049474942_01-01-2999",
