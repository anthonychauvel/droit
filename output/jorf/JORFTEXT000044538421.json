{
  "titre": "Arrêté du 10 décembre 2021 portant extension d'un avenant à la convention collective nationale des commerces de détail non alimentaires (n° 1517)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000044538421_01-01-2999",
