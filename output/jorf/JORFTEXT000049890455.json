{
  "titre": "Arrêté du 24 juin 2024 portant extension d'un avenant à la convention collective nationale du portage de presse (n° 2683)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000049890455_01-01-2999",
