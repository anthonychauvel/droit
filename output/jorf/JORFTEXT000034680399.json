{
  "titre": "Arrêté du 5 mai 2017 portant extension d'un avenant à la convention collective nationale des personnels des ports de plaisance (n° 1182)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000034680399_01-01-2999",
