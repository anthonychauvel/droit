{
  "titre": "Arrêté du 21 novembre 2023 portant extension d'un avenant à la convention collective nationale des caves coopératives vinicoles et leurs unions",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000048459070_01-01-2999",
