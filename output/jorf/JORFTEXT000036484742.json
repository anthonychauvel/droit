        "notaSectionsAafficher": null,
        "multipleVersions": false
      },
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000036484750",
        "cid": "JORFARTI000036484750",
        "intOrdre": 1572861,
        "etat": "VIGUEUR",
        "num": "3",
        "path": "/JORFARTI000036484750",
        "pathTitle": [],
        "content": "<p><br/>Le coût moyen du suivi individuel de l'état de santé d'un salarié agricole est fixé au début de chaque année sur la base des résultats du dernier exercice comptable connu, en divisant le montant total des cotisations perçues des employeurs de main-d'œuvre pour leurs salariés par le nombre de salariés agricoles ayant travaillé cette même année quarante jours et plus.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
