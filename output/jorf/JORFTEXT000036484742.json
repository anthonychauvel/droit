      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000036484747",
        "cid": "JORFARTI000036484747",
        "intOrdre": 1048574,
        "etat": "VIGUEUR",
        "num": "2",
        "path": "/JORFARTI000036484747",
        "pathTitle": [],
        "content": "<p><br/>Le montant de la participation annuelle par travailleur dû par l'entreprise utilisatrice pour le suivi individuel renforcé de l'état de santé réalisé en application des articles <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006071367&idArticle=LEGIARTI000035478911&dateTexte=&categorieLien=cid\" title=\"Code rural et de la pêche maritime - art. R717-26-4 (V)\">R. 717-26-4</a> et <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006071367&idArticle=LEGIARTI000035478913&dateTexte=&categorieLien=cid\" title=\"Code rural et de la pêche maritime - art. R717-26-5 (V)\">R. 717-26-5</a> du code rural et de la pêche maritime est égal à deux tiers du coût moyen du suivi individuel de l'état de santé d'un salarié agricole.<br/>Les examens de pré-reprise et à la demande ne sont pas réalisés par le médecin du travail de l'entreprise utilisatrice.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
        "type": "AUTONOME",
        "lstLienModification": [],
        "lstLienCitation": [],
        "conditionDiffere": null,
        "historique": null,
        "surtitre": null,
        "renvoi": null,
        "versionLabel": null,
        "infosComplementaires": null,
        "infosComplementairesHtml": null,
        "infosRestructurationBranche": null,
        "infosRestructurationBrancheHtml": null,
        "dateDebut": 32472144000000,
