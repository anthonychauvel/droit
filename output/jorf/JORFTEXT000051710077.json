    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000051710080",
        "cid": "JORFARTI000051710080",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000051710080",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale du bricolage du 30 septembre 1991, les stipulations de l'avenant n° 1 du 18 décembre 2024 à l'accord du 11 décembre 2018 relatif à la prévoyance, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
