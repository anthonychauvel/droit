    "cid": "JORFTEXT000039416353",
    "title": "Arrêté du 18 novembre 2019 portant extension d'un avenant à la convention collective nationale des entreprises du paysage (n° 7018)",
    "nor": "AGRS1933117A",
    "eli": null,
