{
  "titre": "Arrêté du 18 novembre 2019 portant extension d'un avenant à la convention collective nationale des entreprises du paysage (n° 7018)",
  "text": {
    "executionTime": 26,
    "dereferenced": false,
    "id": "JORFTEXT000039416353_01-01-2999",
