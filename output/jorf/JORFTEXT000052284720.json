{
  "titre": "Arrêté du 18 septembre 2025 portant extension d'un avenant à la convention collective nationale de l'optique-lunetterie de détail (n° 1431)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000052284720_01-01-2999",
