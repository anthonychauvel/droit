    "jurisState": "Sans état juridique",
    "visa": "<p align=\"left\"><br/>Le ministre de l'économie, des finances et de la souveraineté industrielle et numérique,<br/>Vu l'<a href=\"/affichTexteArticle.do?cidTexte=JORFTEXT000000753121&idArticle=LEGIARTI000006319941&dateTexte=19971230&categorieLien=cid\" title=\"Loi n° 97-1239 du 29 décembre 1997 - art. 41 (M)\">article 41 de la loi n° 97-1239 du 29 décembre 1997</a> (loi de finances rectificative pour 1997),<br/>Arrête :</p>",
    "modifDate": null,
    "jurisDate": null,
    "dateDebutVersion": "2999-01-01",
    "dateFinVersion": "2999-01-01",
    "signers": "<p align=\"left\"><br/>Fait le 16 décembre 2022.</p><p align=\"left\"><br/>Pour le ministre et par délégation :<br/>Le directeur général du Trésor,<br/>E. Moulin</p>",
    "prepWork": "",
