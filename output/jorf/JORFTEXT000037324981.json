    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000037324985",
        "cid": "JORFARTI000037324985",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000037324985",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective des industries métallurgiques de la Corrèze du 30 septembre 1983, et à l'exclusion de la réparation d'appareils électriques pour le ménage non associée à un magasin de vente, les dispositions de l'avenant n° 74 du 11 janvier 2018 relatif aux salaires, à la convention collective susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
