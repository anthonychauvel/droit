{
  "titre": "Arrêté du 17 février 2026 portant extension d'un avenant à la convention collective nationale du commerce de détail de l'horlogerie-bijouterie (n° 1487)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000053555565_01-01-2999",
