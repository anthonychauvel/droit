{
  "titre": "Arrêté du 13 janvier 2022 portant extension d'un accord et d'un avenant conclus dans le cadre de la convention collective nationale de l'industrie textile (n° 18)",
  "text": {
    "executionTime": 11,
    "dereferenced": false,
    "id": "JORFTEXT000045076850_01-01-2999",
