    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000048567589",
        "cid": "JORFARTI000048567589",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000048567589",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des coopératives de consommateurs salariés du 16 octobre 2014, les stipulations de l'avenant n° 0924 du 3 février 2023 relatif à l'aménagement de la CCN (valorisation de l'ancienneté - amplitudes de travail - prime de transport), à la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
