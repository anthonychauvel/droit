    "textAbroge": false,
    "etat": null,
    "dossiersLegislatifs": [],
    "nature": "ARRETE",
    "resume": null,
    "rectificatif": null,
    "motsCles": [],
    "appellations": [],
    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000033702763",
        "cid": "JORFARTI000033702763",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000033702763",
        "pathTitle": [],
        "content": "<p><br/>Les délibérations portant sur un bien meuble mentionné au <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000033370861&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L5315-7 (VD)\">deuxième alinéa de l'article L. 5315-7 du code du travail</a> sont exécutoires, dans les conditions prévues au premier alinéa de l'article R. 5315-7 du même code, lorsqu'elles relèvent de l'une des catégories suivantes :<br/>1° Projet de cession d'un montant inférieur à dix-mille euros ;<br/>2° Projet d'apport d'un montant inférieur à un million euros ;<br/>3° Projet de création de sûreté d'un montant inférieur à un million euros.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
