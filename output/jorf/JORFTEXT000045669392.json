    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000045669396",
        "cid": "JORFARTI000045669396",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000045669396",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de l'accord du 23 avril 2015 relatif au champ d'application de la branche ferroviaire, les stipulations de l'accord du 6 décembre 2021 relatif aux classifications et aux rémunérations dans la branche ferroviaire.</p>",
        "nota": null,
        "comporteLiens": true,
