{
  "titre": "Arrêté du 11 décembre 2025 portant extension d'un accord conclu dans le cadre de la convention collective nationale des commerces de gros (n° 573)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000053168039_01-01-2999",
