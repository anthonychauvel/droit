{
  "titre": "Arrêté du 24 juillet 2019 portant extension d'un avenant à la convention collective nationale des télécommunications (n° 2148)",
  "text": {
    "executionTime": 15,
    "dereferenced": false,
    "id": "JORFTEXT000038851472_01-01-2999",
