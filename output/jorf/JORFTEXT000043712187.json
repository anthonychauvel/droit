{
  "titre": "Arrêté du 9 juin 2021 portant extension d'un avenant à la convention collective nationale du portage de presse (n° 2683)",
  "text": {
    "executionTime": 4,
    "dereferenced": false,
    "id": "JORFTEXT000043712187_01-01-2999",
