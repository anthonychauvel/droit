    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000038544463",
        "cid": "JORFARTI000038544463",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000038544463",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des employés, techniciens et agents de maîtrise du bâtiment du 12 juillet 2006, et dans son propre champ d'application territorial, les dispositions de l'accord régional (Pays de la Loire) du 16 novembre 2018 relatif aux appointements minimaux, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
