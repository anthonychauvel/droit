    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000048095870",
        "cid": "JORFARTI000048095870",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000048095870",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale de la boulangerie-pâtisserie (entreprises artisanales) du 19 mars 1976, les stipulations de l'avenant n° 132 du 1er juin 2023 relatif aux salaires à compter du 1er juin 2023, à la convention collective nationale susvisée.</p>",
        "nota": null,
