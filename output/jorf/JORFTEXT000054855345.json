        "path": "/JORFARTI000054855347",
        "pathTitle": [],
        "content": "<p><br/>Le montant de l'indemnité forfaitaire de transport mentionnée à l'article D. 4151-18-1 du <a href=\"/affichCode.do?cidTexte=LEGITEXT000006072665&dateTexte=&categorieLien=cid\" title=\"Code de la santé publique\">code de la santé publique</a> est fixé mensuellement à 130 euros bruts.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
