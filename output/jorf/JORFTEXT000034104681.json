        "intOrdre": 1572861,
        "etat": "VIGUEUR",
        "num": "3",
        "path": "/JORFARTI000034104686",
        "pathTitle": [],
        "content": "<p><br/>Au 4° de l'article 2, les mots : « pendant au moins deux années à temps plein ou pendant une période à temps partiel d'une durée équivalente » sont remplacés par les mots : « pendant au moins une année à temps plein ou à temps partiel, pendant une durée équivalente ».</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
        "type": "ENTIEREMENT_MODIF",
        "lstLienModification": [],
        "lstLienCitation": [],
        "conditionDiffere": null,
        "historique": null,
        "surtitre": null,
        "renvoi": null,
        "versionLabel": null,
        "infosComplementaires": null,
        "infosComplementairesHtml": null,
        "infosRestructurationBranche": null,
        "infosRestructurationBrancheHtml": null,
        "dateDebut": 32472144000000,
        "dateFin": 32472144000000,
        "notaSectionsAafficher": null,
        "multipleVersions": true
      },
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000034104688",
        "cid": "JORFARTI000034104688",
        "intOrdre": 2097148,
        "etat": "VIGUEUR",
        "num": "4",
        "path": "/JORFARTI000034104688",
        "pathTitle": [],
        "content": "<p><br/>L'article 5 est modifié ainsi qu'il suit : <br/>1° Aux 1° du I, du II et du III, les mots : « la Communauté » sont remplacés par les mots : « l'Union » ; <br/>2° Au 2° du I, les mots : « Le contenu » sont remplacés par les mots : « Si le demandeur peut en justifier, le contenu » et les mots : « ; le cas échéant, » sont remplacés par le mot : « et » ; <br/>3° Aux 3° du II et du III, les mots : « Le contenu » sont remplacés par les mots : « Si le demandeur peut en justifier, le contenu » ; <br/>4° Au 2° du III, les mots : « pendant au moins deux années à temps plein ou pendant une période à temps partiel d'une durée équivalente » sont remplacés par les mots : « à temps plein pendant au moins une année ou à temps partiel pendant une durée totale équivalente » ; <br/>5° Il est complété par un V ainsi rédigé : <br/>« V. ― Dans tous les cas, le dossier doit comporter une attestation confirmant l'absence d'interdictions temporaires ou définitives d'exercer la profession ou de condamnations pénales prévues aux articles <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006071191&idArticle=LEGIARTI000006525080&dateTexte=&categorieLien=cid\" title=\"Code de l'éducation - art. L462-5 (M)\">L. 462-5 </a>et <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006071191&idArticle=LEGIARTI000006525082&dateTexte=&categorieLien=cid\" title=\"Code de l'éducation - art. L462-6 (M)\">L. 462-6 </a>du code de l'éducation. »</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
        "type": "ENTIEREMENT_MODIF",
