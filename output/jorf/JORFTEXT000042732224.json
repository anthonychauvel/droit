{
  "titre": "Arrêté du 18 décembre 2020 portant extension d'un accord conclu dans le cadre de la convention collective nationale du notariat (n° 2205)",
  "text": {
    "executionTime": 19,
    "dereferenced": false,
    "id": "JORFTEXT000042732224_01-01-2999",
