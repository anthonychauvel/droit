{
  "titre": "Arrêté du 21 janvier 2019 portant extension d'un accord conclu dans le cadre de la convention collective nationale de l'industrie textile (n° 18)",
  "text": {
    "executionTime": 10,
    "dereferenced": false,
    "id": "JORFTEXT000038057158_01-01-2999",
