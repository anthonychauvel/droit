            "intOrdre": 1048574,
            "etat": "VIGUEUR",
            "num": "3",
            "path": "/JORFSCTA000054450618/JORFARTI000054450622",
            "pathTitle": [
              "Titre Ier : ADMISSION"
            ],
            "content": "<p><br/>En vue de l'admission aux recrutements prévus à l'article 2 ci-dessus, un jury évalue l'aptitude des candidats à suivre les enseignements et leur capacité à répondre aux besoins d'une entreprise, après examen de leurs dossiers de candidature et entretien individuel. A l'issue, ce jury établit la liste des candidats admissibles.</p>",
            "nota": null,
            "comporteLiens": false,
            "comporteLiensSP": false,
            "modificatorTitle": null,
            "modificatorCid": null,
            "modificatorDate": null,
            "articleVersion": "INITIALE",
            "type": "AUTONOME",
            "lstLienModification": [],
            "lstLienCitation": [],
            "conditionDiffere": null,
            "historique": null,
            "surtitre": null,
            "renvoi": null,
            "versionLabel": null,
