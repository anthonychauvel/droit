{
  "titre": "Arrêté du 20 novembre 2020 portant extension d'un avenant à la convention collective de la métallurgie de la Drôme-Ardèche (n° 1867)",
  "text": {
    "executionTime": 10,
    "dereferenced": false,
    "id": "JORFTEXT000042574942_01-01-2999",
