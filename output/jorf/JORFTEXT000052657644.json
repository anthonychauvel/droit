{
  "titre": "Arrêté du 7 novembre 2025 portant extension d'un avenant à un accord conclu dans le cadre de la convention collective nationale des entreprises d'architecture (n° 2332)",
  "text": {
    "executionTime": 107,
    "dereferenced": false,
    "id": "JORFTEXT000052657644_01-01-2999",
