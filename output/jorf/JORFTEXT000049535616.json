        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000049535622",
        "pathTitle": [],
        "content": "<p><br/>Au premier alinéa de l'<a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006073189&idArticle=LEGIARTI000031806212&dateTexte=&categorieLien=cid\" title=\"Code de la sécurité sociale. - art. D160-6\">article D. 160-6 du code de la sécurité sociale</a>, le nombre : « 50 » est remplacé par le nombre : « 25 ».</p>",
        "nota": null,
        "comporteLiens": true,
