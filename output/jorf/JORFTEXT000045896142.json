    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000045896144",
        "cid": "JORFARTI000045896144",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000045896144",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale du personnel des prestataires de services dans le domaine du secteur tertiaire du 13 août 1999, les stipulations de l'avenant du 13 décembre 2021 relatif aux contributions des entreprises à la formation professionnelle continue, à la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
