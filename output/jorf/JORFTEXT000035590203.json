        "intOrdre": 1048574,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000035590208",
        "pathTitle": [],
        "content": "<p><br/>La participation de l'assuré prévue au I de l'article L.160-13 pour les forfaits mentionnés aux <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006073189&idArticle=LEGIARTI000034395825&dateTexte=&categorieLien=cid\" title=\"Code de la sécurité sociale. - art. R162-33-1 (V)\">2°, 4°, 5°, 6° et 7° de l'article R. 162-33-1 du code de la sécurité sociale</a> et pour les actes et consultations facturés en sus de ces forfaits est fixée à 20 % du tarif servant de base au calcul des prestations en nature de l'assurance maladie.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
