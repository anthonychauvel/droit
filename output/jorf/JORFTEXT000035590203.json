      },
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000035590211",
        "cid": "JORFARTI000035590211",
        "intOrdre": 2097148,
        "etat": "VIGUEUR",
        "num": "3",
        "path": "/JORFARTI000035590211",
        "pathTitle": [],
        "content": "<p><br/>La participation de l'assuré, à hauteur de 20 %, prévue au I de l'article L. 160-13, pour le forfait mentionné au <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006073189&idArticle=LEGIARTI000034395825&dateTexte=&categorieLien=cid\" title=\"Code de la sécurité sociale. - art. R162-33-1 (V)\">7° de l'article R. 162-33-1 du code de la sécurité sociale</a> et pour les actes et consultations facturés en sus de ces forfaits, est applicable à compter du 1er mars 2017.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
