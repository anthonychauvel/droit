{
  "titre": "Arrêté du 3 avril 2020 portant extension d'un avenant à la convention collective nationale du personnel des cabinets médicaux (n° 1147)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000041789952_01-01-2999",
