            "pathTitle": [
              "Titre III : ÉVALUATION DES ÉLÈVES ET SANCTION DES ÉTUDES"
            ],
            "content": "<p><br/>Le diplôme d'ingénieur de l'Institut supérieur d'aéronautique et de l'espace, spécialité Génie industriel, est délivré par le directeur général de l'institut.</p>",
            "nota": null,
            "comporteLiens": false,
            "comporteLiensSP": false,
            "modificatorTitle": null,
