{
  "titre": "Arrêté du 2 juillet 2018 portant extension d'un avenant à la convention collective nationale de la cordonnerie multiservice (n° 1561)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000037161014_01-01-2999",
