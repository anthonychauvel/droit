{
  "titre": "Arrêté du 20 mai 2026 portant extension d'un avenant à la convention collective nationale des entreprises du paysage",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000054125772_01-01-2999",
