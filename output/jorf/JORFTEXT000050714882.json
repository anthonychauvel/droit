        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000050714890",
        "pathTitle": [],
        "content": "<p><br/>L'<a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006071367&idArticle=LEGIARTI000018301625&dateTexte=&categorieLien=cid\" title=\"Code rural et de la pêche maritime - art. R718-19\">article R. 718-19 du code rural et de la pêche maritime </a>est ainsi modifié : <br/>1° Au premier alinéa, les mots : « au dernier alinéa » sont remplacés par les mots : « au 1° » ; <br/>2° Le troisième alinéa est remplacé par les dispositions suivantes : <br/>« Les dispositions des <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000018498592&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. R6332-38\">articles R. 6332-38</a>, <a href=\"/affichCode.do?cidTexte=LEGITEXT000006072050&idSectionTA=LEGISCTA000018498656&dateTexte=&categorieLien=cid\" title=\"Code du travail -  Paragraphe 1 : Constitution\">R. 6332-63 à R. 6332-71 </a>et <a href=\"/affichCode.do?cidTexte=LEGITEXT000006072050&idSectionTA=LEGISCTA000018498678&dateTexte=&categorieLien=cid\" title=\"Code du travail -  Paragraphe 3 : Contribution et gestion\">R. 6332-75 à R. 6332-77-1 du code du travail </a>sont applicables à ce fonds. »</p>",
        "nota": null,
