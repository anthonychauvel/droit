{
  "titre": "Arrêté du 17 février 2020 portant extension d'un avenant à la convention collective nationale unifiée « Ports et Manutention » (n° 3017)",
  "text": {
    "executionTime": 12,
    "dereferenced": false,
    "id": "JORFTEXT000041623924_01-01-2999",
