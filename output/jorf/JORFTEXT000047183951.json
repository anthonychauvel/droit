    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000047183954",
        "cid": "JORFARTI000047183954",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000047183954",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des entreprises du négoce et de l'industrie des produits du sol, engrais et produits connexes du 2 juillet 1980, les stipulations de l'avenant du 9 décembre 2021 à l'accord du 26 septembre 2019 relatif aux forfaits annuels en jours et les stipulations de l'avenant du 11 juillet 2022 audit avenant, conclus dans le cadre de la convention collective susvisée.</p><p><br/>- l'avenant du 9 décembre 2021 à l'accord du 26 septembre 2019 relatif aux forfaits annuels en jours, conclu dans le cadre de la convention collective susvisée ;<br/>- l'avenant du 11 juillet 2022 à l'avenant du 9 décembre 2021 à l'accord du 26 septembre 2019 relatif aux forfaits annuels en jours, conclu dans le cadre de la convention collective susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
