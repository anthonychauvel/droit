{
  "titre": "Arrêté du 9 août 2023 portant extension d'un accord conclu dans le cadre de la convention collective nationale des sociétés d'assurances (n° 1672)",
  "text": {
    "executionTime": 18,
    "dereferenced": false,
    "id": "JORFTEXT000047952631_01-01-2999",
