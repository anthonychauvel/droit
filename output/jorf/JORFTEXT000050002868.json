{
  "titre": "Arrêté du 11 juillet 2024 portant extension d'un avenant à la convention collective nationale du rouissage-teillage de lin (n° 1659)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000050002868_01-01-2999",
