        "path": "/JORFARTI000049225592",
        "pathTitle": [],
        "content": "<p><br/>Sont reconnues représentatives dans le secteur des entreprises du bâtiment occupant jusqu'à dix salariés :</p><p><br/>- la Confédération générale du travail (CGT) ;<br/>- la Confédération française démocratique du travail (CFDT) ;<br/>- la Confédération générale du travail - Force ouvrière (CGT-FO) ;<br/>- l'Union nationale des syndicats autonomes (UNSA) ;<br/>- la Confédération française de l'encadrement - Confédération générale des cadres (CFE-CGC).</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
        "type": "AUTONOME",
