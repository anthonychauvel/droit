{
  "titre": "Arrêté du 20 février 2018 portant extension d'un avenant à la convention collective nationale concernant les coopératives agricoles de teillage du lin",
  "text": {
    "executionTime": 10,
    "dereferenced": false,
    "id": "JORFTEXT000036684759_01-01-2999",
