{
  "titre": "Arrêté du 18 mars 2026 portant extension d'un avenant à un accord conclu dans le cadre de la convention collective nationale de l'import-export et du commerce international (n° 43)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000053749460_01-01-2999",
