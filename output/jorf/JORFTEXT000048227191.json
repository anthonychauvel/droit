{
  "titre": "Arrêté du 26 septembre 2023 portant extension d'un avenant à la convention collective nationale des entreprises artistiques et culturelles (n° 1285)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000048227191_01-01-2999",
