{
  "titre": "Arrêté du 17 octobre 2017 portant extension d'un avenant à la convention collective nationale de l'hôtellerie de plein air (n° 1631)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000035944549_01-01-2999",
