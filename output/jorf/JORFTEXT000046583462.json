{
  "titre": "Arrêté du 14 novembre 2022 portant extension d'un avenant à un accord conclu dans le cadre de la convention collective nationale du bricolage (n° 1606)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000046583462_01-01-2999",
