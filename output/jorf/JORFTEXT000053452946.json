{
  "titre": "Arrêté du 5 février 2026 portant extension d'un accord conclu dans le cadre de la convention collective nationale des cabinets d'experts-comptables et de commissaires aux comptes (n° 787)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000053452946_01-01-2999",
