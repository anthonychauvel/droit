{
  "titre": "Arrêté du 13 février 2019 portant extension d'un avenant à la convention collective nationale des ateliers et chantiers d'insertion (n° 3016)",
  "text": {
    "executionTime": 19,
    "dereferenced": false,
    "id": "JORFTEXT000038149937_01-01-2999",
