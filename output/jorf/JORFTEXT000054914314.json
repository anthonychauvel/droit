{
  "titre": "Arrêté du 23 septembre 2026 portant extension d'un avenant à la <mark>convention</mark> collective nationale des services de l'automobile (n° 1090)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000054914314_01-01-2999",
