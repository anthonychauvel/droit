{
  "titre": "Arrêté du 28 avril 2017 portant extension d'un avenant à la convention collective nationale des espaces de loisirs, d'attractions et culturels (n° 1790)",
  "text": {
    "executionTime": 19,
    "dereferenced": false,
    "id": "JORFTEXT000034519015_01-01-2999",
