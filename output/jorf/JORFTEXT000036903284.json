{
  "titre": "Arrêté du 9 mai 2018 portant extension d'un avenant à la convention collective nationale des cabinets et cliniques vétérinaires (n° 1875)",
  "text": {
    "executionTime": 10,
    "dereferenced": false,
    "id": "JORFTEXT000036903284_01-01-2999",
