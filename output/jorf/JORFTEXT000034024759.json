    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000034024763",
        "cid": "JORFARTI000034024763",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000034024763",
        "pathTitle": [],
        "content": "<p><br/>Le taux de la cotisation prévue à l'<a href=\"/affichTexteArticle.do?cidTexte=JORFTEXT000000330316&idArticle=LEGIARTI000006923557&dateTexte=&categorieLien=cid\" title=\"Décret n°56-220 du 29 février 1956 - art. 7 (M)\">article 7 du décret du 29 février 1956 susvisé</a>, due par chaque notaire pour l'année 2017, est fixé à 0,25 % de la moyenne de ses produits totaux réalisés au cours des années 2014 et 2015.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
        "type": "AUTONOME",
        "lstLienModification": [],
        "lstLienCitation": [],
        "conditionDiffere": null,
