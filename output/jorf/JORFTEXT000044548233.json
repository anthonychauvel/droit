    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000044548236",
        "cid": "JORFARTI000044548236",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000044548236",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale du personnel des agences générales d'assurances du 2 juin 2003, les stipulations de l'accord du 26 mai 2021 relatif à la formation professionnelle tout au long de la vie, conclu dans le cadre de la convention collective nationale susvisée.<br/>L'alinéa 2 de l'article 7.4 est étendu sous réserve du respect des <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000021340649&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L6315-1 (M)\">dispositions de l'article L. 6315-1 du code du travail</a>.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
        "modificatorTitle": null,
