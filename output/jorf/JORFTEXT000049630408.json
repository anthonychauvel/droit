    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000049630411",
        "cid": "JORFARTI000049630411",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000049630411",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de l'accord interbranche de mise en œuvre d'une politique de professionnalisation dans le secteur des particuliers employeurs et de l'emploi à domicile du 17 novembre 2020, les stipulations de l'avenant n° 1 du 18 décembre 2023 portant révision dudit accord susvisé.</p>",
