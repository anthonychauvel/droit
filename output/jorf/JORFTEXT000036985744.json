    "dateFinVersion": "2999-01-01",
    "signers": "<p align=\"left\"><br/>Fait le 23 avril 2018.</p><p align=\"left\"><br/>Pour la ministre et par délégation :<br/>Par empêchement du directeur général du travail :<br/>Le chef de service,<br/>R. Bac</p>",
