    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000053422682",
        "cid": "JORFARTI000053422682",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000053422682",
        "pathTitle": [],
        "content": "<p><br/>Le taux de la cotisation prévue à l'<a href=\"/affichTexteArticle.do?cidTexte=JORFTEXT000000330316&idArticle=LEGIARTI000006923557&dateTexte=&categorieLien=cid\" title=\"Décret n°56-220 du 29 février 1956 - art. 7\">article 7 du décret du 29 février 1956</a> susvisé, due par chaque titulaire d'office pour l'année 2026, est fixé à 0,20 % de la moyenne de ses produits totaux réalisés au cours des années 2023 et 2024.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
        "type": "AUTONOME",
        "lstLienModification": [],
        "lstLienCitation": [],
        "conditionDiffere": null,
        "historique": null,
        "surtitre": null,
        "renvoi": null,
        "versionLabel": null,
        "infosComplementaires": null,
        "infosComplementairesHtml": null,
        "infosRestructurationBranche": null,
        "infosRestructurationBrancheHtml": null,
        "dateDebut": 32472144000000,
        "dateFin": 32472144000000,
        "notaSectionsAafficher": null,
        "multipleVersions": true
      },
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000053422684",
        "cid": "JORFARTI000053422684",
        "intOrdre": 1048574,
        "etat": "VIGUEUR",
        "num": "2",
        "path": "/JORFARTI000053422684",
        "pathTitle": [],
        "content": "<p><br/>Il est appliqué aux titulaires d'office dont la moyenne des produits totaux des années 2023 et 2024 est inférieure à 200 000 € une décote dans les limites ci-après :</p><p><br/>- pour les titulaires d'office dont la moyenne des produits totaux est inférieure à 160 000 €, la décote est de 100 % ;<br/>- pour les titulaires d'office dont la moyenne des produits est inférieure à 180 000 €, la décote est de 50 % ;<br/>- pour les titulaires d'office dont la moyenne des produits est inférieure à 200 000 €, la décote est de 25 %.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
