            "content": "<p><div align=\"center\"><center><table border=\"1\"><tr><th><br/>IDCC</th><th><br/>Convention collective concernée</th><th><br/>Avenant de salaire concerné \n      <br/>\n    par l'extension</th><th><br/>N° du BOCC \n      <br/>\n    où l'avenant \n      <br/>\n    est publié</th><th><br/>Date de publication \n      <br/>\n    de l'avis au JORF</th></tr><tr><td align=\"center\"><br/>8231</td><td align=\"justify\"><br/>Convention du 13 décembre 1951 concernant les exploitations forestières de la Seine-Maritime et de l'Eure</td><td align=\"center\"><br/>Avenant n° 115 du 19 février 2021</td><td align=\"center\"><br/>2021/35</td><td align=\"center\"><br/>9 octobre 2021</td></tr><tr><td align=\"center\"><br/>8435</td><td align=\"justify\"><br/>Convention du 29 août 2001 concernant les Coopératives Fruitières des départements de l'Ain, du Doubs et du Jura</td><td align=\"center\"><br/>Avenant n° 38 du 22 mars 2021</td><td align=\"center\"><br/>2021/35</td><td align=\"center\"><br/>9 octobre 2021</td></tr><tr><td align=\"center\"><br/>8531</td><td align=\"justify\"><br/>Convention du 15 octobre 1985 concernant les exploitations forestières et scieries agricoles de la région Bretagne</td><td align=\"center\"><br/>Avenant n° 45 du 15 juin 2021</td><td align=\"center\"><br/>2021/35</td><td align=\"center\"><br/>9 octobre 2021</td></tr><tr><td align=\"center\"><br/>8531</td><td align=\"justify\"><br/>Convention du 15 octobre 1985 concernant les exploitations forestières et scieries agricoles de la région Bretagne</td><td align=\"center\"><br/>Avenant n° 46 du 15 juin 2021</td><td align=\"center\"><br/>2021/35</td><td align=\"center\"><br/>9 octobre 2021</td></tr><tr><td align=\"center\"><br/>8541</td><td align=\"justify\"><br/>Convention du 4 avril 1986 concernant les exploitations forestières et les scieries agricoles de la région Poitou-Charentes, à l'exclusion des cantons de Montendre, Montlieu La Garde et Montguyon (Charente-Maritime)</td><td align=\"center\"><br/>Avenant na 42 du 22 juin 2021</td><td align=\"center\"><br/>2021/35</td><td align=\"center\"><br/>9 octobre 2021</td></tr><tr><td align=\"center\"><br/>8822</td><td align=\"justify\"><br/>Convention du 27 juin 1988 concernant les scieries agricoles et les exploitations forestières de la région Rhône-Alpes, à l'exception du département de la Loire</td><td align=\"center\"><br/>Avenant n° 39 du 25 mars 2021</td><td align=\"center\"><br/>2021/35</td><td align=\"center\"><br/>9 octobre 2021</td></tr><tr><td align=\"center\"><br/>9831</td><td align=\"justify\"><br/>Convention du 6 juillet 1972 concernant les exploitations agricoles du département du Var</td><td align=\"center\"><br/>Avenant n° 123 du 12 mars 2021</td><td align=\"center\"><br/>2021/35</td><td align=\"center\"><br/>9 octobre 2021</td></tr></table></center></div></p>",
