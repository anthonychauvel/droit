{
  "titre": "Arrêté du 28 décembre 2018 portant extension d'un avenant à la convention collective nationale du tourisme social et familial (n° 1316)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000037881223_01-01-2999",
