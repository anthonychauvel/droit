{
  "titre": "Arrêté du 23 décembre 2019 portant extension d'un accord conclu dans le cadre de la convention collective nationale des hôtels, cafés, restaurants (n° 1979)",
  "text": {
    "executionTime": 21,
    "dereferenced": false,
    "id": "JORFTEXT000039804202_01-01-2999",
