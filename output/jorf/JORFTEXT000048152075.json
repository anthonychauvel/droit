    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000048152078",
        "cid": "JORFARTI000048152078",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000048152078",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des professions regroupées du cristal, du verre et du vitrail du 3 novembre 1994, les stipulations de l'accord du 20 novembre 2018 portant sur la concordance des coefficients, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
