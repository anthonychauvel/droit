        "intOrdre": 1048574,
        "etat": "VIGUEUR",
        "num": "2",
        "path": "/JORFARTI000054450768",
        "pathTitle": [],
        "content": "<p><br/>Dans le champ du périmètre mentionné à l'article 1<sup>er,</sup> pour la négociation d'un accord collectif en application de l'<a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000006901688&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L2232-6\">article L. 2232-6 du code du travail</a>, le poids des organisations syndicales représentatives est le suivant :</p><p><br/>- la Confédération générale du travail-Force ouvrière (CGT-FO) : 23,12 % ;<br/>- la Confédération française démocratique du travail (CFDT) : 20,20 % ;<br/>- l'Union nationale des syndicats autonomes (UNSA) : 18,72 % ;<br/>- la Confédération générale du travail (CGT) : 15,91 % ;<br/>- la Confédération française de l'encadrement-Confédération générale des cadres (CFE-CGC) : 12,69 % ;<br/>- le Syndicat national des pilotes de ligne - France - ALPA (SNPLF) : 9,36 %.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
