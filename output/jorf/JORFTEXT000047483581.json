    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000047483583",
        "cid": "JORFARTI000047483583",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000047483583",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale de l'optique-lunetterie de détail du 2 juin 1986, les stipulations de l'avenant du 24 novembre 2022 relatif au financement du paritarisme, aux heures de délégation et aux limites de remboursement des frais liés au paritarisme, à la convention collective nationale susvisée.</p>",
        "nota": null,
