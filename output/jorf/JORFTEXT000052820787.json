    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000052820790",
        "cid": "JORFARTI000052820790",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000052820790",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale du négoce et prestations de services dans les domaines médico-techniques du 9 avril 1997, les stipulations de l'accord du 19 juin 2025 modifiant les articles 10 et 11.5 de la convention collective nationale susvisée.<br/>L'article 10 de la convention collective, tel que modifié par l'article 1<sup>er</sup> de l'accord, est étendu sous réserve du respect, s'agissant des salariés en contrat à durée déterminée, des dispositions des <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000006901204&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L1242-10\">articles L. 1242-10</a> et <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000006901205&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L1242-11\">L. 1242-11 du code du travail</a>.</p>",
        "nota": null,
