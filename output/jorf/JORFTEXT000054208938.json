{
  "titre": "Arrêté du 20 mai 2026 portant extension d'un avenant à la convention collective nationale des cabinets ou entreprises d'expertises en automobile (n° 1951)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000054208938_01-01-2999",
