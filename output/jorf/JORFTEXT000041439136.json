{
  "titre": "Arrêté du 15 janvier 2020 portant extension d'un avenant à un accord conclu dans le cadre de la convention collective nationale de la couture parisienne (n° 303)",
  "text": {
    "executionTime": 21,
    "dereferenced": false,
    "id": "JORFTEXT000041439136_01-01-2999",
