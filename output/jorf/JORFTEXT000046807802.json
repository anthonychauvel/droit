    "textAbroge": false,
    "etat": null,
    "dossiersLegislatifs": [],
    "nature": "ARRETE",
    "resume": null,
    "rectificatif": null,
    "motsCles": [],
    "appellations": [],
    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000046807807",
        "cid": "JORFARTI000046807807",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000046807807",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des industries de carrières et matériaux ouvriers du 22 avril 1955 et dans celui de la convention collective nationale des employés, techniciens et agents de maîtrise des industries de carrières et de matériaux du 12 juillet 1955, tels que modifiés par l'accord du 11 juillet 2019 étendu, et dans leur propre champ d'application professionnel et territorial, les stipulations de l'accord régional (Sud Provence-Alpes-Côte d'Azur et Corse) du 22 septembre 2022 portant sur les salaires minimaux des ouvriers et ETAM, conclu dans le cadre des conventions collectives nationales susvisées.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
