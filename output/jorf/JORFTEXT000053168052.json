{
  "titre": "Arrêté du 16 décembre 2025 portant extension d'un avenant à la convention collective nationale du personnel des entreprises de restauration de collectivités (n° 1266)",
  "text": {
    "executionTime": 36,
    "dereferenced": false,
    "id": "JORFTEXT000053168052_01-01-2999",
