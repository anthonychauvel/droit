    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000053773632",
        "cid": "JORFARTI000053773632",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000053773632",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale pour les industries de produits alimentaires élaborés du 22 octobre 1985, les stipulations de l'accord n° 122 du 18 décembre 2025 relatif au régime de prévoyance conventionnelle, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
