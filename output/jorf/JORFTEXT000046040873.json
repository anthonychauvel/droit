{
  "titre": "Arrêté du 1er juillet 2022 portant extension d'un avenant à la convention collective nationale de l'enseignement privé indépendant (n° 2691)",
  "text": {
    "executionTime": 19,
    "dereferenced": false,
    "id": "JORFTEXT000046040873_01-01-2999",
