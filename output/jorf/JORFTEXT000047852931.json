        "infosRestructurationBranche": null,
        "infosRestructurationBrancheHtml": null,
        "dateDebut": 32472144000000,
        "dateFin": 32472144000000,
        "notaSectionsAafficher": null,
        "multipleVersions": false
      },
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000047852937",
        "cid": "JORFARTI000047852937",
        "intOrdre": 1048574,
        "etat": "VIGUEUR",
        "num": "2",
        "path": "/JORFARTI000047852937",
        "pathTitle": [],
        "content": "<p><br/>Les dispositions du troisième alinéa de l'article 5 relatif aux garanties applicables aux désactivations liées à l'expiration d'un document sont étendues, sous réserve de l'absence de déconnexion du travailleur indépendant, pour ce motif, tant que le document attestant de l'autorisation de travailler en France produit initialement auprès de la plateforme, n'est pas arrivé à expiration.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
        "modificatorTitle": null,
        "modificatorCid": null,
        "modificatorDate": null,
        "articleVersion": "INITIALE",
        "type": "AUTONOME",
        "lstLienModification": [],
        "lstLienCitation": [],
        "conditionDiffere": null,
        "historique": null,
        "surtitre": null,
        "renvoi": null,
        "versionLabel": null,
