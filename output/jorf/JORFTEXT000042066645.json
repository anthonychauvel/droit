            "pathTitle": [
              "Annexe"
            ],
            "content": "<p><br/>ANNEXE<br/>À L'ARRÊTÉ DU 22 JUIN 2020 PORTANT APPROBATION DES MODIFICATIONS APPORTÉES AUX STATUTS DE LA CAISSE INTERPROFESSIONNELLE DE PRÉVOYANCE ET D'ASSURANCE VIEILLESSE (CIPAV)</p><p><br/>Les statuts de la section professionnelle mentionnée au 11° de l'article R. 641-1 du code de la sécurité sociale sont ainsi modifiés :<br/>1° L'article 2.1 est remplacé par les dispositions suivantes :</p>",
            "nota": null,
            "comporteLiens": false,
            "comporteLiensSP": false,
            "modificatorTitle": null,
            "modificatorCid": null,
            "modificatorDate": null,
