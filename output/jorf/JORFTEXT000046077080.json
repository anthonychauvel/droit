    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000046077082",
        "cid": "JORFARTI000046077082",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000046077082",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des particuliers employeurs et de l'emploi à domicile, les stipulations de l'accord du 4 mai de 2022 relatif à la mise en œuvre du dispositif de prévention et santé au travail, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
