    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000044447792",
        "cid": "JORFARTI000044447792",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000044447792",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale du négoce et de l'ameublement du 31 mai 1995, les stipulations de l'accord du 24 juin 2021 relatif aux salaires minima, conclu dans le cadre de la convention collective nationale susvisée.<br/>L'accord est étendu sous réserve de l'application des dispositions règlementaires portant fixation du salaire minimum interprofessionnel de croissance.</p>",
        "nota": null,
