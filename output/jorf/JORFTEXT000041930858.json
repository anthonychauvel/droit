{
  "titre": "Arrêté du 20 mai 2020 portant extension d'avenants à la convention collective nationale des espaces de loisirs, d'attractions et culturels (n° 1790)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000041930858_01-01-2999",
