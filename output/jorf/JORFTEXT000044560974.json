    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000044560977",
        "cid": "JORFARTI000044560977",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000044560977",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans leur propre champ d'application, les stipulations de l'accord du 28 avril 2021 relatif à la formation professionnelle, conclu dans le secteur de la transformation laitière (coopératives laitières et industrie laitière).<br/>L'article 2 est étendu sous réserve de l'application des <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000018499146&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. R6422-3 (V)\">dispositions de l'article R. 6422-3 du code du travail</a>.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
        "modificatorTitle": null,
