{
  "titre": "Arrêté du 21 décembre 2018 portant extension d'un accord conclu dans le cadre de la convention collective nationale de l'industrie textile (n° 18)",
  "text": {
    "executionTime": 17,
    "dereferenced": false,
    "id": "JORFTEXT000037848941_01-01-2999",
