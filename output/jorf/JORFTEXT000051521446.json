    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000051521450",
        "cid": "JORFARTI000051521450",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000051521450",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des cinq branches des industries alimentaires du 21 mars 2012, les stipulations de l'avenant n° 28 du 10 janvier 2025 relatif aux salaires minima 2025, à la convention collective nationale susvisée.</p>",
