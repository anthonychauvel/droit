{
  "titre": "Arrêté du 9 avril 2025 portant extension d'un avenant à la convention collective nationale des cinq branches des industries alimentaires diverses (n° 3109)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000051521446_01-01-2999",
