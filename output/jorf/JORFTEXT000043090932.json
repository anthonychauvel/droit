{
  "titre": "Arrêté du 25 janvier 2021 portant extension d'un avenant à la convention collective nationale des entreprises de courtage d'assurances et/ou de réassurances (n° 2247)",
  "text": {
    "executionTime": 10,
    "dereferenced": false,
    "id": "JORFTEXT000043090932_01-01-2999",
