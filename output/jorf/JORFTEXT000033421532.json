    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000033421536",
        "cid": "JORFARTI000033421536",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000033421536",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale du personnel des prestataires de services dans le domaine du secteur tertiaire du 13 août 1999, les dispositions de l'avenant n° 1 du 19 avril 2016 à l'accord du 23 novembre 2011 relatif au CQP chargé d'accueil, conclu dans le cadre de la convention collective nationale susvisée.<br/>Le 2e alinéa de l'article 5 est étendu sous réserve de l'application des <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000006901785&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L2261-7 (V)\">dispositions de l'article L. 2261-7 du code du travail</a> issu de la <a href=\"/affichTexte.do?cidTexte=JORFTEXT000032983213&categorieLien=cid\" title=\"LOI n°2016-1088 du 8 août 2016 (V)\">loi n° 2016-1088 du 8 août 2016</a> relative au travail, à la modernisation du dialogue social et à la sécurisation des parcours professionnels et de l'application combinée des dispositions des articles <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000006901669&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L2231-1 (M)\">L. 2231-1</a> et <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000006901785&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L2261-7 (V)\">L. 2261-7</a> du code du travail, telles qu'interprétées par la jurisprudence de la Cour de cassation.</p>",
        "nota": null,
