    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000051673180",
        "cid": "JORFARTI000051673180",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000051673180",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des industries chimiques du 30 décembre 1952, les stipulations de l'accord de méthode du 12 février 2025 sur la mise en œuvre de groupes de travail paritaires classification, conclu dans le cadre de la convention collective nationale susvisée.</p>",
