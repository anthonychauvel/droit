    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000039202662",
        "cid": "JORFARTI000039202662",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000039202662",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des employés, techniciens et agents de maîtrise (ETAM) des travaux publics du 12 juillet 2006, et dans son propre champ d'application territorial, les dispositions l'accord territorial (Bourgogne) du 18 janvier 2018 relatif au barème des minima, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
