    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000050076966",
        "cid": "JORFARTI000050076966",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000050076966",
        "pathTitle": [],
        "content": "<p><br/>Les dispositions de l'accord du 25 septembre 2023 relatif au devenir des accords nationaux signés dans les deux branches historiques du conseil et service en élevage et à l'applicabilité des accords conclus au niveau interbranches sont rendues obligatoires pour tous les employeurs et tous les salariés compris dans le champ d'application professionnel et territorial dudit accord, à l'exclusion de son article 7 en ce qu'il est contraire aux dispositions de l'<a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000006901787&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L2261-9\">article L. 2261-9 du code du travail</a>.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
