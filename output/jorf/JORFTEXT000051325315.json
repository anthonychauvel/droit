{
  "titre": "Arrêté du 5 mars 2025 portant extension d'un avenant à un accord conclu dans le cadre de la convention collective nationale de la plasturgie (n° 292)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000051325315_01-01-2999",
