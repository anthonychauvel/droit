    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000051325318",
        "cid": "JORFARTI000051325318",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000051325318",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale de la plasturgie du 1er juillet 1960, les stipulations de l'avenant n° 1 du 19 décembre 2024 à l'accord du 29 octobre 2014 instaurant un régime de prévoyance, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
