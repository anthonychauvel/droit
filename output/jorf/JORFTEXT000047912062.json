{
  "titre": "Arrêté du 26 juillet 2023 portant extension d'avenants salariaux à des conventions collectives de <mark>travail</mark> étendues relatives aux professions agricoles",
  "text": {
    "executionTime": 6,
    "dereferenced": false,
    "id": "JORFTEXT000047912062_01-01-2999",
