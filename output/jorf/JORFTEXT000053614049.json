{
  "titre": "Arrêté du 24 février 2026 portant extension de l'accord national interprofessionnel du 14 novembre 2024 relatif à l'évolution du dialogue social (n° 20365)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000053614049_01-01-2999",
