{
  "titre": "Arrêté du 19 octobre 2021 portant extension d'un avenant à la convention collective nationale du sport (n° 2511)",
  "text": {
    "executionTime": 29,
    "dereferenced": false,
    "id": "JORFTEXT000044311040_01-01-2999",
