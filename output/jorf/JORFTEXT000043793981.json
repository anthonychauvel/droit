{
  "titre": "Arrêté du 2 juillet 2021 portant extension d'un avenant à la convention collective nationale de la coiffure et des professions connexes (n° 2596)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000043793981_01-01-2999",
