{
  "titre": "Arrêté du 20 mai 2026 portant extension d'un accord conclu dans le cadre de la convention collective nationale de la métallurgie (n° 3248)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000054209051_01-01-2999",
