    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000045864108",
        "cid": "JORFARTI000045864108",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000045864108",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale de la restauration rapide du 24 novembre 1988, les stipulations de l'avenant n° 61 du 6 janvier 2022 relatif à la prime annuelle conventionnelle, à la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": true,
