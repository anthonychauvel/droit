    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000050823639",
        "cid": "JORFARTI000050823639",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000050823639",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application professionnel de la convention collective nationale de la coiffure et des professions connexes du 10 juillet 2006, les stipulations de l'avenant n° 49 du 14 mars 2024 relatif au CQP « manager un salon de coiffure » à la convention collective nationale susvisée.</p>",
        "nota": null,
