{
  "titre": "Arrêté du 13 décembre 2024 portant extension d'un avenant à la convention collective nationale de la coiffure et des professions connexes (n° 2596)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000050823636_01-01-2999",
