{
  "titre": "Arrêté du 6 février 2026 portant extension d'un avenant à la convention collective nationale du négoce de l'ameublement (n° 1880)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000053459607_01-01-2999",
