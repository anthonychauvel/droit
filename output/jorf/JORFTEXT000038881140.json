{
  "titre": "Arrêté du 24 juillet 2019 portant extension d'un avenant à la convention collective nationale de l'enseignement privé hors contrat (n° 2691)",
  "text": {
    "executionTime": 26,
    "dereferenced": false,
    "id": "JORFTEXT000038881140_01-01-2999",
