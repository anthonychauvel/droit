{
  "titre": "Arrêté du 22 août 2017 portant extension d'un avenant à la convention collective nationale de l'immobilier (n° 1527)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000035463485_01-01-2999",
