{
  "titre": "Arrêté du 20 avril 2018 portant extension d'un accord conclu dans le cadre de la convention collective nationale de l'industrie pharmaceutique (n° 176)",
  "text": {
    "executionTime": 7,
    "dereferenced": false,
    "id": "JORFTEXT000036840475_01-01-2999",
