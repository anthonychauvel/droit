    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000044327797",
        "cid": "JORFARTI000044327797",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000044327797",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des entreprises d'installation sans fabrication, y compris entretien, réparation, dépannage de matériel aéraulique, thermique, frigorifique et connexes, les stipulations de l'avenant n° 2 du 15 avril 2021 à l'accord du 21 septembre 2016 relatif à la formation professionnelle, conclu dans le cadre de la convention collective nationale susvisée.<br/>Le 8e alinéa de l'article 2 est étendu sous réserve du respect des <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000006072050&idArticle=LEGIARTI000021343095&dateTexte=&categorieLien=cid\" title=\"Code du travail - art. L6332-1-2 (VD)\">dispositions de l'article L. 6332-1-2 du code du travail</a>.</p>",
        "nota": null,
        "comporteLiens": true,
        "comporteLiensSP": false,
