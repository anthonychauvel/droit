{
  "titre": "Arrêté du 18 décembre 2020 portant extension d'un avenant à la convention collective nationale des salariés du particulier employeur (n° 2111)",
  "text": {
    "executionTime": 1,
    "dereferenced": false,
    "id": "JORFTEXT000042731769_01-01-2999",
