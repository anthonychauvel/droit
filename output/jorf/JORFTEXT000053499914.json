    "appellations": [],
    "liens": [],
    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000053499918",
        "cid": "JORFARTI000053499918",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000053499918",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des remontées mécaniques et domaines skiables du 15 mai 1968, les stipulations de l'avenant n° 88 du 26 novembre 2025 relatif aux rémunérations minimales hiérarchiques à compter du 1<sup>er</sup> décembre 2025, à la convention collective susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
        "comporteLiensSP": false,
