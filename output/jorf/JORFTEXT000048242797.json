{
  "titre": "Arrêté du 26 septembre 2023 portant extension d'un avenant à la convention collective nationale des mareyeurs-expéditeurs (n° 1589)",
  "text": {
    "executionTime": 2,
    "dereferenced": false,
    "id": "JORFTEXT000048242797_01-01-2999",
