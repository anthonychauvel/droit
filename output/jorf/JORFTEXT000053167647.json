    "observations": null,
    "sections": [],
    "articles": [
      {
        "executionTime": 0,
        "dereferenced": false,
        "id": "JORFARTI000053167650",
        "cid": "JORFARTI000053167650",
        "intOrdre": 524287,
        "etat": "VIGUEUR",
        "num": "1",
        "path": "/JORFARTI000053167650",
        "pathTitle": [],
        "content": "<p><br/>Sont rendues obligatoires, pour tous les employeurs et tous les salariés compris dans le champ d'application de la convention collective nationale des professions de la photographie du 13 février 2013, les stipulations de l'avenant du n° 8 du 12 novembre 2024 à l'accord du 5 décembre 2002 relatif aux salariés cadres et non-cadres, conclu dans le cadre de la convention collective nationale susvisée.</p>",
        "nota": null,
        "comporteLiens": false,
