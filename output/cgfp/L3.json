  "article": {
    "id": "LEGIARTI000044428003",
    "idTexte": null,
    "type": "AUTONOME",
    "texte": "Les fonctionnaires civils de l'Etat sont les personnes qui ont été nommées dans un emploi permanent à temps complet et ont été titularisées dans un grade de la hiérarchie administrative des administrations de l'Etat ou des établissements publics de l'Etat autres que ceux mentionnés à l'article L. 5 .",
    "texteHtml": "<p><br/>Les fonctionnaires civils de l'Etat sont les personnes qui ont été nommées dans un emploi permanent à temps complet et ont été titularisées dans un grade de la hiérarchie administrative des administrations de l'Etat ou des établissements publics de l'Etat autres que ceux mentionnés à l'article <a href=\"/affichCodeArticle.do?cidTexte=LEGITEXT000044416551&idArticle=LEGIARTI000044420589&dateTexte=&categorieLien=cid\" title=\"Code général de la fonction publique - art. L5 (V)\">L. 5</a>.</p>",
